    "emphasis": { "max_zoom": 1.3, "allow": true },
    "reaction": { "max_zoom": 1.2, "allow": true },
    "evidence": { "max_zoom": 1.12, "allow": true },
    "reset": { "max_zoom": 1, "allow": true }
  },
  "frames": { "required_roles": ["first", "representative", "last"], "representative_count": 1 },
  "source": { "require_identity": true, "require_av_geometry": true },
  "degrade": { "missing_evidence": "human_hold", "failed_check": "safe_degrade", "safe_mode": "identity" }
