{
  "source": "D4887.MP4",
  "language": "ja",
  "language_probability": 1,
  "duration_sec": 331.335,
  "segments": [
    {
      "id": "SEG_0001",
      "start": 0.88,
      "end": 8.88,
      "text": "逆に期待していなかった方がいいんですけど。",
      "avg_logprob": -0.35548278860662175,
      "no_speech_prob": 0.4864133596420288
    },
    {
      "id": "SEG_0002",
      "start": 8.88,
      "end": 14.88,
      "text": "期待と言いますが、僕はあまりセミナーって出ないんですけど、",
      "avg_logprob": -0.35548278860662175,
      "no_speech_prob": 0.4864133596420288
    },
    {
      "id": "SEG_0003",
      "start": 14.88,
      "end": 19.88,
      "text": "正直AIについては危機感をずっと持っていまして、",
      "avg_logprob": -0.35548278860662175,
      "no_speech_prob": 0.4864133596420288
    },
    {
      "id": "SEG_0004",
      "start": 19.88,
      "end": 24.88,
      "text": "何かを変えなきゃいけないという日頃を持っていたんですけど、",
      "avg_logprob": -0.35548278860662175,
      "no_speech_prob": 0.4864133596420288
    },
    {
      "id": "SEG_0005",
      "start": 24.88,
      "end": 30.88,
      "text": "タイミングで、山本さんから声を聞いただいて、 影響を参加させていただいたという感じですね。",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0006",
      "start": 30.88,
      "end": 33.88,
      "text": "A.Iに機関を持っている方とかにも多いと思うんですけど、",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0007",
      "start": 33.88,
      "end": 36.88,
      "text": "とはいえ、いろいろのセミナーってあるじゃないですか。",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0008",
      "start": 36.88,
      "end": 38.88,
      "text": "A.Iの工具が。",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0009",
      "start": 38.88,
      "end": 41.88,
      "text": "その中で、今回のAX1で、",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0010",
      "start": 41.88,
      "end": 44.88,
      "text": "引っ掛かった部分が気になった部分だったんですか?",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0011",
      "start": 44.88,
      "end": 46.88,
      "text": "気になった部分。",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0012",
      "start": 47.88,
      "end": 49.88,
      "text": "この進化の速さと、",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0013",
      "start": 49.88,
      "end": 51.88,
      "text": "気になった点。",
      "avg_logprob": -0.3406147364912362,
      "no_speech_prob": 0.45198923349380493
    },
    {
      "id": "SEG_0014",
      "start": 51.88,
      "end": 56.48,
      "text": "うん、うん、うん、うん、研修しようかと思います。",
      "avg_logprob": -0.3997334159246766,
      "no_speech_prob": 0.5361429452896118
    },
    {
      "id": "SEG_0015",
      "start": 56.48,
      "end": 57.98,
      "text": "気になった点ですか?",
      "avg_logprob": -0.3997334159246766,
      "no_speech_prob": 0.5361429452896118
    },
    {
      "id": "SEG_0016",
      "start": 57.98,
      "end": 63.08,
      "text": "なんか、こう、ちょっとこの辺が他と違うぞとか、何か面白そうだなとか。",
      "avg_logprob": -0.3997334159246766,
      "no_speech_prob": 0.5361429452896118
    },
    {
      "id": "SEG_0017",
      "start": 63.08,
      "end": 70.08,
      "text": "とにかく、実践的で、触りながら回れるってところで、",
      "avg_logprob": -0.3997334159246766,
      "no_speech_prob": 0.5361429452896118
    },
    {
      "id": "SEG_0018",
      "start": 70.08,
      "end": 75.58,
      "text": "こんなAI原始人の僕でも、少しちょっと自信にもなりましたし、",
      "avg_logprob": -0.3997334159246766,
      "no_speech_prob": 0.5361429452896118
    },
    {
      "id": "SEG_0019",
      "start": 75.58,
      "end": 81.92,
      "text": "明日から一つずつ、ちょっと業務に加えていこうかなとは思っています。",
      "avg_logprob": -0.396430693341024,
      "no_speech_prob": 0.18669988214969635
    },
    {
      "id": "SEG_0020",
      "start": 81.92,
      "end": 85.72,
      "text": "なんか、印象的だったセッションとかありますか?",
      "avg_logprob": -0.396430693341024,
      "no_speech_prob": 0.18669988214969635
    },
    {
      "id": "SEG_0021",
      "start": 85.72,
      "end": 95.42,
      "text": "えーと、自分でアプリを作った、作れちゃうんだと。",
      "avg_logprob": -0.396430693341024,
      "no_speech_prob": 0.18669988214969635
    },
    {
      "id": "SEG_0022",
      "start": 95.42,
      "end": 105.42,
      "text": "今の僕なりのものはできちゃうんだっていうところで感動しました。",
      "avg_logprob": -0.39183190844275734,
      "no_speech_prob": 0.12946179509162903
    },
    {
      "id": "SEG_0023",
      "start": 105.42,
      "end": 117.42,
      "text": "やる前やった後でアプリというか作れちゃったって自分の中での変化を感じますか?",
      "avg_logprob": -0.39183190844275734,
      "no_speech_prob": 0.12946179509162903
    },
    {
      "id": "SEG_0024",
      "start": 117.42,
      "end": 137.42,
      "text": "とにかく経験の壁みたいなところに関しては、たぶん僕一番底だったんですけど、何でも触ってみようと恐れずに触ってみようという気持ちにはなっています。",
      "avg_logprob": -0.21698152706507715,
      "no_speech_prob": 0.7264045476913452
    },
    {
      "id": "SEG_0025",
      "start": 137.42,
      "end": 148.42,
      "text": "何かご自身の経営者として会社でやっていく上で、こんなことに行きそうだなとか、こんなふうにできるんじゃないかなって思った部分。",
      "avg_logprob": -0.2277541671727979,
      "no_speech_prob": 0.5394424796104431
    },
    {
      "id": "SEG_0026",
      "start": 148.42,
      "end": 158.42,
      "text": "個人的な仕事に関しては、ずっと気にはなっていたんですけど、経営分析からお金の部分ですね。",
      "avg_logprob": -0.2277541671727979,
      "no_speech_prob": 0.5394424796104431
    },
    {
      "id": "SEG_0027",
      "start": 158.42,
      "end": 168.42,
      "text": "あとうちの業務的なことで言うと、ほぼほぼ部屋屋で取って変われるような仕事ばかりで、あれもちょっと怖い部分であるんですけど、",
      "avg_logprob": -0.2515798214138771,
      "no_speech_prob": 0.4533964991569519
    },
    {
      "id": "SEG_0028",
      "start": 168.42,
      "end": 180.37,
      "text": "もう早速明日からカンバーを集めて、どこで何を組み込むかという話をして浸透させていきたいと思っています。",
      "avg_logprob": -0.2515798214138771,
      "no_speech_prob": 0.4533964991569519
    },
    {
      "id": "SEG_0029",
      "start": 180.37,
      "end": 184.37,
      "text": "ちなみに、もし受けなかったとしたら、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0030",
      "start": 184.37,
      "end": 187.37,
      "text": "受けたら明日勘弁を集めて話そうというのと、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0031",
      "start": 187.37,
      "end": 190.37,
      "text": "どんな違いがあったと思いますか?",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0032",
      "start": 191.37,
      "end": 194.37,
      "text": "本当に爆然としていたので、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0033",
      "start": 194.37,
      "end": 199.37,
      "text": "何をどう使って、何をどうすべきかというのが、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0034",
      "start": 199.37,
      "end": 203.37,
      "text": "本当に爆然としていたというところから言うと、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0035",
      "start": 203.37,
      "end": 209.37,
      "text": "わりと自分の中では少し具体的になった部分もあるので、",
      "avg_logprob": -0.27312612433393463,
      "no_speech_prob": 0.2652713358402252
    },
    {
      "id": "SEG_0036",
      "start": 209.37,
      "end": 224.37,
      "text": "その伝えるものもAIで作ろうかなと思っているんですけど、今までのアナログから脱却してすべての業務に活用していきたいと思っています。",
      "avg_logprob": -0.3524853163957596,
      "no_speech_prob": 0.40653547644615173
    },
    {
      "id": "SEG_0037",
      "start": 224.37,
      "end": 236.13,
      "text": "とにかく、この年で感動とか興奮とかって日々薄れていくものなんですけど、今日は本当に感動をしましたし、",
      "avg_logprob": -0.3891412463453081,
      "no_speech_prob": 0.2147545963525772
    },
    {
      "id": "SEG_0038",
      "start": 236.13,
      "end": 241.89,
      "text": "そんな一日になりました。本当に感謝します。ありがとうございます。",
      "avg_logprob": -0.3891412463453081,
      "no_speech_prob": 0.2147545963525772
    },
    {
      "id": "SEG_0039",
      "start": 241.89,
      "end": 250.93,
      "text": "ありがとうございます。簡単としすぎてて、感動をして、言葉で言うと、どんな感動があったんですか?",
      "avg_logprob": -0.3891412463453081,
      "no_speech_prob": 0.2147545963525772
    },
    {
      "id": "SEG_0040",
      "start": 250.93,
      "end": 272.93,
      "text": "みんなにおいてもらいたい、知ってるか知らないかで大きく変わる世界だと思っているので、一人でも多くの方に触れてもらいたい、知ってもらいたいなと、僕が言う話じゃないと思うんですけど、そう思いました。",
      "avg_logprob": -0.3560877203941345,
      "no_speech_prob": 0.6892119646072388
    },
    {
      "id": "SEG_0041",
      "start": 272.93,
      "end": 276.93,
      "text": "最後に一つつも最後な問いなんですけど",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0042",
      "start": 276.93,
      "end": 281.93,
      "text": "今日ってAIの使い方だけではない話も多かったと思うんですが",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0043",
      "start": 281.93,
      "end": 285.93,
      "text": "その辺りって山田さんとしてはどうでしたか",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0044",
      "start": 285.93,
      "end": 288.93,
      "text": "いらなかったなあなのか",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0045",
      "start": 288.93,
      "end": 292.93,
      "text": "考え直すきっかけになったのかとか",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0046",
      "start": 292.93,
      "end": 295.93,
      "text": "もう本当に交渉で",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0047",
      "start": 295.93,
      "end": 300.93,
      "text": "根本的にAIがない世界というのは",
      "avg_logprob": -0.3133323036058985,
      "no_speech_prob": 0.263539582490921
    },
    {
      "id": "SEG_0048",
      "start": 300.93,
      "end": 320.93,
      "text": "おそらく考えにくいので、もうAIがある前提で経営なり、会社の提供する価値だったり、というのは、改めて考えなきゃなと思わされた時間でした。",
      "avg_logprob": -0.35362219512462617,
      "no_speech_prob": 0.1834079772233963
    },
    {
      "id": "SEG_0049",
      "start": 320.93,
      "end": 322.93,
      "text": "ありがとうございます。",
      "avg_logprob": -0.35362219512462617,
      "no_speech_prob": 0.1834079772233963
    },
    {
      "id": "SEG_0050",
      "start": 322.93,
      "end": 324.93,
      "text": "ありがとうございます。",
      "avg_logprob": -0.35362219512462617,
      "no_speech_prob": 0.1834079772233963
    },
    {
      "id": "SEG_0051",
      "start": 324.93,
      "end": 326.93,
      "text": "このままです",
      "avg_logprob": -0.5534298133850097,
      "no_speech_prob": 0.16965076327323914
    },
    {
      "id": "SEG_0052",
      "start": 326.93,
      "end": 328.93,
      "text": "並び替えたらめちゃくちゃ良い流れに",
      "avg_logprob": -0.5534298133850097,
      "no_speech_prob": 0.16965076327323914
    }
  ]
}