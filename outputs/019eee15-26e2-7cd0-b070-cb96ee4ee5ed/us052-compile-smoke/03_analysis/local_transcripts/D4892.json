  "segments": [
    {
      "id": "SEG_0001",
      "start": 0.02,
      "end": 2.02,
      "text": "行って終わりたらなというふうに思います",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0002",
      "start": 2.02,
      "end": 4.02,
      "text": "だからこうしじんはいいんでちゃんけいから",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0003",
      "start": 4.02,
      "end": 5.02,
      "text": "やっておきますから",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0004",
      "start": 5.02,
      "end": 8.02,
      "text": "はい じゃあありがとうございました",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0005",
      "start": 8.02,
      "end": 11.02,
      "text": "私自身AIっていうのを",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0006",
      "start": 11.02,
      "end": 14.02,
      "text": "ほんとにウイルフォアドと関わりになってから",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0007",
      "start": 14.02,
      "end": 17.02,
      "text": "なんでほんと年始くらいから",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0008",
      "start": 17.02,
      "end": 21.02,
      "text": "やっと使い始めたみたいな状況で",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0009",
      "start": 21.02,
      "end": 25.02,
      "text": "なんかそれこそ環境って最後あったんですけど",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0010",
      "start": 25.02,
      "end": 29.02,
      "text": "今まではAI使う環境じゃなかったのが",
      "avg_logprob": -0.340721769440443,
      "no_speech_prob": 0.4575781524181366
    },
    {
      "id": "SEG_0011",
      "start": 29.02,
      "end": 36.02,
      "text": "皆さんが使うのが当たり前っていう環境に入らせていただいたことで",
      "avg_logprob": -0.22105243143647216,
      "no_speech_prob": 0.14328446984291077
    },
    {
      "id": "SEG_0012",
      "start": 36.02,
      "end": 43.02,
      "text": "先日初めてLPってランディングページを自分で作れたりとか",
      "avg_logprob": -0.22105243143647216,
      "no_speech_prob": 0.14328446984291077
    },
    {
      "id": "SEG_0013",
      "start": 43.02,
      "end": 51.02,
      "text": "今日も自分の自己紹介とかなんでこうやって出してたのにまとめてなかったんだろうって気づけたりとか",
      "avg_logprob": -0.22105243143647216,
      "no_speech_prob": 0.14328446984291077
    },
    {
      "id": "SEG_0014",
      "start": 51.02,
      "end": 80.02,
      "text": "そういった、本当に自分のウィルとかをもっと出していけるチャンスとかを自分自身が知れたし、実践できたというのが3つの壁の中の経験というところが本当に今日はできてすごく良かったなという感覚がありましたし、素敵な2人との出会いができたのもすごくありがたい1日だと思っております。",
      "avg_logprob": -0.22304548856315262,
      "no_speech_prob": 0.0264300424605608
    },
    {
      "id": "SEG_0015",
      "start": 80.02,
      "end": 91.83,
      "text": "本日は研修が終わりました。",
      "avg_logprob": -0.3826469077128116,
      "no_speech_prob": 0.6853525042533875
    },
    {
      "id": "SEG_0016",
      "start": 91.83,
      "end": 97.83,
      "text": "初めましての皆さん、こういった声にすごく感謝するとともに、",
      "avg_logprob": -0.3826469077128116,
      "no_speech_prob": 0.6853525042533875
    },
    {
      "id": "SEG_0017",
      "start": 97.83,
      "end": 102.83,
      "text": "自分自身もAIって、本当に日清結構でどんどん出てくるし、",
      "avg_logprob": -0.3826469077128116,
      "no_speech_prob": 0.6853525042533875
    },
    {
      "id": "SEG_0018",
      "start": 102.83,
      "end": 106.83,
      "text": "オープンAIが来たかと思ったら、Googleのジェミニーガーとか、",
      "avg_logprob": -0.3826469077128116,
      "no_speech_prob": 0.6853525042533875
    },
    {
      "id": "SEG_0019",
      "start": 106.83,
      "end": 109.83,
      "text": "今日も初めて来てクラウドとか、",
      "avg_logprob": -0.3826469077128116,
      "no_speech_prob": 0.6853525042533875
    },
    {
      "id": "SEG_0020",
      "start": 109.83,
      "end": 112.83,
      "text": "いろいろちょっと聞きすぎていろいろ忘れちゃったんですけど",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0021",
      "start": 112.83,
      "end": 115.83,
      "text": "ほんとたくさんのものが出てくる中ね",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0022",
      "start": 115.83,
      "end": 119.83,
      "text": "それをなんかきちんとキャッチアップして情報として撮って",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0023",
      "start": 120.83,
      "end": 124.83,
      "text": "活用していきたいなって気持ちはすごく思いました",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0024",
      "start": 125.83,
      "end": 128.83,
      "text": "もっとシラスユデゲームから始まり",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0025",
      "start": 129.83,
      "end": 132.83,
      "text": "自走のツールまで作るまでっていうところでも",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0026",
      "start": 132.83,
      "end": 135.83,
      "text": "ほんとにこんなことまでできるんだっていう",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0027",
      "start": 135.83,
      "end": 138.83,
      "text": "ほんとにびっくりしてます",
      "avg_logprob": -0.239709783746646,
      "no_speech_prob": 0.26512280106544495
    },
    {
      "id": "SEG_0028",
      "start": 138.83,
      "end": 149.83,
      "text": "これを知識だけで終わらせずに、ちゃんと活用していくというところを野武さんと一緒にやって、松井さんを発展させていただきたいと思います。",
      "avg_logprob": -0.4040546248208231,
      "no_speech_prob": 0.5257622599601746
    },
    {
      "id": "SEG_0029",
      "start": 149.83,
      "end": 154.52,
      "text": "ありがとうございました。",
      "avg_logprob": -0.4040546248208231,
      "no_speech_prob": 0.5257622599601746
    },
    {
      "id": "SEG_0030",
      "start": 154.52,
      "end": 156.52,
      "text": "ありがとうございます。",
      "avg_logprob": -0.4040546248208231,
      "no_speech_prob": 0.5257622599601746
    },
    {
      "id": "SEG_0031",
      "start": 156.52,
      "end": 157.52,
      "text": "ちょっと待ってください。",
      "avg_logprob": -0.4040546248208231,
      "no_speech_prob": 0.5257622599601746
    },
    {
      "id": "SEG_0032",
      "start": 157.52,
      "end": 165.09,
      "text": "ありがとうございます。",
      "avg_logprob": -0.4040546248208231,
      "no_speech_prob": 0.5257622599601746
    },
    {
      "id": "SEG_0033",
      "start": 165.09,
      "end": 170.09,
      "text": "ナルセのほとんどお誘いありがとうございました。",
      "avg_logprob": -0.3523787693543868,
      "no_speech_prob": 0.2437640279531479
    },
    {
      "id": "SEG_0034",
      "start": 170.09,
      "end": 179.09,
      "text": "兄弟のような、先生のようなずっと振り返れば、ナルセたくやここにあるみたいなんですね。",
      "avg_logprob": -0.3523787693543868,
      "no_speech_prob": 0.2437640279531479
    },
    {
      "id": "SEG_0035",
      "start": 179.09,
      "end": 183.09,
      "text": "そんな関係が本当に嬉しく思いますし、",
      "avg_logprob": -0.3523787693543868,
      "no_speech_prob": 0.2437640279531479
    },
    {
      "id": "SEG_0036",
      "start": 183.09,
      "end": 191.09,
      "text": "このAIとかって、僕の今までの感覚だと、",
      "avg_logprob": -0.3523787693543868,
      "no_speech_prob": 0.2437640279531479
    },
    {
      "id": "SEG_0037",
      "start": 191.09,
      "end": 198.09,
      "text": "僕らの尊敬するアクシャ長も今、こうやって一生懸命調べてるし、まあまあ必要なんだろうなと。",
      "avg_logprob": -0.26180427980749577,
      "no_speech_prob": 0.6459589004516602
    },
    {
      "id": "SEG_0038",
      "start": 198.09,
      "end": 201.09,
      "text": "すごくいろいろ情報くれだろうなと。",
      "avg_logprob": -0.26180427980749577,
      "no_speech_prob": 0.6459589004516602
    },
    {
      "id": "SEG_0039",
      "start": 201.09,
      "end": 207.09,
      "text": "一時期僕が売らないみたいなのに怒ったこともあって、すごく霊能者みたいな。",
      "avg_logprob": -0.26180427980749577,
      "no_speech_prob": 0.6459589004516602
    },
    {
      "id": "SEG_0040",
      "start": 207.09,
      "end": 213.09,
      "text": "自分の進んでいく道とか、サポートをいただいたりとか。",
      "avg_logprob": -0.26180427980749577,
      "no_speech_prob": 0.6459589004516602
    },
    {
      "id": "SEG_0041",
      "start": 213.09,
      "end": 220.09,
      "text": "最近ではすごくそれにチャッピー君に頼ってる自分もいたりとか、でも面白いなと思いながら、",
      "avg_logprob": -0.26180427980749577,
      "no_speech_prob": 0.6459589004516602
    },
    {
      "id": "SEG_0042",
      "start": 220.09,
      "end": 232.69,
      "text": "いながら、今日、いろんなスキルを学ばせていただいた、そして、それをどのように活用するかというのを、まだまだ深盛りしていかなきゃならないかなというところはある。",
      "avg_logprob": -0.32081205749286795,
      "no_speech_prob": 0.3854517936706543
    },
    {
      "id": "SEG_0043",
      "start": 232.69,
      "end": 247.69,
      "text": "ただ、最後、ナルセさんのメッセージで、その落とし穴のところ、これすごく、僕らがわからないが故に頼りすぎることなく、",
      "avg_logprob": -0.32081205749286795,
      "no_speech_prob": 0.3854517936706543
    },
    {
      "id": "SEG_0044",
      "start": 247.69,
      "end": 255.69,
      "text": "今の僕の生きてきた人生のこの経験と、そしてこれから見えるビジョンと、そしてまあ関わる人とで、",
      "avg_logprob": -0.2240800010661284,
      "no_speech_prob": 0.11043796688318253
    },
    {
      "id": "SEG_0045",
      "start": 255.69,
      "end": 265.69,
      "text": "かつ、今の最新のテクノロジーとかAIとか、やって本当にすごい情報パッと集めてくれるような、こういったスキルを活用してですね、",
      "avg_logprob": -0.2240800010661284,
      "no_speech_prob": 0.11043796688318253
    },
    {
      "id": "SEG_0046",
      "start": 265.69,
      "end": 272.69,
      "text": "自分が何ができるかなっていうのを見直す機会かなっていうのはすごく思ったところであります。",
      "avg_logprob": -0.2240800010661284,
      "no_speech_prob": 0.11043796688318253
    },
    {
      "id": "SEG_0047",
      "start": 272.69,
      "end": 275.45,
      "text": "ぶっちゃけ、すごくわかっているの。",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0048",
      "start": 275.45,
      "end": 281.15,
      "text": "ナルセくんと20年前とその後の10年から最高にいい時期だと。",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0049",
      "start": 281.15,
      "end": 286.25,
      "text": "今、すごい水産資源を告発しているシーン、いろんな部分で",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0050",
      "start": 286.25,
      "end": 289.45,
      "text": "ただものを作って売れる時代でも、もちろんないシーン。",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0051",
      "start": 289.45,
      "end": 293.85,
      "text": "シラスのトップ、業界のトップをクオリティーで貼ってるかもしれない。",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0052",
      "start": 293.85,
      "end": 300.65,
      "text": "しかしながら、それを届けているマーケットも弱っていたりとか、いろんなことがあった。",
      "avg_logprob": -0.3762540136640136,
      "no_speech_prob": 0.2549896538257599
    },
    {
      "id": "SEG_0053",
      "start": 300.65,
      "end": 305.65,
      "text": "海外というところでは、タイヤ、ベトナムでは第1人車でガンカリになってきた。",
      "avg_logprob": -0.29500745269034406,
      "no_speech_prob": 0.24691873788833618
    },
    {
      "id": "SEG_0054",
      "start": 305.65,
      "end": 309.65,
      "text": "シラスといえば、アセアのナンバー1の会社ではある。",
      "avg_logprob": -0.29500745269034406,
      "no_speech_prob": 0.24691873788833618
    },
    {
      "id": "SEG_0055",
      "start": 309.65,
      "end": 315.65,
      "text": "でも、それの先、一歩先はなんかこういう揺らぐところが、",
      "avg_logprob": -0.29500745269034406,
      "no_speech_prob": 0.24691873788833618
    },
    {
      "id": "SEG_0056",
      "start": 315.65,
      "end": 320.65,
      "text": "今までだったらこれ10年は安体だなというのは、そうじゃないような時代が続いている。",
      "avg_logprob": -0.29500745269034406,
      "no_speech_prob": 0.24691873788833618
    },
    {
      "id": "SEG_0057",
      "start": 320.65,
      "end": 327.65,
      "text": "その中で、今こうやって皆さん方のいろんな知識とか知恵とか経験なんかもこうね、",
      "avg_logprob": -0.29500745269034406,
      "no_speech_prob": 0.24691873788833618
    },
    {
      "id": "SEG_0058",
      "start": 327.65,
      "end": 356.65,
      "text": "コラボレーションしながら、素直に受け入れて、そして壁をぶち壊して、なかなか僕らの歳になって、ちょっとかっこいい経験がついちゃうと、その壁ってすごく壊せないんだけども、これもう一回ですね、素直にクリアにして向かっていきたいなと思います。",
      "avg_logprob": -0.2605346011132309,
      "no_speech_prob": 0.1712421178817749
    },
    {
      "id": "SEG_0059",
      "start": 356.65,
      "end": 367.65,
      "text": "明子さんと出会って、酒もやめたし、一滴ものもなくはちょっとね、体も健康になってきたんで、",
      "avg_logprob": -0.3456782889470719,
      "no_speech_prob": 0.49388521909713745
    },
    {
      "id": "SEG_0060",
      "start": 367.65,
      "end": 371.65,
      "text": "ぜひね、これからの日本の世界のために頑張っていきたいなと思います。",
      "avg_logprob": -0.3456782889470719,
      "no_speech_prob": 0.49388521909713745
    },
    {
      "id": "SEG_0061",
      "start": 371.65,
      "end": 376.65,
      "text": "皆さん方の力をお借りできれば、楽しい人生になるかなと思ってますんで、",
      "avg_logprob": -0.3456782889470719,
      "no_speech_prob": 0.49388521909713745
    },
    {
      "id": "SEG_0062",
      "start": 376.65,
      "end": 380.65,
      "text": "ぜひ、青木社長の同じ70歳で100億を目指してですね。",
      "avg_logprob": -0.3456782889470719,
      "no_speech_prob": 0.49388521909713745
    },
    {
      "id": "SEG_0063",
      "start": 380.65,
      "end": 383.65,
      "text": "自然消せしていきたいと思います。よろしくお願いします。",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0064",
      "start": 383.65,
      "end": 385.65,
      "text": "どうもありがとうございました。",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0065",
      "start": 385.65,
      "end": 387.65,
      "text": "ありがとうございました。",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0066",
      "start": 387.65,
      "end": 389.65,
      "text": "せっかくね、このままもちょっと聞いてみますか。",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0067",
      "start": 389.65,
      "end": 392.65,
      "text": "元々AIってどのくらい使われそうですか?",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0068",
      "start": 392.65,
      "end": 396.65,
      "text": "えっと、あの、",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0069",
      "start": 396.65,
      "end": 399.65,
      "text": "チャットGPTにいろいろ聞いてるよとか、",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0070",
      "start": 399.65,
      "end": 401.65,
      "text": "普通に入れてるよとかって、",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0071",
      "start": 401.65,
      "end": 403.65,
      "text": "普段に使ってるよ、",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0072",
      "start": 403.65,
      "end": 405.65,
      "text": "そうなんだぐらいだったんですけど、",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0073",
      "start": 405.65,
      "end": 407.65,
      "text": "ここ半年ぐらいは",
      "avg_logprob": -0.42198616124334787,
      "no_speech_prob": 0.4574055075645447
    },
    {
      "id": "SEG_0074",
      "start": 407.65,
      "end": 413.15,
      "text": "自分でも有料アプリを入れて、いじっている感じで、",
      "avg_logprob": -0.32258853199435217,
      "no_speech_prob": 0.29242050647735596
    },
    {
      "id": "SEG_0075",
      "start": 413.15,
      "end": 422.15,
      "text": "多分、うつの箱をとろいたら話して、iPhoneでやって、いろいろフィードバックもなっている。",
      "avg_logprob": -0.32258853199435217,
      "no_speech_prob": 0.29242050647735596
    },
    {
      "id": "SEG_0076",
      "start": 422.15,
      "end": 429.15,
      "text": "なんか、ここに来るまでってAI使って事業をこんなふうにできるなとかって、何となくアイデアとか発想とあったんですか?",
      "avg_logprob": -0.32258853199435217,
      "no_speech_prob": 0.29242050647735596
    },
    {
      "id": "SEG_0077",
      "start": 429.15,
      "end": 440.41,
      "text": "いろいろ考えております、海外展開とか、それこそM&Aとか、買ううるもともに考えてたり、",
      "avg_logprob": -0.31420298960319787,
      "no_speech_prob": 0.3137289583683014
    },
    {
      "id": "SEG_0078",
      "start": 440.41,
      "end": 449.87,
      "text": "去年、タイの一社を業務資本提携したこともあったりして、いろんな自分だけでこうやろうとしてたんですけど、今までは。",
      "avg_logprob": -0.31420298960319787,
      "no_speech_prob": 0.3137289583683014
    },
    {
      "id": "SEG_0079",
      "start": 449.87,
      "end": 461.71,
      "text": "でも、人の力を借りることでもっと良くなるなとか、自分だけのパワーよりも、誰かのリソースを入ることで良くなるなというところとか、",
      "avg_logprob": -0.22987649911040559,
      "no_speech_prob": 0.1157400980591774
    },
    {
      "id": "SEG_0080",
      "start": 461.71,
      "end": 475.79,
      "text": "あとは、そういうやり方とか、プラスもマイナスもあると思うので、そういうのなんかも、情報を得たりとか、すごくしてたり、心の相談をしてました。",
      "avg_logprob": -0.22987649911040559,
      "no_speech_prob": 0.1157400980591774
    },
    {
      "id": "SEG_0081",
      "start": 475.79,
      "end": 490.79,
      "text": "この相談割れですね。ただ、今日って結構ツールの使い方とかっていう、どっちかとAIを学ぶというよりは、もうちょっとこうAIそのものが世の中どう変えるかみたいな話も多かったと思うんですが、その辺ってこの社長的にはどうしなかった?",
      "avg_logprob": -0.34002916526077387,
      "no_speech_prob": 0.27410444617271423
    },
    {
      "id": "SEG_0082",
      "start": 490.79,
      "end": 503.79,
      "text": "僕そこが良かったと思う。AIのそのやり方みたいなとか色んなこんなのがあるようなバーっていうられつの一日であれば、たぶん半日もたかったと思うんだけど、",
      "avg_logprob": -0.34002916526077387,
      "no_speech_prob": 0.27410444617271423
    },
    {
      "id": "SEG_0083",
      "start": 503.79,
      "end": 512.35,
      "text": "基本やっぱりその使う側とか、あとはその今までこうやってきたこととかで最後のほんとそこに頼らない",
      "avg_logprob": -0.3152538349132727,
      "no_speech_prob": 0.21471743285655975
    },
    {
      "id": "SEG_0084",
      "start": 512.35,
      "end": 518.43,
      "text": "100%頼ってはいけないよみたいなところのお年寄りをちゃんと全部理解しながら",
      "avg_logprob": -0.3152538349132727,
      "no_speech_prob": 0.21471743285655975
    },
    {
      "id": "SEG_0085",
      "start": 518.43,
      "end": 524.59,
      "text": "でも絶対に必要なスキルではあるというところをすごく感じたというところなんで",
      "avg_logprob": -0.3152538349132727,
      "no_speech_prob": 0.21471743285655975
    },
    {
      "id": "SEG_0086",
      "start": 524.59,
      "end": 526.71,
      "text": "ただまだまだ僕はこう",
      "avg_logprob": -0.3152538349132727,
      "no_speech_prob": 0.21471743285655975
    },
    {
      "id": "SEG_0087",
      "start": 526.71,
      "end": 532.71,
      "text": "いろいろ教わった中のどれが、今、これにはプラサマかマイナスなのかというのは、",
      "avg_logprob": -0.2866394037785737,
      "no_speech_prob": 0.356329083442688
    },
    {
      "id": "SEG_0088",
      "start": 532.71,
      "end": 538.71,
      "text": "ナルスさんとかね、カズさんとかみたいな先生方はちょっとまだわからないとかあるけれども、",
      "avg_logprob": -0.2866394037785737,
      "no_speech_prob": 0.356329083442688
    },
    {
      "id": "SEG_0089",
      "start": 538.71,
      "end": 543.71,
      "text": "すごく大切な部分だなって、これからは必要な部分だなと思うし、",
      "avg_logprob": -0.2866394037785737,
      "no_speech_prob": 0.356329083442688
    },
    {
      "id": "SEG_0090",
      "start": 543.71,
      "end": 551.71,
      "text": "今までの自分の行ってきたこと、やってきたこともゼロかだと思ったの。",
      "avg_logprob": -0.2866394037785737,
      "no_speech_prob": 0.356329083442688
    },
    {
      "id": "SEG_0091",
      "start": 551.71,
      "end": 559.23,
      "text": "ちょっと最近よく話すのは、僕なんか黙ってた方がいいよなみたいな",
      "avg_logprob": -0.31976105442101305,
      "no_speech_prob": 0.4198266565799713
    },
    {
      "id": "SEG_0092",
      "start": 559.23,
      "end": 566.33,
      "text": "AIとか世の中の流れとか、そういうところをまだまだドロクサイコトしか言えないから",
      "avg_logprob": -0.31976105442101305,
      "no_speech_prob": 0.4198266565799713
    },
    {
      "id": "SEG_0093",
      "start": 566.33,
      "end": 573.17,
      "text": "ちょっと僕の考えなんかは思っても少し抑えた方がいいなみたいなことをよく言ってたんだけど",
      "avg_logprob": -0.31976105442101305,
      "no_speech_prob": 0.4198266565799713
    },
    {
      "id": "SEG_0094",
      "start": 573.17,
      "end": 582.57,
      "text": "でも、そうでもないから、僕のやっぱり生きてきたこととか、やってきたこととかっていうのをちゃんと共有しながら、",
      "avg_logprob": -0.3409915119409561,
      "no_speech_prob": 0.18509840965270996
    },
    {
      "id": "SEG_0095",
      "start": 582.57,
      "end": 594.57,
      "text": "そして、いろいろなテプノ需要を活用してAIとも協力してもらって、新たな光を見出せるとか、",
      "avg_logprob": -0.3409915119409561,
      "no_speech_prob": 0.18509840965270996
    },
    {
      "id": "SEG_0096",
      "start": 594.57,
      "end": 603.85,
      "text": "見方をガラッと変えることができるのかなというのがちょっと思うことがあるかなというふうに思いました",
      "avg_logprob": -0.39163136285198624,
      "no_speech_prob": 0.09107328206300735
    },
    {
      "id": "SEG_0097",
      "start": 603.85,
      "end": 610.85,
      "text": "ちょっとさえますので、この街立町も周りにいろんな経営者の方が多いと思うんですが",
      "avg_logprob": -0.39163136285198624,
      "no_speech_prob": 0.09107328206300735
    },
    {
      "id": "SEG_0098",
      "start": 610.85,
      "end": 616.85,
      "text": "どんな人が受けたら、どんな価値を減そうと思いますか",
      "avg_logprob": -0.39163136285198624,
      "no_speech_prob": 0.09107328206300735
    },
    {
      "id": "SEG_0099",
      "start": 616.85,
      "end": 619.85,
      "text": "どう思いますか",
      "avg_logprob": -0.39163136285198624,
      "no_speech_prob": 0.09107328206300735
    },
    {
      "id": "SEG_0100",
      "start": 619.85,
      "end": 624.85,
      "text": "そうですね、なんか本当幅広でいろんな価値があるなと思って",
      "avg_logprob": -0.39163136285198624,
      "no_speech_prob": 0.09107328206300735
    },
    {
      "id": "SEG_0101",
      "start": 624.85,
      "end": 634.85,
      "text": "本当に実作業者の方も私も今日 ボルダー整理とかという間にしてくれて",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0102",
      "start": 634.85,
      "end": 637.85,
      "text": "それって私がスタッフに頼んでることなんですね",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0103",
      "start": 637.85,
      "end": 641.85,
      "text": "でもスタッフがそれを知ってれば別に人がやり必要もないし",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0104",
      "start": 641.85,
      "end": 644.85,
      "text": "そういう実作業者も知った方がいいし",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0105",
      "start": 644.85,
      "end": 646.85,
      "text": "やっぱり逆に指示だす側も",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0106",
      "start": 646.85,
      "end": 650.85,
      "text": "それツールがあるという前提で仕事を頼んだ方がいいし",
      "avg_logprob": -0.2624067268371582,
      "no_speech_prob": 0.40387293696403503
    },
    {
      "id": "SEG_0107",
      "start": 650.85,
      "end": 656.83,
      "text": "ノブさんみたいな石決定とか 傾想もそういう状況を踏まえた上で",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0108",
      "start": 656.83,
      "end": 662.33,
      "text": "AIの力を使いながら 描ける未来っていうのもあるのかなと思ったので",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0109",
      "start": 662.33,
      "end": 665.63,
      "text": "ほんと トップからまったまでっていうのはあれですから",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0110",
      "start": 665.63,
      "end": 668.61,
      "text": "幅広で いろんな使い方で",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0111",
      "start": 668.61,
      "end": 673.17,
      "text": "みんなが使っていけたら すごくいいなっていうのは感じました",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0112",
      "start": 673.17,
      "end": 675.27,
      "text": "ありがとうございます",
      "avg_logprob": -0.4073253997347572,
      "no_speech_prob": 0.16001971065998077
    },
    {
      "id": "SEG_0113",
      "start": 675.27,
      "end": 681.07,
      "text": "AIのセミナーですよ 勉強会みたいな側が強く感じたけど",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0114",
      "start": 681.07,
      "end": 686.27,
      "text": "上でそうじゃないから 経営者としてとか",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0115",
      "start": 686.27,
      "end": 690.55,
      "text": "これから世界とバッグ本との世の中に生きていく",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0116",
      "start": 690.55,
      "end": 695.91,
      "text": "やたっては必ず必要な技術だとは思ってるし",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0117",
      "start": 695.91,
      "end": 699.63,
      "text": "少しの中であり方なんかも入ってくるので",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0118",
      "start": 699.63,
      "end": 704.27,
      "text": "僕は自分が感じたんで同じような",
      "avg_logprob": -0.37770778942952116,
      "no_speech_prob": 0.20231887698173523
    },
    {
      "id": "SEG_0119",
      "start": 704.27,
      "end": 708.27,
      "text": "最近壁にぶつかってる経営者の方々とかには",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0120",
      "start": 708.27,
      "end": 710.39,
      "text": "ぜひね、トライしてもらいたいなと思うし",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0121",
      "start": 710.39,
      "end": 711.89,
      "text": "社員だけ送るだけじゃなくて",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0122",
      "start": 711.89,
      "end": 714.55,
      "text": "まず、トップな感じとかなことは",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0123",
      "start": 714.55,
      "end": 718.19,
      "text": "どうぐらいじかなっていうのを思うかな",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0124",
      "start": 718.19,
      "end": 721.87,
      "text": "で、そんな研修だなっていうのは思うんで",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0125",
      "start": 721.87,
      "end": 725.27,
      "text": "それをもっともっと前に出してもらったら",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0126",
      "start": 725.27,
      "end": 728.27,
      "text": "いいじゃないかなみたいな思いますけどね",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0127",
      "start": 728.27,
      "end": 729.39,
      "text": "いいじゃん",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0128",
      "start": 729.39,
      "end": 734.11,
      "text": "社長経営者は倍ぐらいの業界でしたか",
      "avg_logprob": -0.29521653415463495,
      "no_speech_prob": 0.15964040160179138
    },
    {
      "id": "SEG_0129",
      "start": 734.11,
      "end": 738.11,
      "text": "もう一つの頂点みたいなものです。",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0130",
      "start": 738.11,
      "end": 744.09,
      "text": "そうですね。じゃあ、価格をアップしている方法も含めて。",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0131",
      "start": 744.09,
      "end": 750.09,
      "text": "是非、フィットする方がいたらでてお伝えいただけるお楽しみ。",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0132",
      "start": 750.09,
      "end": 756.36,
      "text": "本当に今日はどうもありがとうございました。",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0133",
      "start": 756.36,
      "end": 760.36,
      "text": "私は、情報だけど、A、後で送りますけど、",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0134",
      "start": 760.36,
      "end": 763.36,
      "text": "ふなばし屋のナベちゃんとかにさ、誘われたの。",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    },
    {
      "id": "SEG_0135",
      "start": 763.36,
      "end": 765.36,
      "text": "AIの…",
      "avg_logprob": -0.49573160964867163,
      "no_speech_prob": 0.20536869764328003
    }
  ]
}