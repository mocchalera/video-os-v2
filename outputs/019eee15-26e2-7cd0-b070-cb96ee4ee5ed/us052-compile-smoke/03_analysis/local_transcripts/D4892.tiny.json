{
  "source": "D4892.MP4",
  "language": "ja",
  "duration_sec": 767.77,
  "segments": [
    {
      "id": "SEG_0001",
      "start": 0.02,
      "end": 2.18,
      "text": "見て終わりたらなおというふうにもいます。"
    },
    {
      "id": "SEG_0002",
      "start": 2.18,
      "end": 3.18,
      "text": "こちら、申し示はいいんですよ。"
    },
    {
      "id": "SEG_0003",
      "start": 3.18,
      "end": 5.18,
      "text": "ちゃんの経営からと思いますから。"
    },
    {
      "id": "SEG_0004",
      "start": 5.18,
      "end": 6.3,
      "text": "はい、まずは、というつも、"
    },
    {
      "id": "SEG_0005",
      "start": 6.3,
      "end": 9.18,
      "text": "じゃあ、ありがとうございました。"
    },
    {
      "id": "SEG_0006",
      "start": 9.18,
      "end": 12.18,
      "text": "私自身AIっていうのもとに、"
    },
    {
      "id": "SEG_0007",
      "start": 12.18,
      "end": 14.42,
      "text": "ウィルファーとか通り上ってから、"
    },
    {
      "id": "SEG_0008",
      "start": 14.42,
      "end": 15.38,
      "text": "なんで、ほんとに、"
    },
    {
      "id": "SEG_0009",
      "start": 15.38,
      "end": 17.18,
      "text": "シークライトから、"
    },
    {
      "id": "SEG_0010",
      "start": 17.18,
      "end": 21.46,
      "text": "やっと使え始めちゃうみたいな状況で、"
    },
    {
      "id": "SEG_0011",
      "start": 21.46,
      "end": 23.78,
      "text": "それこそ環境って、"
    },
    {
      "id": "SEG_0012",
      "start": 23.78,
      "end": 25.46,
      "text": "さより終わったんですけど、"
    },
    {
      "id": "SEG_0013",
      "start": 25.46,
      "end": 26.26,
      "text": "今までは、"
    },
    {
      "id": "SEG_0014",
      "start": 26.26,
      "end": 29.1,
      "text": "映画とか環境じゃなかった。"
    },
    {
      "id": "SEG_0015",
      "start": 29.1,
      "end": 36.22,
      "text": "みなさんが使うのが当たり前っていう環境に開かせていただいたことで、"
    },
    {
      "id": "SEG_0016",
      "start": 36.22,
      "end": 43.1,
      "text": "それで、初めているピータのページを自分に作れたりとか、"
    },
    {
      "id": "SEG_0017",
      "start": 43.1,
      "end": 47.1,
      "text": "今日も自分の自分の自分を紹介とかなんで、"
    },
    {
      "id": "SEG_0018",
      "start": 47.1,
      "end": 49.1,
      "text": "こうやって出してたのにまとめてなかったから、"
    },
    {
      "id": "SEG_0019",
      "start": 49.1,
      "end": 51.1,
      "text": "って気づけたりとか、"
    },
    {
      "id": "SEG_0020",
      "start": 51.1,
      "end": 55.1,
      "text": "そういった本当に自分のウィルとかを、"
    },
    {
      "id": "SEG_0021",
      "start": 55.1,
      "end": 58.18,
      "text": "大人を出していけるチャンスとかを"
    },
    {
      "id": "SEG_0022",
      "start": 58.18,
      "end": 62.22,
      "text": "自分自身が知れった新自身できたというのが"
    },
    {
      "id": "SEG_0023",
      "start": 62.22,
      "end": 65.22,
      "text": "その3つのカメロンなったの"
    },
    {
      "id": "SEG_0024",
      "start": 65.22,
      "end": 68.18,
      "text": "経験でいうところが"
    },
    {
      "id": "SEG_0025",
      "start": 68.18,
      "end": 70.1,
      "text": "本当に今日はできて"
    },
    {
      "id": "SEG_0026",
      "start": 70.1,
      "end": 71.26,
      "text": "すごい分かったなって"
    },
    {
      "id": "SEG_0027",
      "start": 71.26,
      "end": 72.74,
      "text": "感覚がありましたし"
    },
    {
      "id": "SEG_0028",
      "start": 72.74,
      "end": 74.26,
      "text": "素敵なのとにとも"
    },
    {
      "id": "SEG_0029",
      "start": 74.26,
      "end": 76.94,
      "text": "別にができたのをすごく"
    },
    {
      "id": "SEG_0030",
      "start": 76.94,
      "end": 79.66,
      "text": "やったい一日がなかったと思っています"
    },
    {
      "id": "SEG_0031",
      "start": 79.66,
      "end": 84.27,
      "text": "ありがとうございました"
    },
    {
      "id": "SEG_0032",
      "start": 84.27,
      "end": 91.27,
      "text": "そういう感じが、本当に今の現象が終わりなどになりました。"
    },
    {
      "id": "SEG_0033",
      "start": 91.27,
      "end": 98.27,
      "text": "なんか、初めての皆さんこういった動員にすごく感謝するとともに、"
    },
    {
      "id": "SEG_0034",
      "start": 98.27,
      "end": 102.27,
      "text": "自分自身はAIというのか、本当に理信欠をで、"
    },
    {
      "id": "SEG_0035",
      "start": 102.27,
      "end": 107.27,
      "text": "どんどん出てくるし、お越えAIか、きたたくもったら、くるのじゃみきだった。"
    },
    {
      "id": "SEG_0036",
      "start": 107.27,
      "end": 112.97,
      "text": "初めて来たくらとか、なんかいろいろちょっと気付いているわけでちゃったんですけど、"
    },
    {
      "id": "SEG_0037",
      "start": 112.97,
      "end": 115.99,
      "text": "本当たくさんのものが出てくる中で、"
    },
    {
      "id": "SEG_0038",
      "start": 115.99,
      "end": 120.31,
      "text": "それを、なんか、気付いたキャッチャックして情報としてとって、"
    },
    {
      "id": "SEG_0039",
      "start": 120.31,
      "end": 125.07,
      "text": "活用していきたいなって、気持ちがすごく思いました。"
    },
    {
      "id": "SEG_0040",
      "start": 125.07,
      "end": 132.71,
      "text": "やっと、失礼す言語のから、始まり実装の通りまで作るまでというところでも、"
    },
    {
      "id": "SEG_0041",
      "start": 132.71,
      "end": 138.51,
      "text": "本当にこんなこともあるできるんだ って本当にリックリしてます"
    },
    {
      "id": "SEG_0042",
      "start": 138.51,
      "end": 145.31,
      "text": "なので、これを地域だけで終わらせずに ちゃんと発生していくってところを"
    },
    {
      "id": "SEG_0043",
      "start": 145.31,
      "end": 150.51,
      "text": "たぶさんとしており、私は、松山、松山、していからいきたいと思います"
    },
    {
      "id": "SEG_0044",
      "start": 150.51,
      "end": 154.6,
      "text": "ありがとうございました"
    },
    {
      "id": "SEG_0045",
      "start": 154.6,
      "end": 156.4,
      "text": "はい、ありがとうございました"
    },
    {
      "id": "SEG_0046",
      "start": 156.4,
      "end": 164.97,
      "text": "ちょっと待って、ありがとうございます"
    },
    {
      "id": "SEG_0047",
      "start": 164.97,
      "end": 168.97,
      "text": "ある様子をさせてもらいました。"
    },
    {
      "id": "SEG_0048",
      "start": 169.97,
      "end": 174.97,
      "text": "教題のような先生のような、ずっと繰り返れば、"
    },
    {
      "id": "SEG_0049",
      "start": 175.97,
      "end": 178.97,
      "text": "悩むせたくやここにあるみたいなんですけど、"
    },
    {
      "id": "SEG_0050",
      "start": 178.97,
      "end": 182.97,
      "text": "そんな後関係が本当にも、うれしく思いますし。"
    },
    {
      "id": "SEG_0051",
      "start": 183.97,
      "end": 184.97,
      "text": "この、この、"
    },
    {
      "id": "SEG_0052",
      "start": 185.97,
      "end": 189.97,
      "text": "僕の今までの関係だと、"
    },
    {
      "id": "SEG_0053",
      "start": 190.97,
      "end": 192.97,
      "text": "僕らの、その決定は、"
    },
    {
      "id": "SEG_0054",
      "start": 192.97,
      "end": 194.97,
      "text": "今、こうやって職業したわけです。"
    },
    {
      "id": "SEG_0055",
      "start": 194.97,
      "end": 196.97,
      "text": "私、まま必要なのかな?"
    },
    {
      "id": "SEG_0056",
      "start": 196.97,
      "end": 200.97,
      "text": "すごい色々情報をくれられ、"
    },
    {
      "id": "SEG_0057",
      "start": 200.97,
      "end": 201.97,
      "text": "一時、いちいぎも、"
    },
    {
      "id": "SEG_0058",
      "start": 201.97,
      "end": 203.97,
      "text": "裏返みたいなのに、"
    },
    {
      "id": "SEG_0059",
      "start": 203.97,
      "end": 204.97,
      "text": "こういったことは、"
    },
    {
      "id": "SEG_0060",
      "start": 204.97,
      "end": 205.97,
      "text": "すごく、"
    },
    {
      "id": "SEG_0061",
      "start": 205.97,
      "end": 206.97,
      "text": "練習者みたいな、"
    },
    {
      "id": "SEG_0062",
      "start": 206.97,
      "end": 207.97,
      "text": "自分の、"
    },
    {
      "id": "SEG_0063",
      "start": 207.97,
      "end": 209.97,
      "text": "数数の勉強に行っているのか、"
    },
    {
      "id": "SEG_0064",
      "start": 209.97,
      "end": 211.97,
      "text": "サポートに行ったら、"
    },
    {
      "id": "SEG_0065",
      "start": 211.97,
      "end": 212.97,
      "text": "たくさん、"
    },
    {
      "id": "SEG_0066",
      "start": 212.97,
      "end": 213.97,
      "text": "最近、"
    },
    {
      "id": "SEG_0067",
      "start": 213.97,
      "end": 214.97,
      "text": "すごい、"
    },
    {
      "id": "SEG_0068",
      "start": 214.97,
      "end": 215.97,
      "text": "それに、"
    },
    {
      "id": "SEG_0069",
      "start": 215.97,
      "end": 216.97,
      "text": "チャンピークに対応する、"
    },
    {
      "id": "SEG_0070",
      "start": 216.97,
      "end": 217.97,
      "text": "自分も行ったり、"
    },
    {
      "id": "SEG_0071",
      "start": 217.97,
      "end": 218.97,
      "text": "でも、"
    },
    {
      "id": "SEG_0072",
      "start": 218.97,
      "end": 219.97,
      "text": "もちろいなと思いながら、"
    },
    {
      "id": "SEG_0073",
      "start": 219.97,
      "end": 226.17,
      "text": "いながら、なんか今日1日いろんなコースキルは学ばせていただいた。"
    },
    {
      "id": "SEG_0074",
      "start": 226.17,
      "end": 228.37,
      "text": "そしてそれをとどのように活用するかというのは、"
    },
    {
      "id": "SEG_0075",
      "start": 228.37,
      "end": 232.57,
      "text": "まだまだ国家もおりしてからかなかなかなというところはある。"
    },
    {
      "id": "SEG_0076",
      "start": 232.57,
      "end": 236.61,
      "text": "ただ、最後のやっぱり、"
    },
    {
      "id": "SEG_0077",
      "start": 236.61,
      "end": 240.97,
      "text": "何故のメッセージで落とし合うなのところ。"
    },
    {
      "id": "SEG_0078",
      "start": 240.97,
      "end": 243.25,
      "text": "これすごく、僕らは、"
    },
    {
      "id": "SEG_0079",
      "start": 243.25,
      "end": 244.89,
      "text": "わからないが夢に、"
    },
    {
      "id": "SEG_0080",
      "start": 244.89,
      "end": 248.73,
      "text": "大歩すぎることなく今のボムの"
    },
    {
      "id": "SEG_0081",
      "start": 248.73,
      "end": 252.73,
      "text": "生きてきた人生の経験とそしてこれから見える"
    },
    {
      "id": "SEG_0082",
      "start": 252.73,
      "end": 255.77,
      "text": "ビジョンとそしてかかる人とで"
    },
    {
      "id": "SEG_0083",
      "start": 255.77,
      "end": 258.89,
      "text": "活躍の今の最初のテクノロジーとか"
    },
    {
      "id": "SEG_0084",
      "start": 258.89,
      "end": 260.25,
      "text": "やりたいとか"
    },
    {
      "id": "SEG_0085",
      "start": 260.25,
      "end": 262.01,
      "text": "あって本当にすごい情報を"
    },
    {
      "id": "SEG_0086",
      "start": 262.01,
      "end": 263.45,
      "text": "あったあつめてくれるような"
    },
    {
      "id": "SEG_0087",
      "start": 263.45,
      "end": 266.41,
      "text": "こういった好きの活用して"
    },
    {
      "id": "SEG_0088",
      "start": 266.41,
      "end": 268.09,
      "text": "自分がなりができる方々の"
    },
    {
      "id": "SEG_0089",
      "start": 268.09,
      "end": 270.49,
      "text": "みんなを好き書いたなってのは"
    },
    {
      "id": "SEG_0090",
      "start": 270.49,
      "end": 272.65,
      "text": "すごく思ったところであります"
    },
    {
      "id": "SEG_0091",
      "start": 272.65,
      "end": 280.97,
      "text": "どっちにすごくわたっても大切にとるいじめまいとその後の10年から最高にいじめる"
    },
    {
      "id": "SEG_0092",
      "start": 280.97,
      "end": 289.41,
      "text": "今すごい小さしいのを交換しているし、いろんな部分でただものを作って売れる時代でもこちらもないし"
    },
    {
      "id": "SEG_0093",
      "start": 289.41,
      "end": 293.89,
      "text": "知らずのと、予開がトップを、効率の発表もしてない。"
    },
    {
      "id": "SEG_0094",
      "start": 293.89,
      "end": 298.41,
      "text": "しかし、そのこととき、ルーマーケットも弱ってたり、"
    },
    {
      "id": "SEG_0095",
      "start": 298.41,
      "end": 300.65,
      "text": "ほか、いろんなことを考えて、"
    },
    {
      "id": "SEG_0096",
      "start": 300.65,
      "end": 302.25,
      "text": "海外というところでは、"
    },
    {
      "id": "SEG_0097",
      "start": 302.25,
      "end": 305.65,
      "text": "またやべとなぐでは大臣者で考えられてたり。"
    },
    {
      "id": "SEG_0098",
      "start": 305.65,
      "end": 307.61,
      "text": "では、知らずとやばあせや、"
    },
    {
      "id": "SEG_0099",
      "start": 307.61,
      "end": 309.41,
      "text": "何番ワンの会社である。"
    },
    {
      "id": "SEG_0100",
      "start": 309.41,
      "end": 313.33,
      "text": "でも、すぐの先、一歩先は、"
    },
    {
      "id": "SEG_0101",
      "start": 313.33,
      "end": 315.17,
      "text": "なんかこういないギラブところが、"
    },
    {
      "id": "SEG_0102",
      "start": 315.17,
      "end": 320.61,
      "text": "まだこれも10年はあったいだなってのはそうじゃないような時代がつる"
    },
    {
      "id": "SEG_0103",
      "start": 320.61,
      "end": 324.33,
      "text": "そこの中で今これやってみなさなったものを"
    },
    {
      "id": "SEG_0104",
      "start": 324.33,
      "end": 327.53,
      "text": "いろんな地域とパチェートパケーキの中もこうね"
    },
    {
      "id": "SEG_0105",
      "start": 327.53,
      "end": 329.81,
      "text": "コラボライシャーしながら"
    },
    {
      "id": "SEG_0106",
      "start": 329.81,
      "end": 332.61,
      "text": "砂肉を受入れてですね"
    },
    {
      "id": "SEG_0107",
      "start": 332.61,
      "end": 334.33,
      "text": "そして"
    },
    {
      "id": "SEG_0108",
      "start": 334.33,
      "end": 336.81,
      "text": "カベ"
    },
    {
      "id": "SEG_0109",
      "start": 337.53,
      "end": 340.17,
      "text": "本当それを口詰ましてですね"
    },
    {
      "id": "SEG_0110",
      "start": 340.17,
      "end": 343.33,
      "text": "なかなか僕らのプレイの年になって"
    },
    {
      "id": "SEG_0111",
      "start": 343.33,
      "end": 352.33,
      "text": "ちょっと各位経験がついちゃうと、その壁ってすごく怖せないんだけども、これもう一回ですね。"
    },
    {
      "id": "SEG_0112",
      "start": 352.33,
      "end": 357.33,
      "text": "そのクリアにして、向かっていきたいなと思います。"
    },
    {
      "id": "SEG_0113",
      "start": 357.33,
      "end": 362.33,
      "text": "あの、もう3と出会って、先もやめたし。"
    },
    {
      "id": "SEG_0114",
      "start": 362.33,
      "end": 367.33,
      "text": "一気ものはちょっとね、体の結構なってきたんで、"
    },
    {
      "id": "SEG_0115",
      "start": 367.33,
      "end": 371.33,
      "text": "ぜひね、これからの日本の世界に食べる感覚と来たりだと思います。"
    },
    {
      "id": "SEG_0116",
      "start": 371.33,
      "end": 374.33,
      "text": "皆さんの楽しかったら、おかげでできるわ。"
    },
    {
      "id": "SEG_0117",
      "start": 374.33,
      "end": 376.33,
      "text": "楽しい人生ならかなと思ってますんで、"
    },
    {
      "id": "SEG_0118",
      "start": 376.33,
      "end": 379.33,
      "text": "ぜひ、あんきちゃんと同じ、七所したいで、"
    },
    {
      "id": "SEG_0119",
      "start": 379.33,
      "end": 381.33,
      "text": "白く目指してですね。"
    },
    {
      "id": "SEG_0120",
      "start": 381.33,
      "end": 383.33,
      "text": "実際、経済していきたいと思います。よろしくお願いします。"
    },
    {
      "id": "SEG_0121",
      "start": 383.33,
      "end": 385.33,
      "text": "その我々が思いました。"
    },
    {
      "id": "SEG_0122",
      "start": 385.33,
      "end": 386.33,
      "text": "私の方が思いました。"
    },
    {
      "id": "SEG_0123",
      "start": 387.33,
      "end": 389.33,
      "text": "世界にこのものもちょっときっきいけみです。"
    },
    {
      "id": "SEG_0124",
      "start": 389.33,
      "end": 393.33,
      "text": "もともとAIってどのくらいですか?"
    },
    {
      "id": "SEG_0125",
      "start": 393.33,
      "end": 401.49,
      "text": "あと、ちょっとGPTに色々聞いてるようとか、その普通に入れてるようと"
    },
    {
      "id": "SEG_0126",
      "start": 401.49,
      "end": 405.65,
      "text": "だって普段にこっちかってるよう、そうなんだくらいだったんですけど、"
    },
    {
      "id": "SEG_0127",
      "start": 405.65,
      "end": 410.93,
      "text": "ここ半年ぐらいは自分でも、シュールルパプリを入れて、"
    },
    {
      "id": "SEG_0128",
      "start": 410.93,
      "end": 413.73,
      "text": "イジっている感じで、"
    },
    {
      "id": "SEG_0129",
      "start": 413.73,
      "end": 418.49,
      "text": "たまの物の箱を取りあえたら話して"
    },
    {
      "id": "SEG_0130",
      "start": 418.49,
      "end": 420.65,
      "text": "アイフォンでやって"
    },
    {
      "id": "SEG_0131",
      "start": 420.65,
      "end": 422.53,
      "text": "いろいろフィドバックもなって"
    },
    {
      "id": "SEG_0132",
      "start": 422.53,
      "end": 424.49,
      "text": "なんか、今日ここに来るまで"
    },
    {
      "id": "SEG_0133",
      "start": 424.49,
      "end": 427.17,
      "text": "ってAIスが手事業をお願いいたくなって"
    },
    {
      "id": "SEG_0134",
      "start": 427.17,
      "end": 429.25,
      "text": "なんとなく、アイヤーとか発送だったんです"
    },
    {
      "id": "SEG_0135",
      "start": 429.25,
      "end": 431.41,
      "text": "いろいろ考えております"
    },
    {
      "id": "SEG_0136",
      "start": 431.41,
      "end": 433.37,
      "text": "その会外展会とか"
    },
    {
      "id": "SEG_0137",
      "start": 433.37,
      "end": 435.25,
      "text": "それごとその"
    },
    {
      "id": "SEG_0138",
      "start": 435.25,
      "end": 436.53,
      "text": "MRとか、"
    },
    {
      "id": "SEG_0139",
      "start": 436.53,
      "end": 440.53,
      "text": "カウルのともに考えていたい、"
    },
    {
      "id": "SEG_0140",
      "start": 440.53,
      "end": 445.53,
      "text": "今日年の大の一社を業種を提供したことをまったりして"
    },
    {
      "id": "SEG_0141",
      "start": 445.53,
      "end": 448.53,
      "text": "いろんなも自分だけでこうやろうとしてたんですけど"
    },
    {
      "id": "SEG_0142",
      "start": 448.53,
      "end": 449.53,
      "text": "今までは、"
    },
    {
      "id": "SEG_0143",
      "start": 449.53,
      "end": 451.53,
      "text": "でも、その人の力を借りることで、"
    },
    {
      "id": "SEG_0144",
      "start": 451.53,
      "end": 453.53,
      "text": "もっと良くなるなとか、"
    },
    {
      "id": "SEG_0145",
      "start": 453.53,
      "end": 456.53,
      "text": "自分だけのパワーよりも、"
    },
    {
      "id": "SEG_0146",
      "start": 456.53,
      "end": 458.53,
      "text": "誰かも、"
    },
    {
      "id": "SEG_0147",
      "start": 458.53,
      "end": 461.53,
      "text": "いそうそう入ることで良くなるなっていうところとか"
    },
    {
      "id": "SEG_0148",
      "start": 461.53,
      "end": 463.53,
      "text": "あとはそういうやり方とか、"
    },
    {
      "id": "SEG_0149",
      "start": 463.53,
      "end": 467.53,
      "text": "そのまま、プラスも前が集まると思うんだ。"
    },
    {
      "id": "SEG_0150",
      "start": 467.53,
      "end": 472.53,
      "text": "そんな感想を情報をやったりとか、すごくしてたり、"
    },
    {
      "id": "SEG_0151",
      "start": 472.53,
      "end": 475.53,
      "text": "心の相談をしています。"
    },
    {
      "id": "SEG_0152",
      "start": 475.53,
      "end": 478.53,
      "text": "この相談は、今日って、"
    },
    {
      "id": "SEG_0153",
      "start": 478.53,
      "end": 482.53,
      "text": "通るの使い方とか、どうしたらAIを学ぶというよりは、"
    },
    {
      "id": "SEG_0154",
      "start": 482.53,
      "end": 485.53,
      "text": "もうちょっと、AI、そのものがいまなかどうか、"
    },
    {
      "id": "SEG_0155",
      "start": 485.53,
      "end": 487.53,
      "text": "よかみたいな話もおかったと思いますが、"
    },
    {
      "id": "SEG_0156",
      "start": 487.53,
      "end": 489.53,
      "text": "その辺って、詳しくは、今日的には、"
    },
    {
      "id": "SEG_0157",
      "start": 489.53,
      "end": 491.53,
      "text": "どうしたら、僕、そこが良かったと、"
    },
    {
      "id": "SEG_0158",
      "start": 491.53,
      "end": 500.53,
      "text": "そのやり方みたいなとかいろんなこんなのがあるようなバーティューラレツの一日であれば"
    },
    {
      "id": "SEG_0159",
      "start": 500.53,
      "end": 505.53,
      "text": "たぶん半日も伝えたと思うんだけど基本やっぱり"
    },
    {
      "id": "SEG_0160",
      "start": 505.53,
      "end": 511.53,
      "text": "使うなとかあとはその今までやってきたこととかで最後のほんと"
    },
    {
      "id": "SEG_0161",
      "start": 511.53,
      "end": 515.53,
      "text": "そこに変わらない100%よってはいてないようみたいなところも"
    },
    {
      "id": "SEG_0162",
      "start": 515.53,
      "end": 524.53,
      "text": "としあのちゃんとちゃんと理解しながらでも絶対に必要なスキルではあるというところをすごく感じたというとこなのです。"
    },
    {
      "id": "SEG_0163",
      "start": 524.53,
      "end": 532.53,
      "text": "まだまだ僕は、いろいろ遅った中のどれが今、これはプラサーの構えなすがのかというのは、"
    },
    {
      "id": "SEG_0164",
      "start": 532.53,
      "end": 537.53,
      "text": "なんか、大人さんとか、からさとか、言ったら先生がたとはちょっとまだ分からないとバルテレルの"
    },
    {
      "id": "SEG_0165",
      "start": 537.53,
      "end": 542.53,
      "text": "すごく大切な部分になります。これからは、"
    },
    {
      "id": "SEG_0166",
      "start": 542.53,
      "end": 547.53,
      "text": "普通の部分なのともしいままでの自分の意識が来たことがやってきたことも"
    },
    {
      "id": "SEG_0167",
      "start": 547.53,
      "end": 551.53,
      "text": "もう、0かなと思ったの。"
    },
    {
      "id": "SEG_0168",
      "start": 551.53,
      "end": 558.53,
      "text": "ちょっとね、最近よく話すのは、いや、僕らが生ちた方はいいよな、みたいな"
    },
    {
      "id": "SEG_0169",
      "start": 558.53,
      "end": 565.19,
      "text": "もうAIとかの4なかの流れとかそういうところもまだまだ"
    },
    {
      "id": "SEG_0170",
      "start": 565.19,
      "end": 568.13,
      "text": "ドロクサイコとしか言えないから、ちょっと僕の考えなんかは"
    },
    {
      "id": "SEG_0171",
      "start": 568.13,
      "end": 571.25,
      "text": "思っても少しおさえたほうがいいなみたいなことね"
    },
    {
      "id": "SEG_0172",
      "start": 571.25,
      "end": 575.01,
      "text": "よく言ってなんだけど、そうでもないかな"
    },
    {
      "id": "SEG_0173",
      "start": 575.01,
      "end": 579.69,
      "text": "僕のやっぱり生きてきたこととかやってきたこととかっていうのを"
    },
    {
      "id": "SEG_0174",
      "start": 579.69,
      "end": 585.29,
      "text": "ちゃんと教授しながら、そしてこのいろいろなの"
    },
    {
      "id": "SEG_0175",
      "start": 585.29,
      "end": 590.29,
      "text": "というかの自由活用して 絵合いと共料を決まって"
    },
    {
      "id": "SEG_0176",
      "start": 590.29,
      "end": 594.29,
      "text": "あらったら光を考えらせるとか"
    },
    {
      "id": "SEG_0177",
      "start": 594.29,
      "end": 599.29,
      "text": "2方をガラッと変えることは できなかなというのはちょっと思うと"
    },
    {
      "id": "SEG_0178",
      "start": 599.29,
      "end": 603.57,
      "text": "あらっているような思いますか"
    },
    {
      "id": "SEG_0179",
      "start": 603.57,
      "end": 605.57,
      "text": "さよなら、一つありますので"
    },
    {
      "id": "SEG_0180",
      "start": 605.57,
      "end": 611.57,
      "text": "この後達は、この子、皆さんも 前にどんな絵者の方が多いと思うのですが"
    },
    {
      "id": "SEG_0181",
      "start": 611.57,
      "end": 616.57,
      "text": "どんな人が受けたらどんな活用でそう?"
    },
    {
      "id": "SEG_0182",
      "start": 616.57,
      "end": 619.57,
      "text": "どう思います?"
    },
    {
      "id": "SEG_0183",
      "start": 619.57,
      "end": 625.57,
      "text": "うん、そうですね、なんか本当は場広でいろんな活用があったと思って"
    },
    {
      "id": "SEG_0184",
      "start": 625.57,
      "end": 633.57,
      "text": "結構、本当に実際教社の方も、私の教科の踊り出せるとか"
    },
    {
      "id": "SEG_0185",
      "start": 633.57,
      "end": 637.57,
      "text": "それで私が歌ふうに楽でございます。"
    },
    {
      "id": "SEG_0186",
      "start": 637.57,
      "end": 642.57,
      "text": "スタッフがそれを知っているパーツに人がやりてもらうし、"
    },
    {
      "id": "SEG_0187",
      "start": 642.57,
      "end": 646.57,
      "text": "そういう実際教科も知った方が一緒にやっぱりキャップにし、"
    },
    {
      "id": "SEG_0188",
      "start": 646.57,
      "end": 650.57,
      "text": "それがあんても全てで仕事だと思うのが一緒に、"
    },
    {
      "id": "SEG_0189",
      "start": 650.57,
      "end": 656.57,
      "text": "このお子さんみたいな、意識をつまえたので、"
    },
    {
      "id": "SEG_0190",
      "start": 656.57,
      "end": 662.57,
      "text": "その時からお疲れながら描ける未来というのもあるのかなと思ったので、"
    },
    {
      "id": "SEG_0191",
      "start": 662.57,
      "end": 666.57,
      "text": "本当からまたまでというのはあれですから、"
    },
    {
      "id": "SEG_0192",
      "start": 666.57,
      "end": 672.57,
      "text": "幅広で4万つかい方でみなが使っていけたらすごくいいなというのは感じました。"
    },
    {
      "id": "SEG_0193",
      "start": 672.57,
      "end": 674.57,
      "text": "ありがとうございます。"
    },
    {
      "id": "SEG_0194",
      "start": 674.57,
      "end": 676.57,
      "text": "そうは、"
    },
    {
      "id": "SEG_0195",
      "start": 676.57,
      "end": 678.57,
      "text": "それが、全くのセミナーです。"
    },
    {
      "id": "SEG_0196",
      "start": 678.57,
      "end": 681.57,
      "text": "勉強会みたいな、この側はこっちよく感じたけど、"
    },
    {
      "id": "SEG_0197",
      "start": 681.57,
      "end": 683.57,
      "text": "別でそうじゃないから、"
    },
    {
      "id": "SEG_0198",
      "start": 683.57,
      "end": 686.57,
      "text": "この計車としてとか、"
    },
    {
      "id": "SEG_0199",
      "start": 686.57,
      "end": 690.57,
      "text": "これから世界とバープ本ともなっていないような感じ、"
    },
    {
      "id": "SEG_0200",
      "start": 690.57,
      "end": 695.57,
      "text": "やったっては必要な事実だと思ってるし、"
    },
    {
      "id": "SEG_0201",
      "start": 695.57,
      "end": 699.57,
      "text": "そこな方はあり方がもう入ってくるので、"
    },
    {
      "id": "SEG_0202",
      "start": 699.57,
      "end": 702.57,
      "text": "僕は自分がこう感じたので、"
    },
    {
      "id": "SEG_0203",
      "start": 702.57,
      "end": 703.57,
      "text": "同じような、"
    },
    {
      "id": "SEG_0204",
      "start": 703.57,
      "end": 707.57,
      "text": "最近壁にぶつかってるケーションの方々は"
    },
    {
      "id": "SEG_0205",
      "start": 707.57,
      "end": 710.57,
      "text": "ぜひ、プライしてもらいたいなと思います。"
    },
    {
      "id": "SEG_0206",
      "start": 710.57,
      "end": 712.57,
      "text": "最初の中を送るだけじゃなくて、"
    },
    {
      "id": "SEG_0207",
      "start": 712.57,
      "end": 715.57,
      "text": "まず、僕が感じてもらうことはどういうことは"
    },
    {
      "id": "SEG_0208",
      "start": 715.57,
      "end": 717.57,
      "text": "時間があってもらうかな。"
    },
    {
      "id": "SEG_0209",
      "start": 717.57,
      "end": 721.57,
      "text": "そんな検証だったようだ"
    },
    {
      "id": "SEG_0210",
      "start": 721.57,
      "end": 724.57,
      "text": "それもどこと前に出すもらったら"
    },
    {
      "id": "SEG_0211",
      "start": 724.57,
      "end": 727.57,
      "text": "いちがないかなと思いますけどね。"
    },
    {
      "id": "SEG_0212",
      "start": 727.57,
      "end": 733.13,
      "text": "じゃあ、社長ケレー者は、パイブライブが両方でしたが、"
    },
    {
      "id": "SEG_0213",
      "start": 733.13,
      "end": 740.55,
      "text": "8分ともう一つの兆点でみたいなのです。"
    },
    {
      "id": "SEG_0214",
      "start": 740.55,
      "end": 741.55,
      "text": "そうですね。"
    },
    {
      "id": "SEG_0215",
      "start": 741.55,
      "end": 743.55,
      "text": "じゃあ、各校あっとしせると、"
    },
    {
      "id": "SEG_0216",
      "start": 743.55,
      "end": 744.55,
      "text": "もう一つの兆点で、"
    },
    {
      "id": "SEG_0217",
      "start": 744.55,
      "end": 745.55,
      "text": "全員さんで、"
    },
    {
      "id": "SEG_0218",
      "start": 745.55,
      "end": 747.55,
      "text": "ぜひ、"
    },
    {
      "id": "SEG_0219",
      "start": 747.55,
      "end": 749.55,
      "text": "フィットするかかがいでは、"
    },
    {
      "id": "SEG_0220",
      "start": 749.55,
      "end": 750.55,
      "text": "で、ご期待いただけようと、"
    },
    {
      "id": "SEG_0221",
      "start": 750.55,
      "end": 752.55,
      "text": "本当に、今日はどうもありがとうございました。"
    },
    {
      "id": "SEG_0222",
      "start": 752.55,
      "end": 758.82,
      "text": "早く、今日の方だけ、"
    },
    {
      "id": "SEG_0223",
      "start": 758.82,
      "end": 765.82,
      "text": "あとでお送りますけど、ふなばしやのナブちゃんともにささそうやったのが意外の方がある"
    }
  ]
}