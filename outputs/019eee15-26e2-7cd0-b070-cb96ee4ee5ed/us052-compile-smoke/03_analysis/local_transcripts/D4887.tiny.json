{
  "source": "D4887.MP4",
  "language": "ja",
  "duration_sec": 331.335,
  "segments": [
    {
      "id": "SEG_0001",
      "start": 0.88,
      "end": 6.48,
      "text": "そっちの部分にどんなことを期待してきました。"
    },
    {
      "id": "SEG_0002",
      "start": 6.48,
      "end": 8.48,
      "text": "やはり期待してなかったと思います。"
    },
    {
      "id": "SEG_0003",
      "start": 8.48,
      "end": 10.78,
      "text": "期待と言いますか、"
    },
    {
      "id": "SEG_0004",
      "start": 10.78,
      "end": 15.28,
      "text": "僕はあまり寄りながって出ないんですけど、"
    },
    {
      "id": "SEG_0005",
      "start": 15.28,
      "end": 17.08,
      "text": "正直がAIについては、"
    },
    {
      "id": "SEG_0006",
      "start": 17.08,
      "end": 20.08,
      "text": "期期間をずっと持っていまして、"
    },
    {
      "id": "SEG_0007",
      "start": 20.08,
      "end": 23.08,
      "text": "そんな何かを変えながら行けないと、"
    },
    {
      "id": "SEG_0008",
      "start": 23.08,
      "end": 24.48,
      "text": "日曜日も思ってたんですけど、"
    },
    {
      "id": "SEG_0009",
      "start": 24.48,
      "end": 25.88,
      "text": "そんなタイミングで、"
    },
    {
      "id": "SEG_0010",
      "start": 25.88,
      "end": 28.48,
      "text": "今は、お前にアンスさんから、これが出たらいて、"
    },
    {
      "id": "SEG_0011",
      "start": 28.48,
      "end": 31.48,
      "text": "今日さんかさせていただいたのという感じですね。"
    },
    {
      "id": "SEG_0012",
      "start": 31.48,
      "end": 34.08,
      "text": "やはり、機関もっている方とかにも言うと思うんですけど、"
    },
    {
      "id": "SEG_0013",
      "start": 34.08,
      "end": 37.48,
      "text": "とは言えながりを、色々せみなってやるじゃないですか。"
    },
    {
      "id": "SEG_0014",
      "start": 37.48,
      "end": 39.28,
      "text": "やはりの方が多いな。"
    },
    {
      "id": "SEG_0015",
      "start": 39.28,
      "end": 42.48,
      "text": "その中で、今回のAX1で、"
    },
    {
      "id": "SEG_0016",
      "start": 42.48,
      "end": 44.88,
      "text": "なんか、引かかったのが、気になったのだった。"
    },
    {
      "id": "SEG_0017",
      "start": 44.88,
      "end": 48.08,
      "text": "気になった、気になったのか。"
    },
    {
      "id": "SEG_0018",
      "start": 48.08,
      "end": 49.88,
      "text": "このシーンがお話さと、"
    },
    {
      "id": "SEG_0019",
      "start": 50.88,
      "end": 52.88,
      "text": "気になった点。"
    },
    {
      "id": "SEG_0020",
      "start": 52.88,
      "end": 55.88,
      "text": "編集してください"
    },
    {
      "id": "SEG_0021",
      "start": 55.88,
      "end": 57.88,
      "text": "気になった点ですか"
    },
    {
      "id": "SEG_0022",
      "start": 57.88,
      "end": 58.88,
      "text": "なんかこう"
    },
    {
      "id": "SEG_0023",
      "start": 58.88,
      "end": 61.88,
      "text": "ちょっとこの辺が大事があるとか"
    },
    {
      "id": "SEG_0024",
      "start": 61.88,
      "end": 62.88,
      "text": "面白そうなのとか"
    },
    {
      "id": "SEG_0025",
      "start": 62.88,
      "end": 66.88,
      "text": "何かか実践的で"
    },
    {
      "id": "SEG_0026",
      "start": 66.88,
      "end": 69.88,
      "text": "サーブリナーがラマで出るってところで"
    },
    {
      "id": "SEG_0027",
      "start": 69.88,
      "end": 74.88,
      "text": "今は原子人たちが少しちょっと自身にもらりましたし"
    },
    {
      "id": "SEG_0028",
      "start": 74.88,
      "end": 76.88,
      "text": "やしさがら"
    },
    {
      "id": "SEG_0029",
      "start": 76.88,
      "end": 79.88,
      "text": "一つつつつ"
    },
    {
      "id": "SEG_0030",
      "start": 79.88,
      "end": 81.88,
      "text": "とても区域があったわけです。"
    },
    {
      "id": "SEG_0031",
      "start": 81.88,
      "end": 85.88,
      "text": "なんか、印象的やったセッションとかありますか?"
    },
    {
      "id": "SEG_0032",
      "start": 85.88,
      "end": 92.88,
      "text": "えーっと、自分でアプリンズとか、"
    },
    {
      "id": "SEG_0033",
      "start": 92.88,
      "end": 95.88,
      "text": "スクレーちゃんだとか、"
    },
    {
      "id": "SEG_0034",
      "start": 95.88,
      "end": 98.88,
      "text": "あの、程度の指引も、"
    },
    {
      "id": "SEG_0035",
      "start": 98.88,
      "end": 99.88,
      "text": "これはありますけど、"
    },
    {
      "id": "SEG_0036",
      "start": 99.88,
      "end": 101.88,
      "text": "さああれば、"
    },
    {
      "id": "SEG_0037",
      "start": 101.88,
      "end": 104.88,
      "text": "今の僕なりのものはできちゃうんだった"
    },
    {
      "id": "SEG_0038",
      "start": 104.88,
      "end": 106.88,
      "text": "っていうところで、ちょっと感動しました。"
    },
    {
      "id": "SEG_0039",
      "start": 106.88,
      "end": 115.88,
      "text": "やる前とやった後でアプリというか作れちゃったっていこう、"
    },
    {
      "id": "SEG_0040",
      "start": 115.88,
      "end": 118.88,
      "text": "なんか自分なかでの変化を感じます。"
    },
    {
      "id": "SEG_0041",
      "start": 118.88,
      "end": 121.88,
      "text": "そうですね、とにかく、"
    },
    {
      "id": "SEG_0042",
      "start": 121.88,
      "end": 124.88,
      "text": "その経験の壁みたいなところに関しては、"
    },
    {
      "id": "SEG_0043",
      "start": 124.88,
      "end": 128.88,
      "text": "また僕一番そこをたったんですけど、"
    },
    {
      "id": "SEG_0044",
      "start": 128.88,
      "end": 137.88,
      "text": "まだでもさあってみようとそれぞれずにさあってみようという気持ちにはなっています。"
    },
    {
      "id": "SEG_0045",
      "start": 137.88,
      "end": 142.88,
      "text": "なんか、お自身の経営者としてお会社でやっていく上で、"
    },
    {
      "id": "SEG_0046",
      "start": 142.88,
      "end": 147.88,
      "text": "こんなことに一緒だなとか、こんな風にできるんじゃないかな?"
    },
    {
      "id": "SEG_0047",
      "start": 147.88,
      "end": 152.88,
      "text": "個人的な自動ともに関しては、"
    },
    {
      "id": "SEG_0048",
      "start": 152.88,
      "end": 154.88,
      "text": "ずっと気味はなってたんですけど、"
    },
    {
      "id": "SEG_0049",
      "start": 154.88,
      "end": 156.88,
      "text": "まあ、ケーブルですが、"
    },
    {
      "id": "SEG_0050",
      "start": 156.88,
      "end": 158.88,
      "text": "お金の部分ですね。"
    },
    {
      "id": "SEG_0051",
      "start": 158.88,
      "end": 160.88,
      "text": "まあ、とるちの業務的なことで、"
    },
    {
      "id": "SEG_0052",
      "start": 160.88,
      "end": 161.88,
      "text": "ほもほも平らえると、"
    },
    {
      "id": "SEG_0053",
      "start": 161.88,
      "end": 162.88,
      "text": "とってかわれるのがし、"
    },
    {
      "id": "SEG_0054",
      "start": 162.88,
      "end": 164.88,
      "text": "とばかりで、"
    },
    {
      "id": "SEG_0055",
      "start": 164.88,
      "end": 167.88,
      "text": "あれめちょっと怖い部分であるんですけど、"
    },
    {
      "id": "SEG_0056",
      "start": 167.88,
      "end": 170.88,
      "text": "もうさすがしたから、"
    },
    {
      "id": "SEG_0057",
      "start": 170.88,
      "end": 172.88,
      "text": "感悪くて、"
    },
    {
      "id": "SEG_0058",
      "start": 172.88,
      "end": 175.88,
      "text": "どこで何を組み込むかという話を、"
    },
    {
      "id": "SEG_0059",
      "start": 175.88,
      "end": 180.83,
      "text": "知って知っとさせていただきます"
    },
    {
      "id": "SEG_0060",
      "start": 180.83,
      "end": 183.83,
      "text": "じゃあみにも、もし上がったとしたら、"
    },
    {
      "id": "SEG_0061",
      "start": 183.83,
      "end": 186.83,
      "text": "なぜ、受けた明日かんばんつめた話をつって"
    },
    {
      "id": "SEG_0062",
      "start": 186.83,
      "end": 189.83,
      "text": "どんな違いがあったと思いますか?"
    },
    {
      "id": "SEG_0063",
      "start": 189.83,
      "end": 192.83,
      "text": "あと、バクゼントしてたので、"
    },
    {
      "id": "SEG_0064",
      "start": 192.83,
      "end": 195.83,
      "text": "何をどう?"
    },
    {
      "id": "SEG_0065",
      "start": 195.83,
      "end": 198.83,
      "text": "何を使って何をどうすべきかというのが"
    },
    {
      "id": "SEG_0066",
      "start": 198.83,
      "end": 201.83,
      "text": "本当にかくバクゼントしていたというところから"
    },
    {
      "id": "SEG_0067",
      "start": 201.83,
      "end": 208.83,
      "text": "と、よりと自分の中では少し具体的になった部分もあるので、"
    },
    {
      "id": "SEG_0068",
      "start": 208.83,
      "end": 214.83,
      "text": "その伝えるものも嫌いでちょっと作ろうかなと思っておりますけど、"
    },
    {
      "id": "SEG_0069",
      "start": 214.83,
      "end": 220.83,
      "text": "と、今までの伝われるからだけをして、"
    },
    {
      "id": "SEG_0070",
      "start": 220.83,
      "end": 224.83,
      "text": "すればより活用していたいと思っています。"
    },
    {
      "id": "SEG_0071",
      "start": 224.83,
      "end": 230.15,
      "text": "この年で感動とか 興奮とかっていう"
    },
    {
      "id": "SEG_0072",
      "start": 230.15,
      "end": 232.91,
      "text": "日々をするっていういくものなんですけど"
    },
    {
      "id": "SEG_0073",
      "start": 232.91,
      "end": 236.77,
      "text": "今日は本当に感動しましたし"
    },
    {
      "id": "SEG_0074",
      "start": 236.77,
      "end": 239.65,
      "text": "そんな一年にありました"
    },
    {
      "id": "SEG_0075",
      "start": 239.65,
      "end": 240.85,
      "text": "本当に感謝してます"
    },
    {
      "id": "SEG_0076",
      "start": 240.85,
      "end": 241.85,
      "text": "ありがとうございます"
    },
    {
      "id": "SEG_0077",
      "start": 241.85,
      "end": 242.85,
      "text": "ありがとうございます"
    },
    {
      "id": "SEG_0078",
      "start": 242.85,
      "end": 246.39,
      "text": "簡単としすぎていて 感動をする"
    },
    {
      "id": "SEG_0079",
      "start": 246.39,
      "end": 247.65,
      "text": "簡単な意見がある"
    },
    {
      "id": "SEG_0080",
      "start": 247.65,
      "end": 249.61,
      "text": "この言葉で言うと"
    },
    {
      "id": "SEG_0081",
      "start": 249.61,
      "end": 251.11,
      "text": "どんな感動がすると"
    },
    {
      "id": "SEG_0082",
      "start": 251.11,
      "end": 253.11,
      "text": "です"
    },
    {
      "id": "SEG_0083",
      "start": 253.11,
      "end": 256.11,
      "text": "みんなにお伝えたい"
    },
    {
      "id": "SEG_0084",
      "start": 256.11,
      "end": 261.11,
      "text": "ステルが知らないかで大きくかある世界だと思ってるので"
    },
    {
      "id": "SEG_0085",
      "start": 261.11,
      "end": 265.11,
      "text": "一人で多くの方に"
    },
    {
      "id": "SEG_0086",
      "start": 265.11,
      "end": 268.11,
      "text": "触れてもらいたいししてもらいたいな"
    },
    {
      "id": "SEG_0087",
      "start": 268.11,
      "end": 271.11,
      "text": "僕が言う話がちょっと思いました"
    },
    {
      "id": "SEG_0088",
      "start": 271.11,
      "end": 273.11,
      "text": "そう思いました"
    },
    {
      "id": "SEG_0089",
      "start": 273.11,
      "end": 275.11,
      "text": "じゃあ最後に一つも"
    },
    {
      "id": "SEG_0090",
      "start": 275.11,
      "end": 277.11,
      "text": "最後のとりなんですけど"
    },
    {
      "id": "SEG_0091",
      "start": 277.11,
      "end": 278.11,
      "text": "今日って"
    },
    {
      "id": "SEG_0092",
      "start": 278.11,
      "end": 282.11,
      "text": "この映画の使い方だけではない話も多かったと思いますが、"
    },
    {
      "id": "SEG_0093",
      "start": 282.11,
      "end": 286.11,
      "text": "その後に来て、ママさんとしてはどうでしたか?"
    },
    {
      "id": "SEG_0094",
      "start": 286.11,
      "end": 288.11,
      "text": "いらなかったなぁ、"
    },
    {
      "id": "SEG_0095",
      "start": 288.11,
      "end": 293.11,
      "text": "考え直す、きっかけなかったのか。"
    },
    {
      "id": "SEG_0096",
      "start": 293.11,
      "end": 297.11,
      "text": "もう本当に高者で、ポンテキティとかも、"
    },
    {
      "id": "SEG_0097",
      "start": 297.11,
      "end": 298.11,
      "text": "コンポンテキに、"
    },
    {
      "id": "SEG_0098",
      "start": 298.11,
      "end": 302.11,
      "text": "やりがない世界的な、"
    },
    {
      "id": "SEG_0099",
      "start": 302.11,
      "end": 306.11,
      "text": "考えにくいっても、お絵がある全てで、"
    },
    {
      "id": "SEG_0100",
      "start": 306.11,
      "end": 308.11,
      "text": "まぁ、経営になり、"
    },
    {
      "id": "SEG_0101",
      "start": 308.11,
      "end": 310.11,
      "text": "まあ、会社の、"
    },
    {
      "id": "SEG_0102",
      "start": 310.11,
      "end": 312.11,
      "text": "ていけると、勝ちがあったり、"
    },
    {
      "id": "SEG_0103",
      "start": 312.11,
      "end": 314.11,
      "text": "買ってのは、"
    },
    {
      "id": "SEG_0104",
      "start": 314.11,
      "end": 316.11,
      "text": "新たなりってちょっと考えなきゃな、"
    },
    {
      "id": "SEG_0105",
      "start": 316.11,
      "end": 318.11,
      "text": "とりあえずに思わされた、"
    },
    {
      "id": "SEG_0106",
      "start": 318.11,
      "end": 320.11,
      "text": "そんな時間でした。"
    },
    {
      "id": "SEG_0107",
      "start": 320.11,
      "end": 322.11,
      "text": "ありがとうございます。"
    },
    {
      "id": "SEG_0108",
      "start": 322.11,
      "end": 323.11,
      "text": "ありがとうございます。"
    },
    {
      "id": "SEG_0109",
      "start": 323.11,
      "end": 324.11,
      "text": "ありがとうございます。"
    },
    {
      "id": "SEG_0110",
      "start": 324.11,
      "end": 326.11,
      "text": "すいです。"
    },
    {
      "id": "SEG_0111",
      "start": 326.11,
      "end": 327.11,
      "text": "この前です。"
    },
    {
      "id": "SEG_0112",
      "start": 327.11,
      "end": 328.11,
      "text": "なりかえたのは、"
    },
    {
      "id": "SEG_0113",
      "start": 328.11,
      "end": 330.11,
      "text": "めちゃくちゃいいなのに。"
    }
  ]
}