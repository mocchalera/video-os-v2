      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 0,
      "end_us": 20040000,
      "text": "音楽"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0002",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 19500000,
      "end_us": 39540000,
      "text": "作詞・作曲・編曲 初音ミク"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0003",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 39000000,
      "end_us": 43000000,
      "text": "君の靴音 一つ分"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0004",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 45000000,
      "end_us": 49000000,
      "text": "朝靄の向こう 白い叩き"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0005",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 50000000,
      "end_us": 54000000,
      "text": "呼ばれたような風が吹く"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0006",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 56000000,
      "end_us": 58980000,
      "text": "言えないことを抱えて"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0007",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 58500000,
      "end_us": 78480000,
      "text": "描いたまま 土の匂いに紛れてく"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0008",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 78000000,
      "end_us": 83000000,
      "text": "小さな影をつれながら"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0009",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 83000000,
      "end_us": 88000000,
      "text": "坂はゆっくり続いてる"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0010",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 88000000,
      "end_us": 94000000,
      "text": "怖さはきっと消えないまま"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0011",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 94000000,
      "end_us": 98040000,
      "text": "それでも空は"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0012",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 97500000,
      "end_us": 101500000,
      "text": "解けてく"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0013",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 101500000,
      "end_us": 107500000,
      "text": "泣いた後の空の色"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0014",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 107500000,
      "end_us": 112500000,
      "text": "身のもに滲む光"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0015",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 112500000,
      "end_us": 117480000,
      "text": "遠い世界に触れる度"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0016",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 117000000,
      "end_us": 136940000,
      "text": "ご視聴ありがとうございました"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0017",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 136500000,
      "end_us": 141880000,
      "text": "登って行け 麓から衝動のまま深く深くなれ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0018",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 141880000,
      "end_us": 147400000,
      "text": "峠の向こうで待つ者はまだ誰の思うでもない空"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0019",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 156000000,
      "end_us": 175980000,
      "text": "ご視聴ありがとうございました"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0020",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 175500000,
      "end_us": 178840000,
      "text": "この先へ行きたくなる"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0021",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 181100000,
      "end_us": 184100000,
      "text": "転んだ膝の痛みより"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0022",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 184100000,
      "end_us": 186760000,
      "text": "峠の向こうが気になってる"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0023",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 186760000,
      "end_us": 189760000,
      "text": "こぼした声もそのままで"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0024",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 189760000,
      "end_us": 192520000,
      "text": "君は斜面を越えていく"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0025",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 192520000,
      "end_us": 195480000,
      "text": "大きな山を越えなくていいさ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0026",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 195000000,
      "end_us": 197760000,
      "text": "最初はただのサーカーで"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0027",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 197760000,
      "end_us": 200680000,
      "text": "雪どけみたいに一歩ずつ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0028",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 200680000,
      "end_us": 204220000,
      "text": "知りたい方へ続いてく"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0029",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 204220000,
      "end_us": 206940000,
      "text": "昇ってゆけ風の中"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0030",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 206940000,
      "end_us": 209520000,
      "text": "まだ柔らかな朝の方へ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0031",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 209520000,
      "end_us": 211400000,
      "text": "高くなる夜をドゥ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0032",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 211400000,
      "end_us": 215040000,
      "text": "広くなれ君の光を滲ませ"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0033",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 214500000,
      "end_us": 234540000,
      "text": "ご視聴ありがとうございました"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0034",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 234000000,
      "end_us": 240960000,
      "text": "雪解け水が鳴っている"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0035",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 240960000,
      "end_us": 246680000,
      "text": "白い叩き黙っている"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0036",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 246680000,
      "end_us": 251060000,
      "text": "始まりはいつも"
    },
    {
      "item_id": "TRI_AST_2F5B86AF_0037",
      "speaker": "S1",
      "speaker_key": "AST_2F5B86AF:speaker_1",
      "start_us": 251060000,
      "end_us": 252600000,
      "text": "麓から"
    }
  ],
