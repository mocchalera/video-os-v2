{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/bgm-technical-shortlist.schema.json",
  "title": "Video OS BGM Technical Shortlist",
  "description": "Technical preselection of generated BGM candidates. This artifact never represents musical or rights approval.",
  "type": "object",
  "required": ["version", "created_at", "candidate_count", "method", "tracks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "technical-shortlist/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "method": {
      "type": "object",
      "required": ["duration", "tempo", "warning"],
      "additionalProperties": false,
      "properties": {
        "duration": { "type": "string", "minLength": 1 },
        "tempo": { "type": "string", "minLength": 1 },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/trackShortlist" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeFilename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?!.*[/\\\\])[^\\u0000-\\u001F\\u007F]+$"
    },
    "candidate": {
      "type": "object",
      "required": [
        "batch", "filename", "duration_sec", "measured_bpm",
        "normalized_bpm", "technical_score", "sha256", "suno_comment"
      ],
      "additionalProperties": false,
      "properties": {
        "batch": { "type": "integer", "minimum": 1 },
        "filename": { "$ref": "#/$defs/safeFilename" },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "measured_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "normalized_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "technical_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "suno_comment": { "type": "string", "minLength": 1 }
      }
    },
    "trackShortlist": {
      "type": "object",
      "required": ["working_title", "target_bpm", "target_duration_sec", "shortlist", "note"],
      "additionalProperties": false,
      "properties": {
        "working_title": { "type": "string", "minLength": 1 },
        "target_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "target_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "shortlist": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
