{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/package-qa-report.schema.json",
  "title": "Video OS Package QA Report",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "source_of_truth",
    "qa_profile",
    "passed",
    "checks"
  ],
  "properties": {
    "version": { "type": "string" },
    "project_id": { "type": "string" },
    "source_of_truth": {
      "type": "string",
      "enum": ["engine_render", "nle_finishing"]
    },
    "qa_profile": {
      "type": "string",
      "enum": ["engine_render", "nle_finishing"]
    },
    "passed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/qaCheck" }
    },
    "metrics": { "$ref": "#/$defs/qaMetrics" },
    "artifacts": {
      "type": "object",
      "properties": {
        "final_video": { "type": "string" },
        "final_mix": { "type": "string" },
        "audio_mix_report": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source_inputs_freshness": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["fresh", "stale"] },
        "reason": { "type": "string" },
        "source_inputs_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attestation_status": {
          "type": "string",
          "enum": ["verified", "live_only", "not_applicable"]
        },
        "warnings": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "qaCheck": {
      "type": "object",
      "required": ["name", "passed", "details"],
      "properties": {
        "name": { "type": "string" },
        "passed": { "type": "boolean" },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "qaMetrics": {
      "type": "object",
      "properties": {
        "caption_max_density": { "type": "number" },
        "dialogue_occupancy_ratio": { "type": "number" },
        "dialogue_outside_expected_ms": { "type": "number", "minimum": 0 },
        "dialogue_first_signal_ms": { "type": "number", "minimum": 0 },
        "dialogue_last_signal_ms": { "type": "number", "minimum": 0 },
        "expected_dialogue_start_ms": { "type": "number", "minimum": 0 },
        "expected_dialogue_end_ms": { "type": "number", "minimum": 0 },
        "av_duration_delta_ms": { "type": "number", "minimum": 0 },
        "av_drift_ms": { "type": "number" },
        "integrated_lufs": { "type": "number" },
        "true_peak_dbtp": { "type": "number" },
        "resolution_check": {
          "type": "string",
          "enum": ["passed", "failed", "skipped", "blocked"]
        },
        "actual_video_frame": { "$ref": "#/$defs/videoFrame" },
        "expected_video_frame": { "$ref": "#/$defs/expectedVideoFrame" },
        "resolution_mismatches": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "videoFrame": {
      "type": "object",
      "required": ["width", "height", "sar", "dar", "fps_num", "fps_den", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sar": { "type": ["string", "null"] },
        "dar": { "type": ["string", "null"] },
        "fps_num": { "type": ["integer", "null"], "minimum": 1 },
        "fps_den": { "type": ["integer", "null"], "minimum": 1 },
        "fps": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "expectedVideoFrame": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["package_settings", "timeline", "creative_brief"]
        },
        "source_detail": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sar": { "type": ["string", "null"] },
        "dar": { "type": ["string", "null"] },
        "fps_num": { "type": ["integer", "null"], "minimum": 1 },
        "fps_den": { "type": ["integer", "null"], "minimum": 1 },
        "fps": { "type": ["number", "null"] },
        "aspect_ratio": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
