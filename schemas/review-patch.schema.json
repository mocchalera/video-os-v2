{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/review-patch.schema.json",
  "title": "Review Patch Operations",
  "type": "object",
  "required": [
    "timeline_version",
    "operations"
  ],
  "properties": {
    "patch_version": {
      "const": "review-patch/v2"
    },
    "timeline_version": {
      "type": "string"
    },
    "base_timeline_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected"]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "reason"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "replace_segment",
              "trim_segment",
              "move_segment",
              "split_segment",
              "set_transition",
              "insert_segment",
              "remove_segment",
              "change_audio_policy",
              "change_visual_transform",
              "change_audio_finish",
              "add_overlay",
              "update_overlay",
              "remove_overlay",
              "add_marker",
              "add_note"
            ]
          },
          "target_clip_id": {
            "type": "string"
          },
          "with_segment_id": {
            "type": "string"
          },
          "new_src_in_us": {
            "type": "integer",
            "minimum": 0
          },
          "new_src_out_us": {
            "type": "integer",
            "minimum": 0
          },
          "new_timeline_in_frame": {
            "type": "integer",
            "minimum": 0
          },
          "new_duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "target_track_id": {
            "type": "string",
            "minLength": 1
          },
          "from_clip_id": {
            "type": "string"
          },
          "to_clip_id": {
            "type": "string"
          },
          "track_id": {
            "type": "string"
          },
          "transition_type": {
            "type": "string",
            "minLength": 1
          },
          "transition_frames": {
            "type": "integer",
            "minimum": 1
          },
          "transition_params": {
            "type": "object"
          },
          "applied_skill_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio_policy": {
            "type": "object",
            "properties": {
              "gain_unit": { "type": "string", "enum": ["linear", "db"] },
              "duck_music_db": { "type": "number" },
              "nat_gain": { "type": "number" },
              "nat_sound_gain": { "type": "number" },
              "bgm_gain": { "type": "number" },
              "preserve_nat_sound": { "type": "boolean" },
              "fade_in_frames": { "type": "integer", "minimum": 0 },
              "fade_out_frames": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "visual_transform": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "zoom": { "type": "number", "minimum": 0.1, "maximum": 8 },
              "crop": {
                "type": "object",
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "number", "minimum": 0 },
                  "y": { "type": "number", "minimum": 0 },
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              },
              "position": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "audio_finish": {
            "type": "object",
            "required": ["preset"],
            "properties": {
              "preset": { "type": "string", "enum": ["dialogue-clean", "loudness-only", "none"] },
              "loudness_target_lufs": { "type": "number", "minimum": -24, "maximum": -8 },
              "lra_target": { "type": "number", "minimum": 1, "maximum": 20 },
              "true_peak_target_dbtp": { "type": "number", "minimum": -6, "maximum": -0.1 },
              "codec_headroom_db": { "type": "number", "minimum": 0, "maximum": 3 },
              "highpass_hz": { "type": "number", "minimum": 20, "maximum": 300 },
              "lowpass_hz": { "type": "number", "minimum": 5000, "maximum": 22000 },
              "noise_reduction_db": { "type": "number", "minimum": 0, "maximum": 30 },
              "noise_floor_db": { "type": "number", "minimum": -80, "maximum": -20 },
              "mud_cut_db": { "type": "number", "minimum": -12, "maximum": 0 },
              "presence_gain_db": { "type": "number", "minimum": 0, "maximum": 8 },
              "compressor_threshold_db": { "type": "number", "minimum": -60, "maximum": -1 },
              "compressor_ratio": { "type": "number", "minimum": 1, "maximum": 12 },
              "compressor_attack_ms": { "type": "number", "minimum": 0.1, "maximum": 500 },
              "compressor_release_ms": { "type": "number", "minimum": 10, "maximum": 3000 },
              "compressor_makeup_db": { "type": "number", "minimum": 0, "maximum": 18 }
            },
            "additionalProperties": false
          },
          "beat_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["hero", "support", "transition", "texture", "dialogue", "music", "title"]
          },
          "label": {
            "type": "string"
          },
          "with_candidate_ref": {
            "type": "string"
          },
          "ripple": {
            "type": "boolean"
          },
          "overlay": {
            "type": "object",
            "required": ["clip_id", "timeline_in_frame", "timeline_duration_frames", "content_element"],
            "properties": {
              "clip_id": { "type": "string", "minLength": 1 },
              "timeline_in_frame": { "type": "integer", "minimum": 0 },
              "timeline_duration_frames": { "type": "integer", "minimum": 1 },
              "beat_id": { "type": "string" },
              "track_id": { "type": "string", "minLength": 1 },
              "content_element": { "$ref": "#/$defs/contentElement" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["patch_version"] },
      "then": { "required": ["base_timeline_sha256", "status"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "contentElement": {
      "type": "object",
      "required": ["version", "element_id", "kind", "props", "layout"],
      "properties": {
        "version": { "const": "content-element/v1" },
        "element_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "kind": { "enum": ["text", "image", "shape", "svg", "template", "group"] },
        "template_ref": { "type": "string", "minLength": 1 },
        "template_version": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "layout": {
          "type": "object",
          "required": ["anchor", "x", "y", "scale", "rotation_deg", "opacity", "safe_area", "z_index"],
          "properties": {
            "anchor": { "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"] },
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "minimum": 0.01, "maximum": 1 },
            "height": { "type": "number", "minimum": 0.01, "maximum": 1 },
            "scale": { "type": "number", "minimum": 0.05, "maximum": 8 },
            "rotation_deg": { "type": "number", "minimum": -360, "maximum": 360 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "safe_area": { "type": "boolean" },
            "z_index": { "type": "integer", "minimum": -1000, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "animation": {
          "type": "object",
          "properties": {
            "in": { "$ref": "#/$defs/animationRef" },
            "loop": { "$ref": "#/$defs/animationRef" },
            "out": { "$ref": "#/$defs/animationRef" }
          },
          "additionalProperties": false
        },
        "renderer_hint": { "enum": ["auto", "ffmpeg", "remotion", "hyperframes"] },
        "creative_recipe": {
          "type": "object",
          "required": ["version", "reuse_scope", "authoring_surface", "layer_mode", "composite_stage", "requires_base_frame"],
          "properties": {
            "version": { "const": "creative-recipe/v1" },
            "reuse_scope": { "enum": ["one_off", "project", "brand", "campaign"] },
            "authoring_surface": { "enum": ["html_motion", "typed_component", "native_filter"] },
            "layer_mode": { "enum": ["alpha_overlay", "full_frame", "native_filter"] },
            "composite_stage": { "enum": ["under_caption", "over_caption"] },
            "requires_base_frame": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "template" } }, "required": ["kind"] },
          "then": { "required": ["template_ref"] }
        }
      ],
      "additionalProperties": false
    },
    "animationRef": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": { "enum": ["none", "fade", "fade-rise", "slide-left", "slide-up"] },
        "duration_frames": { "type": "integer", "minimum": 0 },
        "delay_frames": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
