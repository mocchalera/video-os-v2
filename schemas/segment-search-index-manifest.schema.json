{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/segment-search-index-manifest.schema.json",
  "title": "Video OS Segment Search Index Manifest",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "artifact_version",
    "created_at",
    "index_id",
    "inputs",
    "structure",
    "text_index",
    "vector_shards",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project_id": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "const": "search-index-v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "index_id": { "type": "string", "pattern": "^SIDX_[A-Za-z0-9_-]+$" },
    "inputs": {
      "type": "object",
      "required": [
        "source_media_manifest_hash",
        "assets_hash",
        "segments_hash",
        "transcripts_hashes",
        "audio_story_graph_hash",
        "continuity_graph_hash",
        "editorial_preference_memory_hash",
        "coverage_report_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "source_media_manifest_hash": { "$ref": "#/$defs/sha256" },
        "assets_hash": { "$ref": "#/$defs/sha256" },
        "segments_hash": { "$ref": "#/$defs/sha256" },
        "transcripts_hashes": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "audio_story_graph_hash": { "$ref": "#/$defs/nullable-sha256" },
        "continuity_graph_hash": { "$ref": "#/$defs/nullable-sha256" },
        "editorial_preference_memory_hash": { "$ref": "#/$defs/nullable-sha256" },
        "coverage_report_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/index-field" }
    },
    "text_index": {
      "type": "object",
      "required": ["path", "hash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "vector_shards": {
      "type": "array",
      "items": { "$ref": "#/$defs/vector-shard" }
    },
    "provenance": { "$ref": "#/$defs/artifact-provenance" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullable-sha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "index-field": {
      "type": "object",
      "required": ["field", "source_prefix", "indexed", "tokenizer"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "source_prefix": { "type": "string", "minLength": 1 },
        "indexed": { "type": "boolean" },
        "tokenizer": {
          "type": "string",
          "enum": ["japanese_morpheme", "english_word", "raw_token", "id_only"]
        }
      }
    },
    "vector-shard": {
      "type": "object",
      "required": ["shard_id", "path", "embedding_model_id", "dimension", "hash", "optional"],
      "additionalProperties": false,
      "properties": {
        "shard_id": { "type": "string", "pattern": "^VSHARD_[A-Za-z0-9_-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "embedding_model_id": { "type": "string", "minLength": 1 },
        "dimension": { "type": "integer", "minimum": 0 },
        "hash": { "$ref": "#/$defs/nullable-sha256" },
        "optional": { "type": "boolean" }
      }
    },
    "artifact-ref": {
      "type": "object",
      "required": ["path", "hash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" },
        "required": { "type": "boolean" }
      }
    },
    "hash-policy": {
      "type": "object",
      "required": ["algorithm", "canonicalization", "excluded_fields"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "canonicalization": { "type": "string", "const": "normalized-json-v1" },
        "excluded_fields": {
          "type": "array",
          "contains": { "type": "string", "const": "created_at" },
          "items": { "type": "string" }
        }
      }
    },
    "artifact-provenance": {
      "type": "object",
      "required": ["producer", "inputs", "hash_policy"],
      "additionalProperties": false,
      "properties": {
        "producer": { "type": "string", "enum": ["scripts/rebuild-segment-search-index.ts"] },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact-ref" }
        },
        "hash_policy": { "$ref": "#/$defs/hash-policy" }
      }
    }
  }
}
