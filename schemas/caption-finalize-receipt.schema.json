{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/caption-finalize-receipt.schema.json",
  "title": "Caption Finalize Generation Receipt",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "generation_id",
    "generation_key",
    "approval_sha256",
    "timeline_sha256",
    "created_at",
    "artifacts",
    "verification"
  ],
  "properties": {
    "version": { "enum": ["caption-finalize-receipt/v1", "caption-finalize-receipt/v2", "caption-finalize-receipt/v3", "caption-finalize-receipt/v4", "caption-finalize-receipt/v5"] },
    "project_id": { "type": "string", "minLength": 1 },
    "generation_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "generation_key": { "$ref": "#/$defs/sha256" },
    "approval_sha256": { "$ref": "#/$defs/sha256" },
    "timeline_sha256": { "$ref": "#/$defs/sha256" },
    "final_render_approval_sha256": { "$ref": "#/$defs/sha256" },
    "caption_visual_treatment": {
      "type": "object",
      "required": ["status", "approval_hash", "visual_treatment_patch_hash", "typography_policy_hash", "text_timing_hash", "capability_hash", "resolved_input_hash", "applied_caption_ids", "degraded_reasons", "blocked_reasons"],
      "properties": {
        "status": { "enum": ["ready", "fallback", "human_hold", "blocked"] },
        "approval_hash": { "$ref": "#/$defs/sha256" },
        "visual_treatment_patch_hash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "typography_policy_hash": { "$ref": "#/$defs/sha256" },
        "text_timing_hash": { "$ref": "#/$defs/sha256" },
        "capability_hash": { "$ref": "#/$defs/sha256" },
        "resolved_input_hash": { "$ref": "#/$defs/sha256" },
        "applied_caption_ids": { "type": "array", "items": { "type": "string" } },
        "degraded_reasons": { "type": "array", "items": { "type": "object", "required": ["caption_id", "reason"], "properties": { "caption_id": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } },
        "blocked_reasons": { "type": "array", "items": { "type": "object", "required": ["caption_id", "reason"], "properties": { "caption_id": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "generation_key_inputs": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "lyric_delivery": { "enum": ["present", "absent"] },
    "route_evidence": {
      "type": "object",
      "required": ["route_kind", "render_route_receipt_sha256"],
      "properties": {
        "route_kind": { "enum": ["engine_render", "supplied_final", "external_manual_nle"] },
        "render_route_receipt_sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "lyric_contract": { "$ref": "#/$defs/lyric_contract" },
    "font_contract": {
      "type": "object",
      "required": ["status", "font_id", "family", "fallback_used", "primary", "ass_heavy", "diagnostics"],
      "properties": {
        "status": { "const": "ready" },
        "font_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "selected_family": { "type": "string", "minLength": 1 },
        "selected_asset": { "$ref": "#/$defs/selected_font_asset" },
        "fallback_used": { "const": false },
        "primary": { "$ref": "#/$defs/font_asset" },
        "ass_bold": {
          "allOf": [
            { "$ref": "#/$defs/font_asset" },
            { "type": "object", "required": ["family"], "properties": { "family": { "type": "string", "minLength": 1 } } }
          ]
        },
        "ass_heavy": {
          "allOf": [
            { "$ref": "#/$defs/font_asset" },
            { "type": "object", "required": ["family"], "properties": { "family": { "type": "string", "minLength": 1 } } }
          ]
        },
        "diagnostics": { "type": "array" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "approval_intent",
        "caption_ass",
        "caption_srt",
        "final_video",
        "qa_report",
        "package_manifest",
        "preview",
        "preview_receipt"
      ],
      "properties": {
        "approval_intent": { "$ref": "#/$defs/artifact" },
        "caption_ass": { "$ref": "#/$defs/artifact" },
        "caption_srt": { "$ref": "#/$defs/artifact" },
        "final_video": { "$ref": "#/$defs/video_artifact" },
        "qa_report": { "$ref": "#/$defs/artifact" },
        "package_manifest": { "$ref": "#/$defs/artifact" },
        "preview": { "$ref": "#/$defs/video_artifact" },
        "preview_receipt": { "$ref": "#/$defs/artifact" },
        "font_manifest": { "$ref": "#/$defs/artifact" },
        "font_primary": { "$ref": "#/$defs/artifact" },
        "font_ass_bold": { "$ref": "#/$defs/artifact" },
        "font_ass_heavy": { "$ref": "#/$defs/artifact" },
        "supplied_final_provenance": { "$ref": "#/$defs/artifact" },
        "lyrics_ass": { "$ref": "#/$defs/artifact" },
        "lyric_plan": { "$ref": "#/$defs/artifact" },
        "lyric_script": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["qa_passed", "package_ready", "package_preflight_version", "package_preflight_decision"],
      "properties": {
        "qa_passed": { "const": true },
        "package_ready": { "const": true },
        "package_preflight_version": { "const": "package-preflight/v2" },
        "package_preflight_decision": { "const": "ready_to_run" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": "caption-finalize-receipt/v2" } } },
      "then": {
        "required": ["font_contract"],
        "properties": {
          "font_contract": { "required": ["selected_family", "selected_asset"] },
          "artifacts": { "required": ["font_manifest", "font_primary", "font_ass_heavy"] }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "caption-finalize-receipt/v3" } } },
      "then": {
        "required": ["font_contract"],
        "properties": {
          "font_contract": { "required": ["selected_family", "selected_asset", "ass_bold"] },
          "artifacts": { "required": ["font_manifest", "font_primary", "font_ass_bold", "font_ass_heavy"] }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "caption-finalize-receipt/v4" } } },
      "then": {
        "required": ["font_contract", "final_render_approval_sha256"],
        "properties": {
          "font_contract": { "required": ["selected_family", "selected_asset", "ass_bold"] },
          "artifacts": { "required": ["font_manifest", "font_primary", "font_ass_bold", "font_ass_heavy"] }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "caption-finalize-receipt/v5" } } },
      "then": {
        "required": ["font_contract", "final_render_approval_sha256", "lyric_delivery", "generation_key_inputs", "route_evidence"],
        "properties": {
          "font_contract": { "required": ["selected_family", "selected_asset", "ass_bold"] },
          "artifacts": { "required": ["font_manifest", "font_primary", "font_ass_bold", "font_ass_heavy"] }
        }
      }
    },
    {
      "if": { "properties": { "lyric_delivery": { "const": "present" } }, "required": ["lyric_delivery"] },
      "then": { "required": ["lyric_contract"] }
    },
    {
      "if": { "properties": { "lyric_delivery": { "const": "absent" } }, "required": ["lyric_delivery"] },
      "then": {
        "properties": {
          "lyric_contract": false,
          "artifacts": { "not": { "anyOf": [
            { "required": ["lyrics_ass"] },
            { "required": ["lyric_plan"] },
            { "required": ["lyric_script"] }
          ] } }
        }
      }
    },
    {
      "if": {
        "required": ["lyric_contract"],
        "properties": { "lyric_contract": {
          "type": "object",
          "required": ["source_kind"],
          "properties": { "source_kind": { "const": "authored_caption_approval" } }
        } }
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": ["lyrics_ass", "lyric_plan"],
            "not": { "required": ["lyric_script"] }
          }
        }
      }
    },
    {
      "if": {
        "required": ["lyric_contract"],
        "properties": { "lyric_contract": { "type": "object" } },
        "not": { "properties": { "lyric_contract": {
          "required": ["source_kind"],
          "properties": { "source_kind": { "const": "authored_caption_approval" } }
        } } }
      },
      "then": {
        "properties": {
          "artifacts": { "required": ["lyrics_ass", "lyric_plan", "lyric_script"] }
        }
      }
    },
    {
      "if": { "required": ["artifacts"], "properties": { "artifacts": { "required": ["lyrics_ass"] } } },
      "then": { "required": ["lyric_contract"] }
    },
    {
      "if": { "required": ["artifacts"], "properties": { "artifacts": { "required": ["lyric_plan"] } } },
      "then": { "required": ["lyric_contract"] }
    },
    {
      "if": { "required": ["artifacts"], "properties": { "artifacts": { "required": ["lyric_script"] } } },
      "then": { "required": ["lyric_contract"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "lyric_contract": {
            "type": "object",
      "required": ["canonical_options", "options_digest", "reduced_motion", "tail_sec", "max_per_char_sec", "max_hold_sec", "faces"],
      "properties": {
        "source_kind": { "enum": ["lrc_script", "authored_caption_approval"] },
        "script_sha256": { "$ref": "#/$defs/sha256" },
        "authority": { "$ref": "#/$defs/lyric_authority" },
        "canonical_options": {
          "type": "object",
          "required": ["reducedMotion", "sections", "staccatoMaxHoldSec", "staccatoMaxPerCharSec", "tailSec", "videoDurationSec", "positioning"],
          "properties": {
            "reducedMotion": { "type": "boolean" },
            "sections": { "type": "array" },
            "staccatoMaxHoldSec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "staccatoMaxPerCharSec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "tailSec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "videoDurationSec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
            "positioning": { "enum": ["poster_boundary_cross", "bottom_center"] }
          },
          "additionalProperties": false
        },
        "options_digest": { "$ref": "#/$defs/sha256" },
        "reduced_motion": { "type": "boolean" },
        "tail_sec": { "type": "number", "exclusiveMinimum": 0 },
        "max_per_char_sec": { "type": "number", "exclusiveMinimum": 0 },
        "max_hold_sec": { "type": "number", "exclusiveMinimum": 0 },
        "video_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "faces": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "family", "postscript_name", "face_index", "font_path", "font_sha256"],
            "properties": {
              "role": { "enum": ["verse", "chorus", "punk"] },
              "family": { "type": "string", "minLength": 1 },
              "postscript_name": { "type": "string" },
              "face_index": { "type": "integer", "minimum": -1 },
              "font_path": { "type": "string" },
              "font_sha256": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "source_kind": { "const": "authored_caption_approval" } }, "required": ["source_kind"] },
          "then": {
            "required": ["authority"],
            "properties": { "script_sha256": false }
          }
        },
        {
          "if": { "not": { "properties": { "source_kind": { "const": "authored_caption_approval" } }, "required": ["source_kind"] } },
          "then": { "required": ["script_sha256"] }
        }
      ]
    },
    "lyric_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "approval_sha256", "timeline_sha256", "text_authority_sha256", "timing_authority_sha256"],
      "properties": {
        "kind": { "const": "authored_caption_approval" },
        "approval_sha256": { "$ref": "#/$defs/sha256" },
        "timeline_sha256": { "$ref": "#/$defs/sha256" },
        "text_authority_sha256": { "$ref": "#/$defs/sha256" },
        "timing_authority_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "font_asset": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "family": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "selected_font_asset": {
      "type": "object",
      "required": ["role", "family", "path", "sha256", "weight"],
      "properties": {
        "role": { "enum": ["primary", "ass_bold", "ass_heavy"] },
        "family": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 }
      },
      "additionalProperties": false
    },
    "video_artifact": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "mtime_ms"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mtime_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
