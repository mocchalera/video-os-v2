{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-os.dev/schemas/public-projection-receipt.schema.json",
  "title": "Stage A Public Projection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "policy",
    "policy_ledger",
    "public_path_ledger",
    "public_path_ledger_sha256",
    "public_payload_sha256",
    "secret_scan"
  ],
  "properties": {
    "version": { "const": "public-projection-receipt/v1" },
    "source": { "$ref": "#/$defs/source" },
    "policy": { "$ref": "#/$defs/policy" },
    "policy_ledger": {
      "type": "array",
      "items": { "$ref": "#/$defs/policyLedgerEntry" }
    },
    "public_path_ledger": {
      "type": "array",
      "items": { "$ref": "#/$defs/publicPathEntry" }
    },
    "public_path_ledger_sha256": { "$ref": "#/$defs/sha256" },
    "public_payload_sha256": { "$ref": "#/$defs/sha256" },
    "secret_scan": { "$ref": "#/$defs/secretScan" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "base64": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity_sha256",
        "commit_sha",
        "tree_sha",
        "dirty"
      ],
      "properties": {
        "repository_identity_sha256": { "$ref": "#/$defs/sha256" },
        "commit_sha": { "$ref": "#/$defs/gitObjectId" },
        "tree_sha": { "$ref": "#/$defs/gitObjectId" },
        "dirty": { "const": false }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "verifier_version"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "verifier_version": { "const": "public-projection-verifier/v1" }
      }
    },
    "policyLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_b64",
        "path",
        "source_type",
        "source_mode",
        "source_sha256",
        "decision",
        "reason",
        "transform_id",
        "public_sha256"
      ],
      "properties": {
        "path_b64": { "$ref": "#/$defs/base64" },
        "path": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["regular_file", "symlink"] },
        "source_mode": { "enum": ["100644", "100755", "120000"] },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["include", "exclude", "transform"] },
        "reason": { "type": ["string", "null"] },
        "transform_id": { "type": ["string", "null"] },
        "public_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "publicPathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_b64",
        "path",
        "type",
        "mode",
        "sha256",
        "source"
      ],
      "properties": {
        "path_b64": { "$ref": "#/$defs/base64" },
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["regular_file", "symlink"] },
        "mode": { "enum": ["100644", "100755", "120000"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "target_b64": { "$ref": "#/$defs/base64" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_b64", "transform_id"],
          "properties": {
            "path_b64": { "$ref": "#/$defs/base64" },
            "transform_id": { "type": ["string", "null"] }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "symlink" } },
            "required": ["type"]
          },
          "then": {
            "required": ["target_b64"],
            "properties": { "mode": { "const": "120000" } }
          },
          "else": {
            "not": { "required": ["target_b64"] },
            "properties": { "mode": { "enum": ["100644", "100755"] } }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "producer", "scanner", "target_payload_sha256", "result"],
      "properties": {
        "version": { "const": "public-projection-scan-attestation/v1" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer_id",
            "wrapper_version",
            "wrapper_sha256",
            "verifier_sha256",
            "key_id"
          ],
          "properties": {
            "producer_id": { "type": "string", "minLength": 1 },
            "wrapper_version": { "type": "string", "minLength": 1 },
            "wrapper_sha256": { "$ref": "#/$defs/sha256" },
            "verifier_sha256": { "$ref": "#/$defs/sha256" },
            "key_id": { "type": "string", "minLength": 1 }
          }
        },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "binary_sha256", "rules_sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "binary_sha256": { "$ref": "#/$defs/sha256" },
            "rules_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "target_payload_sha256": { "$ref": "#/$defs/sha256" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exit_code", "finding_count"],
          "properties": {
            "status": { "const": "clean" },
            "exit_code": { "const": 0 },
            "finding_count": { "const": 0 }
          }
        }
      }
    },
    "detachedSignatureVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "verifier_id", "producer_id", "key_id"],
      "properties": {
        "mechanism": { "const": "detached-signature" },
        "verifier_id": { "type": "string", "minLength": 1 },
        "producer_id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 }
      }
    },
    "wrapperExecutionReceiptVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "verifier_id", "producer_id", "key_id"],
      "properties": {
        "mechanism": { "const": "approved-wrapper-execution-receipt" },
        "verifier_id": { "type": "string", "minLength": 1 },
        "producer_id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 }
      }
    },
    "secretScan": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attestation",
            "attestation_sha256",
            "detached_signature_b64",
            "verification"
          ],
          "properties": {
            "attestation": { "$ref": "#/$defs/attestation" },
            "attestation_sha256": { "$ref": "#/$defs/sha256" },
            "detached_signature_b64": { "$ref": "#/$defs/base64" },
            "verification": { "$ref": "#/$defs/detachedSignatureVerification" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attestation",
            "attestation_sha256",
            "approved_wrapper_execution_receipt_b64",
            "verification"
          ],
          "properties": {
            "attestation": { "$ref": "#/$defs/attestation" },
            "attestation_sha256": { "$ref": "#/$defs/sha256" },
            "approved_wrapper_execution_receipt_b64": { "$ref": "#/$defs/base64" },
            "verification": { "$ref": "#/$defs/wrapperExecutionReceiptVerification" }
          }
        }
      ]
    }
  }
}
