{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/sound-design-request.schema.json",
  "title": "Video OS Sound Design Request",
  "description": "Raw semantic, congestion, beat and pinned SFX evidence for deterministic short-form sound design.",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "base_timeline_version",
    "timeline_fps",
    "timeline_duration_frames",
    "timeline_ref",
    "library",
    "candidates",
    "dialogue_windows",
    "congestion_events",
    "beat_evidence",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "sound-design-request/v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "base_timeline_version": { "type": "string", "minLength": 1 },
    "timeline_fps": { "$ref": "#/$defs/rationalFps" },
    "timeline_duration_frames": { "type": "integer", "minimum": 1 },
    "timeline_ref": { "$ref": "#/$defs/filePin" },
    "library": { "$ref": "#/$defs/libraryPin" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "dialogue_windows": {
      "type": "array",
      "items": { "$ref": "#/$defs/dialogueWindow" }
    },
    "congestion_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/congestionEvent" }
    },
    "beat_evidence": { "$ref": "#/$defs/beatEvidence" },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "opaqueRef": {
      "type": "string",
      "pattern": "^(?:evidence|rights|provenance|source|local|urn|timeline|transcript|music-cue|overlay|caption):[A-Za-z0-9][A-Za-z0-9._~:/-]*$"
    },
    "rationalFps": {
      "type": "object",
      "required": ["num", "den"],
      "additionalProperties": false,
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "filePin": {
      "type": "object",
      "required": ["path", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "libraryPin": {
      "type": "object",
      "required": [
        "manifest_path",
        "library_id",
        "library_version",
        "manifest_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_path": { "type": "string", "minLength": 1 },
        "library_id": { "$ref": "#/$defs/stableId" },
        "library_version": { "type": "string", "minLength": 1 },
        "manifest_hash": { "$ref": "#/$defs/hash" },
        "scope": { "enum": ["repo_common", "project_local"] }
      }
    },
    "semanticRole": {
      "type": "string",
      "enum": [
        "hook_impact",
        "transition_accent",
        "claim_emphasis",
        "achievement_reveal",
        "simple_sound"
      ]
    },
    "assetPin": {
      "type": "object",
      "required": [
        "library_id",
        "library_version",
        "library_manifest_hash",
        "asset_content_hash",
        "asset_size_bytes",
        "rights_evidence_ref",
        "provenance_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "library_id": { "$ref": "#/$defs/stableId" },
        "library_version": { "type": "string", "minLength": 1 },
        "library_manifest_hash": { "$ref": "#/$defs/hash" },
        "asset_content_hash": { "$ref": "#/$defs/hash" },
        "asset_size_bytes": { "type": "integer", "minimum": 1 },
        "rights_evidence_ref": { "$ref": "#/$defs/opaqueRef" },
        "provenance_ref": { "$ref": "#/$defs/opaqueRef" },
        "asset_path": { "type": "string", "minLength": 1 },
        "rights_status": {
          "enum": ["confirmed", "cleared", "unknown", "expired", "ambiguous", "blocked", "hold"]
        },
        "provenance_status": {
          "enum": ["verified", "unknown", "ambiguous", "hold"]
        },
        "review_status": {
          "enum": ["approved", "pending", "rejected", "unreviewed", "hold"]
        },
        "rights_expires_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "permitted_derivatives": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "required": ["in_us", "out_us"],
      "additionalProperties": false,
      "properties": {
        "in_us": { "type": "integer", "minimum": 0 },
        "out_us": { "type": "integer", "minimum": 1 }
      }
    },
    "tail": {
      "type": "object",
      "required": ["max_frames", "policy"],
      "additionalProperties": false,
      "properties": {
        "max_frames": { "type": "integer", "minimum": 0 },
        "policy": { "const": "trim_or_pad_to_limit" }
      }
    },
    "ducking": {
      "type": "object",
      "required": ["duck_gain_db", "attack_ms", "release_ms"],
      "additionalProperties": false,
      "properties": {
        "duck_gain_db": { "type": "number" },
        "attack_ms": { "type": "number", "minimum": 0 },
        "release_ms": { "type": "number", "minimum": 0 }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "semantic_role",
        "semantic_purpose",
        "evidence_refs",
        "semantic_strength",
        "semantic_anchor",
        "asset_id",
        "asset_pin",
        "audio"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "$ref": "#/$defs/stableId" },
        "semantic_role": { "$ref": "#/$defs/semanticRole" },
        "semantic_purpose": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueRef" }
        },
        "semantic_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "semantic_anchor": {
          "type": "object",
          "required": ["label", "frame", "window"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "frame": { "type": "integer", "minimum": 0 },
            "window": {
              "type": "object",
              "required": ["earliest_frame", "latest_frame"],
              "additionalProperties": false,
              "properties": {
                "earliest_frame": { "type": "integer", "minimum": 0 },
                "latest_frame": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "asset_id": { "$ref": "#/$defs/stableId" },
        "asset_pin": { "$ref": "#/$defs/assetPin" },
        "audio": {
          "type": "object",
          "required": [
            "duration_frames",
            "source_range",
            "gain_db",
            "fade_in_ms",
            "fade_out_ms",
            "tail",
            "duck_group",
            "ducking"
          ],
          "additionalProperties": false,
          "properties": {
            "duration_frames": { "type": "integer", "minimum": 1 },
            "source_range": { "$ref": "#/$defs/sourceRange" },
            "gain_db": { "type": "number" },
            "fade_in_ms": { "type": "number", "minimum": 0 },
            "fade_out_ms": { "type": "number", "minimum": 0 },
            "tail": { "$ref": "#/$defs/tail" },
            "duck_group": {
              "type": "string",
              "enum": ["dialogue", "none"]
            },
            "ducking": { "$ref": "#/$defs/ducking" }
          }
        }
      }
    },
    "dialogueWindow": {
      "type": "object",
      "required": ["in_frame", "out_frame", "evidence_ref"],
      "additionalProperties": false,
      "properties": {
        "in_frame": { "type": "integer", "minimum": 0 },
        "out_frame": { "type": "integer", "minimum": 1 },
        "evidence_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "congestionType": {
      "type": "string",
      "enum": [
        "dialogue",
        "music_entry",
        "lower_third",
        "section_label",
        "caption",
        "picture_edit",
        "overlay"
      ]
    },
    "congestionEvent": {
      "type": "object",
      "required": [
        "event_id",
        "type",
        "in_frame",
        "out_frame",
        "severity",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": { "$ref": "#/$defs/stableId" },
        "type": { "$ref": "#/$defs/congestionType" },
        "in_frame": { "type": "integer", "minimum": 0 },
        "out_frame": { "type": "integer", "minimum": 1 },
        "severity": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "beatEvidence": {
      "type": "object",
      "required": [
        "status",
        "analysis_status",
        "analysis_path",
        "content_hash",
        "bpm",
        "confidence",
        "beat_frames",
        "downbeat_frames"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "degraded", "unavailable"]
        },
        "analysis_status": {
          "type": "string",
          "enum": ["ready", "degraded", "failed", "unavailable"]
        },
        "analysis_path": { "type": ["string", "null"], "minLength": 1 },
        "content_hash": {
          "anyOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "bpm": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "beat_frames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "downbeat_frames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "congestionWeights": {
      "type": "object",
      "required": [
        "dialogue",
        "music_entry",
        "lower_third",
        "section_label",
        "caption",
        "picture_edit",
        "overlay"
      ],
      "additionalProperties": false,
      "properties": {
        "dialogue": { "type": "number", "minimum": 0 },
        "music_entry": { "type": "number", "minimum": 0 },
        "lower_third": { "type": "number", "minimum": 0 },
        "section_label": { "type": "number", "minimum": 0 },
        "caption": { "type": "number", "minimum": 0 },
        "picture_edit": { "type": "number", "minimum": 0 },
        "overlay": { "type": "number", "minimum": 0 }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "minimum_spacing_frames",
        "max_cues_per_30_seconds",
        "absolute_max_cues",
        "semantic_accept_threshold",
        "congestion_reject_threshold",
        "minimum_beat_confidence",
        "max_snap_frames",
        "congestion_weights"
      ],
      "additionalProperties": false,
      "properties": {
        "minimum_spacing_frames": { "type": "integer", "minimum": 1 },
        "max_cues_per_30_seconds": { "type": "integer", "minimum": 1 },
        "absolute_max_cues": { "type": "integer", "minimum": 1 },
        "semantic_accept_threshold": { "type": "number" },
        "congestion_reject_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_beat_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_snap_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "congestion_weights": { "$ref": "#/$defs/congestionWeights" }
      }
    }
  }
}
