{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/caption-timing-report.schema.json",
  "title": "Video OS Caption Semantic Timing Report",
  "type": "object",
  "required": [
    "version",
    "mode",
    "checked_caption_count",
    "protected_caption_count",
    "split_count",
    "adjusted_lead_count",
    "unresolved_count",
    "issues"
  ],
  "properties": {
    "version": { "const": "caption-timing-report/v1" },
    "mode": { "enum": ["off", "speech_sync", "protect_reveals"] },
    "checked_caption_count": { "type": "integer", "minimum": 0 },
    "protected_caption_count": { "type": "integer", "minimum": 0 },
    "split_count": { "type": "integer", "minimum": 0 },
    "adjusted_lead_count": { "type": "integer", "minimum": 0 },
    "unresolved_count": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "enum": [
              "premature_caption_lead",
              "unresolved_reveal_anchor",
              "ambiguous_reveal_anchor",
              "reveal_after_caption"
            ]
          },
          "severity": { "enum": ["warn", "block"] },
          "caption_id": { "type": "string", "pattern": "^SC_" },
          "anchor_id": { "type": "string", "minLength": 1 },
          "lead_frames": { "type": "integer", "minimum": 0 },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
