{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-os.local/schemas/editorial-eye-benchmark-suite.schema.json",
  "title": "Editorial Eye Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "suite_id", "version", "baseline_commit", "generator", "contract_provenance", "cases", "gate_policy"],
  "properties": {
    "artifact_version": { "const": "editorial-eye-benchmark-suite/v1" },
    "suite_id": { "const": "editorial-eye-v1" },
    "version": { "const": "1.0.0" },
    "baseline_commit": { "$ref": "#/$defs/commitSha" },
    "generator": { "$ref": "#/$defs/generator" },
    "contract_provenance": { "$ref": "#/$defs/provenance" },
    "cases": { "type": "array", "minItems": 35, "maxItems": 35, "items": { "$ref": "#/$defs/case" } },
    "gate_policy": {
      "type": "object", "additionalProperties": false, "required": ["grounded_visual_success", "human_accuracy"],
      "properties": {
        "grounded_visual_success": {
          "type": "object", "additionalProperties": false, "required": ["gate_id", "blocking"],
          "properties": { "gate_id": { "const": "grounded_visual_success" }, "blocking": { "const": true } }
        },
        "human_accuracy": {
          "type": "object", "additionalProperties": false, "required": ["metric_id", "enforcement", "threshold"],
          "properties": {
            "metric_id": { "enum": ["human_accuracy", "human_f1"] },
            "enforcement": { "enum": ["advisory", "blocking"] },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "approval_record": { "$ref": "#/$defs/approval" }
          },
          "allOf": [{ "if": { "properties": { "enforcement": { "const": "blocking" } }, "required": ["enforcement"] }, "then": { "required": ["approval_record"] } }]
        },
        "reserved_gate_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["source_freshness", "rollback", "preference_isolation"] } }
      }
    }
  },
  "$defs": {
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "fixture_set_id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "fixture_set_id": { "type": "string", "minLength": 1 } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["environment", "models", "degraded"],
      "properties": {
        "environment": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "models": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } } },
        "degraded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["approved_by", "approved_at", "scope", "record_id"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "minLength": 1 },
        "scope": { "const": "human_metric_blocking_threshold" }, "record_id": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "genre", "media_kind", "fixture_id", "evidence_tier", "required_lanes", "genre_intent", "applicability"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "genre": { "enum": ["interview_dialogue", "quiet_documentary", "product_detail", "action_event", "vertical_social_montage", "chronological_longform", "intentional_jump_smash_match"] },
        "media_kind": { "enum": ["video", "audio", "image", "sequence", "mixed"] },
        "fixture_id": { "type": "string", "pattern": "^generated-[a-z]+$" },
        "evidence_tier": { "enum": ["real_generated_pixel_audio", "grounding_contract_only", "unsupported_capability"] },
        "required_lanes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "genre_intent": { "type": "string", "minLength": 1 },
        "applicability": {
          "type": "object", "additionalProperties": false, "required": ["grounded_visual_accuracy", "observation_accuracy", "pair_relation", "human_accuracy"],
          "properties": { "grounded_visual_accuracy": { "type": "boolean" }, "observation_accuracy": { "type": "boolean" }, "pair_relation": { "type": "boolean" }, "human_accuracy": { "type": "boolean" } }
        }
      }
    }
  }
}
