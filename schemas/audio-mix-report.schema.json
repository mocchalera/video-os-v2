{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/audio-mix-report.schema.json",
  "title": "Video OS Audio Mix Report",
  "description": "Backward-compatible audio mix evidence. v2 binds a shared AudioRenderPlan to A1-only finishing, applied A2/A3 cue values, waveform sidechain evidence, and one final mastering pass.",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "measurement": {
      "type": "object",
      "required": ["input_i", "input_tp", "input_lra", "input_thresh", "target_offset"],
      "additionalProperties": false,
      "properties": {
        "input_i": { "type": "string", "minLength": 1 },
        "input_tp": { "type": "string", "minLength": 1 },
        "input_lra": { "type": "string", "minLength": 1 },
        "input_thresh": { "type": "string", "minLength": 1 },
        "target_offset": { "type": "string", "minLength": 1 }
      }
    },
    "mastering": {
      "type": "object",
      "required": [
        "applied",
        "loudness_target_lufs",
        "lra_target",
        "true_peak_target_dbtp",
        "premaster_measurement",
        "output_measurement"
      ],
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "boolean" },
        "loudness_target_lufs": { "type": "number" },
        "lra_target": { "type": "number", "exclusiveMinimum": 0 },
        "true_peak_target_dbtp": { "type": "number" },
        "premaster_measurement": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "output_measurement": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] }
        ,"owner": { "enum": ["shared_audio_render_plan", "legacy_mixer", "unknown"] }
        ,"stage": { "enum": ["after_mix", "not_applied", "legacy_route", "unknown"] }
        ,"applied_processing": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sidechain": {
      "type": "object",
      "required": [
        "detector",
        "threshold",
        "ratio",
        "attack_ms",
        "release_ms",
        "base_gain_db",
        "requested_duck_gain_db"
      ],
      "additionalProperties": false,
      "properties": {
        "detector": { "const": "dialogue_waveform_rms" },
        "threshold": { "type": "number", "exclusiveMinimum": 0 },
        "ratio": { "type": "number", "minimum": 1 },
        "attack_ms": { "type": "number", "minimum": 0 },
        "release_ms": { "type": "number", "minimum": 0 },
        "base_gain_db": { "type": "number" },
        "requested_duck_gain_db": { "type": "number" }
      }
    },
    "musicMasterMvpMeasurement": {
      "type": "object",
      "required": ["raw", "integrated_lufs", "lra_lu", "true_peak_dbtp"],
      "additionalProperties": false,
      "properties": {
        "raw": { "$ref": "#/$defs/measurement" },
        "integrated_lufs": { "type": "number" },
        "lra_lu": { "type": "number" },
        "true_peak_dbtp": { "type": "number" }
      }
    },
    "musicMasterMvpWavEvidence": {
      "type": "object",
      "required": ["path", "content_hash", "size_bytes", "codec", "sample_rate_hz", "channels", "bit_depth", "bit_rate_bps"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "codec": { "const": "pcm_s24le" },
        "sample_rate_hz": { "const": 48000 },
        "channels": { "const": 2 },
        "bit_depth": { "const": 24 },
        "bit_rate_bps": { "type": ["integer", "null"] }
      }
    },
    "musicMasterMvpMp3Evidence": {
      "type": "object",
      "required": ["path", "content_hash", "size_bytes", "codec", "sample_rate_hz", "channels", "bit_depth", "bit_rate_bps"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "codec": { "const": "mp3" },
        "sample_rate_hz": { "const": 48000 },
        "channels": { "const": 2 },
        "bit_depth": { "type": "null" },
        "bit_rate_bps": { "const": 320000 }
      }
    },
    "musicMasterMvpExecutionGraph": {
      "type": "object",
      "required": ["version", "stages", "tone_filter_chain", "pass1_filter", "pass2_filter", "wav_codec", "mp3_codec"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "music-master-mvp-graph/v1" },
        "stages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "enum": ["cleanup", "presence_air", "spatial_glue", "loudnorm_pass1", "loudnorm_pass2", "wav24", "mp3_320"] }
        },
        "tone_filter_chain": { "type": "string", "minLength": 1 },
        "pass1_filter": { "type": "string", "minLength": 1 },
        "pass2_filter": { "type": "string", "minLength": 1 },
        "wav_codec": {
          "type": "object",
          "required": ["codec", "bit_depth", "sample_rate_hz", "channels"],
          "additionalProperties": false,
          "properties": { "codec": { "const": "pcm_s24le" }, "bit_depth": { "const": 24 }, "sample_rate_hz": { "const": 48000 }, "channels": { "const": 2 } }
        },
        "mp3_codec": {
          "type": "object",
          "required": ["codec", "encoder", "bit_rate_bps", "sample_rate_hz", "channels"],
          "additionalProperties": false,
          "properties": { "codec": { "const": "mp3" }, "encoder": { "const": "libmp3lame" }, "bit_rate_bps": { "const": 320000 }, "sample_rate_hz": { "const": 48000 }, "channels": { "const": 2 } }
        }
      }
    },
    "musicMasterMvpReceipt": {
      "type": "object",
      "required": ["version", "plan_hash", "policy_hash", "execution_graph", "pass1", "pass2", "mp3", "deliverables", "human_approval"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "music-master-mvp-receipt/v1" },
        "plan_hash": { "$ref": "#/$defs/hash" },
        "policy_hash": { "$ref": "#/$defs/hash" },
        "execution_graph": { "$ref": "#/$defs/musicMasterMvpExecutionGraph" },
        "pass1": { "$ref": "#/$defs/musicMasterMvpMeasurement" },
        "pass2": { "$ref": "#/$defs/musicMasterMvpMeasurement" },
        "mp3": { "$ref": "#/$defs/musicMasterMvpMeasurement" },
        "deliverables": {
          "type": "object",
          "required": ["wav24", "mp3_320"],
          "additionalProperties": false,
          "properties": {
            "wav24": { "$ref": "#/$defs/musicMasterMvpWavEvidence" },
            "mp3_320": { "$ref": "#/$defs/musicMasterMvpMp3Evidence" }
          }
        },
        "human_approval": {
          "type": "object",
          "required": ["stereo_width", "tonal_balance", "lyric_clarity", "automated_quality_claim"],
          "additionalProperties": false,
          "properties": {
            "stereo_width": { "const": "pending" },
            "tonal_balance": { "const": "pending" },
            "lyric_clarity": { "const": "pending" },
            "automated_quality_claim": { "const": "not_allowed" }
          }
        }
      }
    },
    "musicMasterReceipt": {
      "type": "object",
      "required": ["role", "audio_decision", "source", "input_audio_hash", "output_audio_hash", "source_bytes_preserved", "processing_graph", "codec", "measurements"],
      "additionalProperties": false,
      "properties": {
        "role": { "const": "music_master" },
        "audio_decision": { "enum": ["preserve", "mastering"] },
        "source": {
          "type": "object",
          "required": ["role", "asset_id", "source_ref", "source_content_hash", "source_size_bytes", "source_duration_us", "source_range_us", "timeline_range", "gain_linear", "channel_layout", "codec"],
          "additionalProperties": false,
          "properties": {
            "role": { "const": "music_master" },
            "asset_id": { "type": "string", "minLength": 1 },
            "source_ref": { "type": "string", "minLength": 1 },
            "source_content_hash": { "$ref": "#/$defs/hash" },
            "source_size_bytes": { "type": "integer", "minimum": 1 },
            "source_duration_us": { "type": "integer", "minimum": 1 },
            "source_range_us": { "$ref": "#/$defs/microsecondRange" },
            "timeline_range": { "$ref": "#/$defs/frameRange" },
            "gain_linear": { "const": 1 },
            "channel_layout": { "type": "string", "minLength": 1 },
            "codec": { "type": "string", "minLength": 1 }
          }
        },
        "input_audio_hash": { "$ref": "#/$defs/hash" },
        "output_audio_hash": { "$ref": "#/$defs/hash" },
        "source_bytes_preserved": { "type": "boolean" },
        "processing_graph": {
          "type": "object",
          "required": ["version", "operations"],
          "additionalProperties": false,
          "properties": {
            "version": { "const": "audio-processing-graph/v1" },
            "operations": { "type": "array", "minItems": 1, "items": { "enum": ["stream_copy", "trim_reencode", "shared_final_mastering"] } }
          }
        },
        "codec": {
          "type": "object",
          "required": ["input", "output", "operation"],
          "additionalProperties": false,
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "output": { "type": "string", "minLength": 1 },
            "operation": { "enum": ["stream_copy", "reencode"] }
          }
        },
        "mastering": { "$ref": "#/$defs/musicMasterMvpReceipt" },
        "final_mux": {
          "type": "object",
          "required": ["operation", "codec", "output_audio_hash", "output_container_hash", "measurements"],
          "additionalProperties": false,
          "properties": {
            "operation": { "enum": ["stream_copy", "reencode"] },
            "codec": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "output_audio_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
            "output_container_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
            "measurements": {
              "type": "object",
              "required": ["status", "delta", "tolerance", "reason"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["measured", "degraded", "hold"] },
                "delta": {
                  "type": "object",
                  "required": ["integrated_lufs_db", "lra_lu", "true_peak_dbtp"],
                  "additionalProperties": false,
                  "properties": {
                    "integrated_lufs_db": { "type": ["number", "null"] },
                    "lra_lu": { "type": ["number", "null"] },
                    "true_peak_dbtp": { "type": ["number", "null"] }
                  }
                },
                "tolerance": {
                  "type": "object",
                  "required": ["integrated_lufs_db", "lra_lu", "true_peak_dbtp"],
                  "additionalProperties": false,
                  "properties": {
                    "integrated_lufs_db": { "type": "number", "minimum": 0 },
                    "lra_lu": { "type": "number", "minimum": 0 },
                    "true_peak_dbtp": { "type": "number", "minimum": 0 }
                  }
                },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "measurements": {
          "type": "object",
          "required": ["status", "input", "output", "delta", "tolerance", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["measured", "degraded", "hold"] },
            "input": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
            "output": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
            "delta": {
              "type": "object",
              "required": ["integrated_lufs_db", "lra_lu", "true_peak_dbtp"],
              "additionalProperties": false,
              "properties": {
                "integrated_lufs_db": { "type": ["number", "null"] },
                "lra_lu": { "type": ["number", "null"] },
                "true_peak_dbtp": { "type": ["number", "null"] }
              }
            },
            "tolerance": {
              "type": "object",
              "required": ["integrated_lufs_db", "lra_lu", "true_peak_dbtp"],
              "additionalProperties": false,
              "properties": {
                "integrated_lufs_db": { "type": "number", "minimum": 0 },
                "lra_lu": { "type": "number", "minimum": 0 },
                "true_peak_dbtp": { "type": "number", "minimum": 0 }
              }
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["audio_decision"],
            "properties": { "audio_decision": { "const": "mastering" } }
          },
          "then": { "required": ["mastering"] }
        },
        {
          "if": {
            "required": ["audio_decision"],
            "properties": { "audio_decision": { "const": "preserve" } }
          },
          "then": { "not": { "required": ["mastering"] } }
        }
      ]
    },
    "v1": {
      "type": "object",
      "required": ["version", "has_bgm", "strategy", "final_mastering"],
      "properties": {
        "version": { "const": "audio-mix-report/v1" },
        "has_bgm": { "type": "boolean" },
        "sfx_hold": {
          "type": "object",
          "required": ["code", "reason"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "strategy": {
          "enum": [
            "dialogue_only_mastering_v1",
            "original_passthrough_v1",
            "waveform_sidechain_v1",
            "timeline_embedded_bgm_mastering_v1"
          ]
        },
        "final_mastering": { "type": "object" }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "required": ["sfx_hold"] },
          "then": {
            "properties": { "has_sfx": { "not": { "const": true } } },
            "not": {
              "anyOf": [
                { "required": ["sfx_cues"] },
                { "required": ["sfx_sources"] },
                { "required": ["sfx_sidechain_evidence"] },
                { "required": ["sfx_peak"] }
              ]
            }
          }
        }
      ]
    },
    "v2": {
      "type": "object",
      "required": [
        "version",
        "project_id",
        "plan_hash",
        "has_bgm",
        "strategy",
        "input_hashes",
        "output",
        "stems",
        "cues",
        "dialogue_finish_scope",
        "mastering_count",
        "execution_strategy",
        "final_mastering",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "audio-mix-report/v2" },
        "project_id": { "type": "string", "minLength": 1 },
        "plan_hash": { "$ref": "#/$defs/hash" },
        "has_bgm": { "type": "boolean" },
        "has_sfx": { "type": "boolean" },
        "sfx_hold": {
          "type": "object",
          "required": ["code", "reason"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "strategy": { "const": "shared_audio_render_plan_v1" },
        "input_hashes": {
          "type": "object",
          "required": ["timeline", "dialogue_sources", "cue_sources"],
          "additionalProperties": false,
          "properties": {
            "timeline": { "$ref": "#/$defs/hash" },
            "music_cues": { "$ref": "#/$defs/hash" },
            "sfx_cues": { "$ref": "#/$defs/hash" },
            "sfx_library_manifest": { "$ref": "#/$defs/hash" },
            "sound_design_decision": { "$ref": "#/$defs/hash" },
            "music_master": {
              "type": "object",
              "required": ["asset_id", "content_hash", "size_bytes"],
              "additionalProperties": false,
              "properties": {
                "asset_id": { "type": "string", "minLength": 1 },
                "content_hash": { "$ref": "#/$defs/hash" },
                "size_bytes": { "type": "integer", "minimum": 1 }
              }
            },
            "dialogue_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["clip_id", "content_hash", "size_bytes"],
                "additionalProperties": false,
                "properties": {
                  "clip_id": { "type": "string", "minLength": 1 },
                  "content_hash": { "$ref": "#/$defs/hash" },
                  "size_bytes": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "cue_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "content_hash", "size_bytes"],
                "additionalProperties": false,
                "properties": {
                  "cue_id": { "type": "string", "minLength": 1 },
                  "content_hash": { "$ref": "#/$defs/hash" },
                  "size_bytes": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "sfx_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "content_hash", "size_bytes"],
                "additionalProperties": false,
                "properties": {
                  "cue_id": { "type": "string", "minLength": 1 },
                  "asset_id": { "type": "string", "minLength": 1 },
                  "content_hash": { "$ref": "#/$defs/hash" },
                  "size_bytes": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "required": ["content_hash", "size_bytes", "sample_rate_hz", "channels"],
          "additionalProperties": false,
          "properties": {
            "content_hash": { "$ref": "#/$defs/hash" },
            "size_bytes": { "type": "integer", "minimum": 1 },
            "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
            "channels": { "enum": [1, 2] }
          }
        },
        "encoded_result": { "$ref": "#/$defs/encodedResult" },
        "audio_delivery_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "profile_version", "platform", "surface", "release_scope", "delivery_variant", "path", "source_hash", "profile_hash", "content_hash", "selection_status", "freshness", "human_preview_required"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "profile_version": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "surface": { "type": "string", "minLength": 1 },
            "release_scope": { "enum": ["organic", "ads", "internal"] },
            "delivery_variant": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "source_hash": { "$ref": "#/$defs/hash" },
            "profile_hash": { "$ref": "#/$defs/hash" },
            "content_hash": { "$ref": "#/$defs/hash" },
            "selection_status": { "enum": ["verified", "human_hold"] },
            "freshness": { "enum": ["current", "stale", "unknown"] },
            "human_preview_required": { "type": "boolean" }
          }
        },
        "scene_audio_policy": { "type": "object" },
        "audio_measurement_requirements": { "type": "object" },
        "music_master": { "$ref": "#/$defs/musicMasterReceipt" },
        "stems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "stem_id",
              "role",
              "source_track_id",
              "content_hash",
              "size_bytes",
              "finish_applied"
            ],
            "additionalProperties": false,
            "properties": {
              "stem_id": { "type": "string", "minLength": 1 },
              "role": { "enum": ["dialogue", "music", "ambient", "sfx", "music_master"] },
              "source_track_id": { "enum": ["A1", "A2", "A3", "music_master"] },
              "content_hash": { "$ref": "#/$defs/hash" },
              "size_bytes": { "type": "integer", "minimum": 1 },
              "finish_applied": { "type": "boolean" }
            }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cue_id",
              "track_id",
              "timeline_range",
              "source_range_us",
              "applied",
              "pins",
              "rendered_content_hash",
              "sidechain_content_hash"
            ],
            "additionalProperties": false,
            "properties": {
              "cue_id": { "type": "string", "minLength": 1 },
              "track_id": { "type": "string", "minLength": 1 },
              "timeline_range": { "$ref": "#/$defs/frameRange" },
              "source_range_us": { "$ref": "#/$defs/microsecondRange" },
              "applied": { "$ref": "#/$defs/appliedCue" },
              "pins": { "$ref": "#/$defs/pins" },
              "rendered_content_hash": { "$ref": "#/$defs/hash" },
              "sidechain_content_hash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "sfx_cues": {
          "type": "array",
          "items": { "$ref": "#/$defs/sfxCueEvidence" }
        },
        "dialogue_finish_scope": {
          "enum": ["a1_only", "none", "none_original_passthrough", "none_mixed_legacy"]
        },
        "mastering_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "execution_strategy": {
          "type": "object",
          "required": ["id", "stages", "deterministic_input_order"],
          "additionalProperties": false,
          "properties": {
            "id": { "const": "shared_audio_render_plan_executor_v1" },
            "stages": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            },
            "deterministic_input_order": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sidechain_evidence": {
          "type": "object",
          "required": ["detector", "dialogue_stem_content_hash", "threshold", "per_cue"],
          "additionalProperties": false,
          "properties": {
            "detector": { "const": "dialogue_waveform_rms" },
            "dialogue_stem_content_hash": { "$ref": "#/$defs/hash" },
            "threshold": { "type": "number", "exclusiveMinimum": 0 },
            "per_cue": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "cue_id",
                  "ratio",
                  "attack_ms",
                  "release_ms",
                  "requested_duck_gain_db",
                  "sidechain_output_content_hash"
                ],
                "additionalProperties": false,
                "properties": {
                  "cue_id": { "type": "string", "minLength": 1 },
                  "ratio": { "type": "number", "minimum": 1 },
                  "attack_ms": { "type": "number", "minimum": 0 },
                  "release_ms": { "type": "number", "minimum": 0 },
                  "requested_duck_gain_db": { "type": "number" },
                  "sidechain_output_content_hash": { "$ref": "#/$defs/hash" }
                }
              }
            }
          }
        },
        "sfx_sidechain_evidence": {
          "type": "object",
          "required": ["detector", "dialogue_stem_content_hash", "threshold", "per_cue"],
          "additionalProperties": false,
          "properties": {
            "detector": { "const": "dialogue_waveform_rms" },
            "dialogue_stem_content_hash": { "$ref": "#/$defs/hash" },
            "threshold": { "type": "number", "exclusiveMinimum": 0 },
            "per_cue": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "cue_id",
                  "duck_group",
                  "ratio",
                  "attack_ms",
                  "release_ms",
                  "requested_duck_gain_db",
                  "dialogue_overlap_frames",
                  "sidechain_applied",
                  "a3_output_content_hash"
                ],
                "additionalProperties": false,
                "properties": {
                  "cue_id": { "type": "string", "minLength": 1 },
                  "duck_group": { "enum": ["dialogue", "none"] },
                  "ratio": { "type": "number", "minimum": 1 },
                  "attack_ms": { "type": "number", "minimum": 0 },
                  "release_ms": { "type": "number", "minimum": 0 },
                  "requested_duck_gain_db": { "type": "number" },
                  "dialogue_overlap_frames": { "type": "integer", "minimum": 0 },
                  "sidechain_applied": { "type": "boolean" },
                  "a3_output_content_hash": { "$ref": "#/$defs/hash" }
                }
              }
            }
          }
        },
        "sfx_peak": {
          "type": "object",
          "required": ["maximum_peak_dbtp", "minimum_headroom_db"],
          "additionalProperties": false,
          "properties": {
            "maximum_peak_dbtp": { "type": ["number", "null"] },
            "minimum_headroom_db": { "type": ["number", "null"] }
          }
        },
        "sidechain": { "$ref": "#/$defs/sidechain" },
        "final_mastering": { "$ref": "#/$defs/mastering" },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "required": ["sfx_hold"] },
          "then": {
            "properties": {
              "has_sfx": { "not": { "const": true } },
              "stems": {
                "items": {
                  "not": {
                    "required": ["role"],
                    "properties": { "role": { "const": "sfx" } }
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                { "required": ["sfx_cues"] },
                { "required": ["sfx_sidechain_evidence"] },
                { "required": ["sfx_peak"] },
                {
                  "required": ["input_hashes"],
                  "properties": { "input_hashes": { "required": ["sfx_sources"] } }
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["has_sfx"],
            "properties": { "has_sfx": { "const": true } }
          },
          "then": {
            "required": [
              "sfx_cues",
              "sfx_sidechain_evidence",
              "sfx_peak"
            ],
            "properties": {
              "input_hashes": {
                "required": [
                  "sfx_cues",
                  "sfx_library_manifest",
                  "sfx_sources"
                ]
              }
            }
          }
        }
      ]
    },
    "sfxCueEvidence": {
      "type": "object",
      "required": [
        "cue_id",
        "semantic_role",
        "asset_id",
        "timeline_range",
        "source_range_us",
        "dialogue_overlap_frames",
        "applied",
        "tail_processing",
        "pins",
        "rendered_content_hash",
        "a3_output_content_hash",
        "peak_dbtp",
        "headroom_db"
      ],
      "additionalProperties": false,
      "properties": {
        "cue_id": { "type": "string", "minLength": 1 },
        "semantic_role": {
          "enum": [
            "hook_impact",
            "transition_accent",
            "claim_emphasis",
            "achievement_reveal",
            "simple_sound"
          ]
        },
        "asset_id": { "type": "string", "minLength": 1 },
        "timeline_range": { "$ref": "#/$defs/frameRange" },
        "source_range_us": { "$ref": "#/$defs/microsecondRange" },
        "dialogue_overlap_frames": { "type": "integer", "minimum": 0 },
        "applied": {
          "type": "object",
          "required": [
            "gain_db",
            "fade_in_ms",
            "fade_out_ms",
            "duck_group",
            "duck_gain_db",
            "attack_ms",
            "release_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "gain_db": { "type": "number" },
            "fade_in_ms": { "type": "number", "minimum": 0 },
            "fade_out_ms": { "type": "number", "minimum": 0 },
            "duck_group": { "enum": ["dialogue", "none"] },
            "duck_gain_db": { "type": "number" },
            "attack_ms": { "type": "number", "minimum": 0 },
            "release_ms": { "type": "number", "minimum": 0 }
          }
        },
        "tail_processing": {
          "type": "object",
          "required": [
            "requested_tail_frames",
            "applied_tail_frames",
            "timeline_action",
            "source_action",
            "render_duration_frames",
            "render_duration_us"
          ],
          "additionalProperties": false,
          "properties": {
            "requested_tail_frames": { "type": "integer", "minimum": 0 },
            "applied_tail_frames": { "type": "integer", "minimum": 0 },
            "timeline_action": { "enum": ["kept", "trimmed_to_timeline"] },
            "source_action": { "enum": ["exact", "trimmed", "padded"] },
            "render_duration_frames": { "type": "integer", "minimum": 1 },
            "render_duration_us": { "type": "integer", "minimum": 1 }
          }
        },
        "pins": {
          "type": "object",
          "required": [
            "library_id",
            "library_version",
            "library_manifest_hash",
            "asset_content_hash",
            "asset_size_bytes",
            "rights_evidence_ref",
            "provenance_ref",
            "rights_basis",
            "rights_usage_scope",
            "provenance_origin",
            "generated_at"
          ],
          "additionalProperties": false,
          "properties": {
            "library_id": { "type": "string", "minLength": 1 },
            "library_version": { "type": "string", "minLength": 1 },
            "library_manifest_hash": { "$ref": "#/$defs/hash" },
            "asset_content_hash": { "$ref": "#/$defs/hash" },
            "asset_size_bytes": { "type": "integer", "minimum": 1 },
            "rights_evidence_ref": { "type": "string", "minLength": 1 },
            "provenance_ref": { "type": "string", "minLength": 1 },
            "rights_basis": { "type": "string", "minLength": 1 },
            "rights_usage_scope": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              ]
            },
            "provenance_origin": { "type": "string", "minLength": 1 },
            "generated_at": { "type": ["string", "null"] },
            "generation_id": { "type": ["string", "null"] },
            "asset_path": { "type": "string", "minLength": 1 },
            "rights_status": {
              "enum": ["confirmed", "cleared", "unknown", "expired", "ambiguous", "blocked", "hold"]
            },
            "provenance_status": {
              "enum": ["verified", "unknown", "ambiguous", "hold"]
            },
            "review_status": {
              "enum": ["approved", "pending", "rejected", "unreviewed", "hold"]
            },
            "rights_expires_at": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "permitted_derivatives": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "decision_pin": { "$ref": "#/$defs/soundDesignDecisionPin" },
        "rendered_content_hash": { "$ref": "#/$defs/hash" },
        "a3_output_content_hash": { "$ref": "#/$defs/hash" },
        "peak_dbtp": { "type": ["number", "null"] },
        "headroom_db": { "type": ["number", "null"] }
      }
    },
    "soundDesignDecisionPin": {
      "type": "object",
      "required": [
        "candidate_id",
        "decision_hash",
        "resolved_frame",
        "semantic_role",
        "asset_id"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "decision_hash": { "$ref": "#/$defs/hash" },
        "resolved_frame": { "type": "integer", "minimum": 0 },
        "semantic_role": {
          "enum": [
            "hook_impact",
            "transition_accent",
            "claim_emphasis",
            "achievement_reveal",
            "simple_sound"
          ]
        },
        "asset_id": { "type": "string", "minLength": 1 }
      }
    },
    "frameRange": {
      "type": "object",
      "required": ["in_frame", "out_frame"],
      "additionalProperties": false,
      "properties": {
        "in_frame": { "type": "integer", "minimum": 0 },
        "out_frame": { "type": "integer", "minimum": 1 }
      }
    },
    "microsecondRange": {
      "type": "object",
      "required": ["in_us", "out_us"],
      "additionalProperties": false,
      "properties": {
        "in_us": { "type": "integer", "minimum": 0 },
        "out_us": { "type": "integer", "minimum": 1 }
      }
    },
    "appliedCue": {
      "type": "object",
      "required": [
        "base_gain_db",
        "duck_gain_db",
        "fade_in_ms",
        "fade_out_ms",
        "attack_ms",
        "release_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "base_gain_db": { "type": "number" },
        "duck_gain_db": { "type": "number" },
        "fade_in_ms": { "type": "number", "minimum": 0 },
        "fade_out_ms": { "type": "number", "minimum": 0 },
        "attack_ms": { "type": "number", "minimum": 0 },
        "release_ms": { "type": "number", "minimum": 0 }
      }
    },
    "pins": {
      "type": "object",
      "required": [
        "pack_id",
        "pack_version",
        "pack_manifest_hash",
        "full_mix_content_hash",
        "full_mix_size_bytes",
        "analysis_content_hash",
        "analysis_size_bytes",
        "analysis_status"
      ],
      "additionalProperties": false,
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "pack_version": { "type": "string", "minLength": 1 },
        "pack_manifest_hash": { "$ref": "#/$defs/hash" },
        "full_mix_content_hash": { "$ref": "#/$defs/hash" },
        "full_mix_size_bytes": { "type": "integer", "minimum": 1 },
        "analysis_content_hash": { "$ref": "#/$defs/hash" },
        "analysis_size_bytes": { "type": "integer", "minimum": 1 },
        "analysis_status": { "enum": ["ready", "degraded", "failed", "unavailable"] }
      }
    },
    "encodedNumber": { "type": ["number", "null"] },
    "encodedContainer": {
      "type": "object",
      "required": ["format_name", "format_long_name"],
      "additionalProperties": false,
      "properties": {
        "format_name": { "type": ["string", "null"] },
        "format_long_name": { "type": ["string", "null"] }
      }
    },
    "encodedAudioStream": {
      "type": "object",
      "required": ["codec_name", "codec_long_name", "sample_rate_hz", "channels", "channel_layout", "bit_rate", "duration_sec", "start_time_sec"],
      "additionalProperties": false,
      "properties": {
        "codec_name": { "type": ["string", "null"] },
        "codec_long_name": { "type": ["string", "null"] },
        "sample_rate_hz": { "$ref": "#/$defs/encodedNumber" },
        "channels": { "$ref": "#/$defs/encodedNumber" },
        "channel_layout": { "type": ["string", "null"] },
        "bit_rate": { "$ref": "#/$defs/encodedNumber" },
        "duration_sec": { "$ref": "#/$defs/encodedNumber" },
        "start_time_sec": { "$ref": "#/$defs/encodedNumber" }
      }
    },
    "encodedVideoStream": {
      "type": "object",
      "required": ["codec_name", "duration_sec", "start_time_sec"],
      "additionalProperties": false,
      "properties": {
        "codec_name": { "type": ["string", "null"] },
        "duration_sec": { "$ref": "#/$defs/encodedNumber" },
        "start_time_sec": { "$ref": "#/$defs/encodedNumber" }
      }
    },
    "encodedDurationAndSync": {
      "type": "object",
      "required": ["audio_duration_sec", "video_duration_sec", "duration_delta_sec", "audio_start_time_sec", "video_start_time_sec", "start_time_delta_sec", "status"],
      "additionalProperties": false,
      "properties": {
        "audio_duration_sec": { "$ref": "#/$defs/encodedNumber" },
        "video_duration_sec": { "$ref": "#/$defs/encodedNumber" },
        "duration_delta_sec": { "$ref": "#/$defs/encodedNumber" },
        "audio_start_time_sec": { "$ref": "#/$defs/encodedNumber" },
        "video_start_time_sec": { "$ref": "#/$defs/encodedNumber" },
        "start_time_delta_sec": { "$ref": "#/$defs/encodedNumber" },
        "status": { "enum": ["measured", "not_applicable", "unavailable"] }
      }
    },
    "encodedLoudness": {
      "type": "object",
      "required": ["status", "method", "integrated_lufs", "short_term_lufs", "lra_lu", "true_peak_dbtp", "raw", "notes"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["measured", "unavailable", "failed"] },
        "method": { "enum": ["ffmpeg_loudnorm_pass1", "unavailable"] },
        "integrated_lufs": { "$ref": "#/$defs/encodedNumber" },
        "short_term_lufs": { "$ref": "#/$defs/encodedNumber" },
        "lra_lu": { "$ref": "#/$defs/encodedNumber" },
        "true_peak_dbtp": { "$ref": "#/$defs/encodedNumber" },
        "raw": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "encodedDiagnostic": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["not_run", "measured", "unavailable"] },
        "reason": { "type": "string" }
      }
    },
    "encodedPlayback": {
      "type": "object",
      "required": ["status", "method", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["verified", "unavailable", "not_run", "human_required"] },
        "method": { "type": "string" },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "encodedResult": {
      "type": "object",
      "required": ["version", "status", "path", "content_hash", "container", "audio_stream", "video_stream", "duration_and_sync", "loudness", "diagnostics", "playback", "speech_intelligibility", "human_audition", "mastering", "tool_availability", "warnings"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "encoded-audio-measurement/v1" },
        "status": { "enum": ["verified", "unavailable", "failed", "not_run"] },
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "container": { "$ref": "#/$defs/encodedContainer" },
        "audio_stream": { "$ref": "#/$defs/encodedAudioStream" },
        "video_stream": { "oneOf": [{ "$ref": "#/$defs/encodedVideoStream" }, { "type": "null" }] },
        "duration_and_sync": { "$ref": "#/$defs/encodedDurationAndSync" },
        "loudness": { "$ref": "#/$defs/encodedLoudness" },
        "diagnostics": {
          "type": "object",
          "required": ["clipping", "silence", "dropout", "channel", "phase"],
          "additionalProperties": false,
          "properties": {
            "clipping": { "$ref": "#/$defs/encodedDiagnostic" },
            "silence": { "$ref": "#/$defs/encodedDiagnostic" },
            "dropout": { "$ref": "#/$defs/encodedDiagnostic" },
            "channel": { "$ref": "#/$defs/encodedDiagnostic" },
            "phase": { "$ref": "#/$defs/encodedDiagnostic" }
          }
        },
        "playback": {
          "type": "object",
          "required": ["mono_fold_down", "mobile"],
          "additionalProperties": false,
          "properties": {
            "mono_fold_down": { "$ref": "#/$defs/encodedPlayback" },
            "mobile": {
              "type": "object",
              "required": ["status", "method", "evidence"],
              "additionalProperties": false,
              "properties": {
                "status": { "const": "human_required" },
                "method": { "const": "human_audition" },
                "evidence": { "type": ["string", "null"] }
              }
            }
          }
        },
        "speech_intelligibility": {
          "type": "object",
          "required": ["status", "proxies", "human_audition_required"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "not_claimed" },
            "proxies": { "type": "array", "items": { "type": "string" } },
            "human_audition_required": { "type": "boolean" }
          }
        },
        "human_audition": {
          "type": "object",
          "required": ["required", "status"],
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["pending", "accepted", "rejected", "not_recorded"] },
            "record_ref": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "mastering": {
          "type": "object",
          "required": ["owner", "stage", "pass_count", "applied_processing"],
          "additionalProperties": false,
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "stage": { "type": "string", "minLength": 1 },
            "pass_count": { "type": "number", "minimum": 0 },
            "applied_processing": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tool_availability": {
          "type": "object",
          "required": ["ffprobe", "ffmpeg"],
          "additionalProperties": false,
          "properties": {
            "ffprobe": { "enum": ["available", "unavailable"] },
            "ffmpeg": { "enum": ["available", "unavailable"] }
          }
        },
        "error": {
          "type": "object",
          "required": ["tool", "message"],
          "additionalProperties": false,
          "properties": {
            "tool": { "enum": ["ffprobe", "ffmpeg"] },
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
