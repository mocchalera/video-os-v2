{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/project-state.schema.json",
  "title": "Video OS Project State",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "current_state"
  ],
  "properties": {
    "version": {
      "type": ["string", "integer"]
    },
    "project_id": {
      "type": "string"
    },
    "current_state": {
      "type": "string",
      "enum": [
        "intent_pending",
        "intent_locked",
        "media_analyzed",
        "selects_ready",
        "blueprint_ready",
        "blocked",
        "timeline_drafted",
        "review_pending",
        "review_failed",
        "review_ready",
        "critique_ready",
        "approved",
        "packaged"
      ]
    },
    "last_updated": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Compatibility timestamp written by the editor-server reconciliation surface."
    },
    "last_agent": {
      "type": "string"
    },
    "last_command": {
      "type": "string"
    },
    "last_runtime": {
      "type": "string"
    },
    "artifact_hashes": {
      "$ref": "#/$defs/artifactHashes"
    },
    "approval_record": {
      "$ref": "#/$defs/approvalRecord"
    },
    "analysis_override": {
      "$ref": "#/$defs/analysisOverride"
    },
    "handoff_resolution": {
      "$ref": "#/$defs/handoffResolution"
    },
    "review_transaction": {
      "$ref": "#/$defs/reviewTransaction"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "resume": {
      "$ref": "#/$defs/resume"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifactHashes": {
      "type": "object",
      "properties": {
        "brief_hash": { "type": "string" },
        "blockers_hash": { "type": "string" },
        "analysis_artifact_version": { "type": "string" },
        "selects_hash": { "type": "string" },
        "blueprint_hash": { "type": "string" },
        "uncertainty_hash": { "type": "string" },
        "timeline_version": { "type": "string" },
        "review_report_version": { "type": "string" },
        "review_patch_hash": { "type": "string" },
        "human_notes_hash": { "type": "string" },
        "style_hash": { "type": "string" },
        "editorial_timeline_hash": { "type": "string" },
        "caption_approval_hash": { "type": "string" },
        "music_cues_hash": { "type": "string" },
        "qa_report_hash": { "type": "string" },
        "package_manifest_hash": { "type": "string" },
        "packaging_projection_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "approvalRecord": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "clean", "creative_override", "stale"]
        },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "override_reason": { "type": "string" },
        "artifact_versions": {
          "type": "object",
          "properties": {
            "timeline_version": { "type": "string" },
            "review_report_version": { "type": "string" },
            "review_patch_hash": { "type": "string" },
            "human_notes_hash": { "type": "string" },
            "style_hash": { "type": "string" },
            "base_timeline_version": { "type": "string" },
            "editorial_timeline_hash": { "type": "string" },
            "human_correction_approval": {
              "$ref": "#/$defs/humanCorrectionApprovalBinding"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "humanCorrectionApprovalBinding": {
      "type": "object",
      "required": [
        "version",
        "approved_timeline",
        "human_notes",
        "review_generation",
        "review_round",
        "human_revision_diff"
      ],
      "properties": {
        "version": { "const": "human-correction-approval/v1" },
        "approved_timeline": {
          "type": "object",
          "required": ["path", "version", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "human_notes": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "review_generation": {
          "type": "object",
          "required": ["generation_id", "review_identity", "output", "review_ready_receipt"],
          "properties": {
            "generation_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "review_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "output": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            },
            "review_ready_receipt": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "review_round": {
          "type": "object",
          "required": ["round_index", "round_identity"],
          "properties": {
            "round_index": { "type": "integer", "minimum": 1 },
            "round_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "human_revision_diff": {
          "type": "object",
          "required": ["path", "sha256", "version"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "version": { "const": 2 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "analysisOverride": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "active", "stale"]
        },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "reason": { "type": "string" },
        "scope": { "type": "string" },
        "artifact_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "reviewTransaction": {
      "type": "object",
      "required": ["version", "review_identity", "status", "reason"],
      "properties": {
        "version": { "const": "review-transaction/v1" },
        "review_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["pending", "ready", "failed", "stale"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "analysis_gate": {
          "type": "string",
          "enum": ["ready", "partial_override", "blocked"]
        },
        "compile_gate": {
          "type": "string",
          "enum": ["open", "blocked"]
        },
        "planning_gate": {
          "type": "string",
          "enum": ["open", "blocked", "partial_override"]
        },
        "timeline_gate": {
          "type": "string",
          "enum": ["open", "blocked"]
        },
        "review_gate": {
          "type": "string",
          "enum": ["open", "blocked"]
        },
        "packaging_gate": {
          "type": "string",
          "enum": ["open", "blocked"]
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "properties": {
        "pending_human_step": { "type": "string" },
        "pending_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resume_command": { "type": "string" },
        "last_error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "handoffResolution": {
      "type": "object",
      "required": ["handoff_id", "status"],
      "properties": {
        "handoff_id": {
          "type": "string",
          "pattern": "^HND_.+$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "decided"]
        },
        "source_of_truth_decision": {
          "type": "string",
          "enum": ["engine_render", "nle_finishing"]
        },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string" },
        "basis_report_hashes": {
          "type": "object",
          "properties": {
            "roundtrip_import_report": { "type": "string" },
            "human_revision_diff": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "historyEntry": {
      "type": "object",
      "required": ["from_state", "to_state", "trigger", "timestamp"],
      "properties": {
        "from_state": { "type": "string" },
        "to_state": { "type": "string" },
        "trigger": { "type": "string" },
        "actor": { "type": "string" },
        "timestamp": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
