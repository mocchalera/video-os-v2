{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/nle-capability-profile.schema.json",
  "title": "Video OS NLE Capability Profile",
  "description": "Data-driven contract declaring which editing surfaces are verified, provisional, report-only, or lossy for a given NLE.",
  "type": "object",
  "required": [
    "version",
    "profile_id",
    "nle",
    "otio",
    "stable_id",
    "surfaces",
    "import_policy"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "nle": {
      "$ref": "#/$defs/nleInfo"
    },
    "otio": {
      "$ref": "#/$defs/otioInfo"
    },
    "stable_id": {
      "$ref": "#/$defs/stableIdConfig"
    },
    "surfaces": {
      "$ref": "#/$defs/surfaces"
    },
    "import_policy": {
      "$ref": "#/$defs/importPolicy"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile_id": { "const": "adobe_premiere_fcp7xml_v1" } },
        "required": ["profile_id"]
      },
      "then": {
        "properties": {
          "surfaces": {
            "properties": {
              "simple_transition": { "$ref": "#/$defs/premiereSimpleTransition" }
            },
            "required": ["simple_transition", "audio_levels", "visual_effect_bake"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nleInfo": {
      "type": "object",
      "required": ["vendor", "product", "version_range"],
      "properties": {
        "vendor": { "type": "string" },
        "product": { "type": "string" },
        "version_range": { "type": "string" }
      },
      "additionalProperties": false
    },
    "otioInfo": {
      "type": "object",
      "required": ["interchange_format", "metadata_namespace"],
      "properties": {
        "interchange_format": {
          "type": "string",
          "enum": ["otio"]
        },
        "metadata_namespace": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stableIdConfig": {
      "type": "object",
      "required": ["primary_paths", "require_exact_metadata"],
      "properties": {
        "primary_paths": {
          "type": "object",
          "required": ["clip", "track"],
          "properties": {
            "clip": { "type": "string" },
            "track": { "type": "string" }
          },
          "additionalProperties": false
        },
        "fallback_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "require_exact_metadata": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "surfaceMode": {
      "type": "string",
      "enum": [
        "verified_roundtrip",
        "provisional_roundtrip",
        "report_only",
        "lossy",
        "one_way"
      ]
    },
    "surfaceEntry": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "$ref": "#/$defs/surfaceMode" },
        "tolerance_frames": { "type": "integer", "minimum": 0 },
        "detect_after": { "type": "string" },
        "export_mode": {
          "type": "string",
          "enum": ["blocked", "exact_projection"]
        },
        "allowed_types": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "premiereSimpleTransition": {
      "type": "object",
      "required": ["mode", "allowed_types"],
      "properties": {
        "mode": { "const": "report_only" },
        "allowed_types": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["dissolve", "dip_to_color"] },
          "allOf": [
            { "contains": { "const": "dissolve" } },
            { "contains": { "const": "dip_to_color" } }
          ]
        }
      },
      "additionalProperties": false
    },
    "premiereAudioLevels": {
      "type": "object",
      "required": [
        "mode",
        "allowed_effect_ids",
        "mapped_unsupported_effects",
        "unmapped_effects",
        "hardware_verified"
      ],
      "properties": {
        "mode": { "const": "provisional_roundtrip" },
        "allowed_effect_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "audiolevels" }
        },
        "mapped_unsupported_effects": { "const": "reject_on_apply" },
        "unmapped_effects": { "const": "report_only_manual" },
        "hardware_verified": { "const": false }
      },
      "additionalProperties": false
    },
    "premiereVisualEffectBake": {
      "type": "object",
      "required": ["version", "mode", "treatment_schema", "manifest_schema", "codec_policy", "consent", "cache_root", "output_sar", "media_topology", "supported_baked_edits", "blocked_baked_edits", "hardware_verified"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "visual-effect-bake/v1" },
        "mode": { "const": "derived_video_replacement" },
        "treatment_schema": { "const": "premiere-visual-treatment/v1" },
        "manifest_schema": { "const": "premiere-effect-bake-manifest/v1" },
        "codec_policy": { "const": "h264_crf14_near_lossless" },
        "consent": { "const": "explicit_cli_flag" },
        "cache_root": { "const": "09_output/premiere-bakes" },
        "output_sar": { "const": "1:1" },
        "media_topology": { "const": "video_only_with_independent_original_audio" },
        "supported_baked_edits": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["unchanged", "reorder", "delete"] },
          "allOf": [{ "contains": { "const": "unchanged" } }, { "contains": { "const": "reorder" } }, { "contains": { "const": "delete" } }]
        },
        "blocked_baked_edits": {
          "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["trim", "track_move", "relink", "source_replace", "speed", "rate", "filter"] },
          "allOf": [{ "contains": { "const": "trim" } }, { "contains": { "const": "track_move" } }, { "contains": { "const": "relink" } }, { "contains": { "const": "source_replace" } }, { "contains": { "const": "speed" } }, { "contains": { "const": "rate" } }, { "contains": { "const": "filter" } }]
        },
        "hardware_verified": { "const": false }
      }
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "trim": { "$ref": "#/$defs/surfaceEntry" },
        "reorder": { "$ref": "#/$defs/surfaceEntry" },
        "enable_disable": { "$ref": "#/$defs/surfaceEntry" },
        "track_move": { "$ref": "#/$defs/surfaceEntry" },
        "track_reorder": { "$ref": "#/$defs/surfaceEntry" },
        "simple_transition": { "$ref": "#/$defs/surfaceEntry" },
        "timeline_marker_add": { "$ref": "#/$defs/surfaceEntry" },
        "clip_marker_add": { "$ref": "#/$defs/surfaceEntry" },
        "note_text_add": { "$ref": "#/$defs/surfaceEntry" },
        "text_overlay": { "$ref": "#/$defs/surfaceEntry" },
        "audio_levels": { "$ref": "#/$defs/premiereAudioLevels" },
        "visual_effect_bake": { "$ref": "#/$defs/premiereVisualEffectBake" },
        "color_finish": { "$ref": "#/$defs/surfaceEntry" },
        "fusion_effect": { "$ref": "#/$defs/surfaceEntry" },
        "fairlight_advanced_audio": { "$ref": "#/$defs/surfaceEntry" }
      },
      "additionalProperties": false
    },
    "importPolicy": {
      "type": "object",
      "required": [
        "provisional_mapping_requires_review",
        "unmapped_edit_requires_review",
        "one_to_many_requires_review"
      ],
      "properties": {
        "provisional_mapping_requires_review": { "type": "boolean" },
        "unmapped_edit_requires_review": { "type": "boolean" },
        "one_to_many_requires_review": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
