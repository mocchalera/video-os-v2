{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "distribution-preflight-decision.schema.json", "type": "object",
  "required": ["version", "decision_id", "decision", "action", "identity", "reasons", "override"],
  "properties": {
    "version": { "const": "distribution-preflight-decision/v1" }, "decision_id": { "$ref": "#/$defs/hash" }, "decision": { "enum": ["ALLOW", "BLOCK"] },
    "action": { "enum": ["review_share", "external_export", "external_upload", "production_release", "publication", "public_upload"] },
    "identity": { "type": "object", "required": ["project_id", "generation_id", "review_identity", "review_receipt_sha256", "output_sha256", "package_manifest_sha256"], "properties": { "project_id": { "type": "string", "minLength": 1 }, "generation_id": { "$ref": "#/$defs/hash" }, "review_identity": { "$ref": "#/$defs/hash" }, "review_receipt_sha256": { "$ref": "#/$defs/hash" }, "output_sha256": { "$ref": "#/$defs/hash" }, "package_manifest_sha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false },
    "reasons": { "type": "array", "items": { "type": "object", "required": ["code", "artifact", "identity", "overrideable"], "properties": { "code": { "enum": ["REQUEST_INVALID", "CURRENT_GENERATION_MISMATCH", "REVIEW_STATE_MISSING", "REVIEW_NOT_CURRENT", "REVIEW_RECEIPT_INVALID", "REVIEW_IDENTITY_MISMATCH", "REVIEW_GATE_NOT_OPEN", "QA_FAILED", "QA_INCOMPLETE", "DECLARED_HOLD", "HUMAN_RESIDUAL_UNRESOLVED", "GEOMETRY_UNKNOWN", "GEOMETRY_PROVISIONAL", "POLICY_ONLY_AS_PLATFORM_MEASURED", "PACKAGE_MISSING", "PACKAGE_EMPTY", "PACKAGE_INVALID", "PACKAGE_ARTIFACT_MISSING", "PACKAGE_PATH_ESCAPE", "PACKAGE_HASH_MISMATCH", "OUTPUT_HASH_MISMATCH", "PACKAGE_REVIEW_IDENTITY_MISMATCH", "OVERRIDE_INVALID", "OVERRIDE_EXPIRED", "OVERRIDE_IDENTITY_MISMATCH", "OVERRIDE_ACTION_FORBIDDEN"] }, "artifact": { "type": "string", "minLength": 1 }, "identity": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "overrideable": { "type": "boolean" } }, "additionalProperties": false } },
    "override": { "anyOf": [{ "type": "null" }, { "type": "object", "required": ["locator", "sha256", "actor"], "properties": { "locator": { "type": "string", "pattern": "^project:[^/].+" }, "sha256": { "$ref": "#/$defs/hash" }, "actor": { "type": "string", "minLength": 1 } }, "additionalProperties": false }] }
  }, "additionalProperties": false, "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
