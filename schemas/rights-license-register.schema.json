{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rights-license-register.schema.json",
  "title": "Video OS Rights and License Register",
  "description": "Sanitized, hash-bound rights records used by preview and release-safety gates.",
  "type": "object",
  "required": ["version", "project_id", "created_at", "items", "provenance"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/rightsItem" } },
    "provenance": { "$ref": "#/$defs/artifactProvenance" }
  },
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*:)(?!.*//)(?!.*/$)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^\\\\]+$"
    },
    "opaqueRef": {
      "type": "string",
      "pattern": "^(?:evidence|license|source|provenance|private|urn):[A-Za-z0-9][A-Za-z0-9._~/-]*$"
    },
    "reference": {
      "anyOf": [
        { "$ref": "#/$defs/relativeRef" },
        { "$ref": "#/$defs/opaqueRef" }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "kind", "locator"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["declaration", "terms_snapshot", "license_text", "similarity_review", "technical_report", "other"] },
        "locator": { "$ref": "#/$defs/reference" }
      }
    },
    "generatorFacts": {
      "type": "object",
      "required": ["tool", "model_revision", "account_tier_at_creation", "paid_tier_confirmed", "terms_revision"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "model_revision": { "type": ["string", "null"], "minLength": 1 },
        "account_tier_at_creation": { "type": ["string", "null"], "minLength": 1 },
        "paid_tier_confirmed": { "type": ["boolean", "null"] },
        "terms_revision": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "required": ["identifier", "text_ref", "permitted_scopes", "attribution_rule"],
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "text_ref": { "$ref": "#/$defs/reference" },
        "permitted_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["preview_internal", "external", "public_redistribution", "commercial", "modification", "sublicensing"]
          },
          "uniqueItems": true
        },
        "attribution_rule": { "type": "string", "minLength": 1 }
      }
    },
    "similarityReview": {
      "type": "object",
      "required": ["status", "reviewer_ref", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["not_required", "pending", "passed", "rejected"] },
        "reviewer_ref": { "anyOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["passed", "rejected"] } }, "required": ["status"] },
          "then": {
            "properties": {
              "reviewer_ref": { "type": "string", "minLength": 1 },
              "reviewed_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not_required" } }, "required": ["status"] },
          "then": {
            "properties": {
              "reviewer_ref": { "type": "null" },
              "reviewed_at": { "type": "null" }
            }
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "required": ["status", "verified_hash", "verified_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["verified", "unverified", "mismatch"] },
        "verified_hash": { "anyOf": [{ "$ref": "#/$defs/contentHash" }, { "type": "null" }] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["verified", "mismatch"] } }, "required": ["status"] },
          "then": {
            "properties": {
              "verified_hash": { "$ref": "#/$defs/contentHash" },
              "verified_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unverified" } }, "required": ["status"] },
          "then": {
            "properties": {
              "verified_hash": { "type": "null" },
              "verified_at": { "type": "null" }
            }
          }
        }
      ]
    },
    "waiver": {
      "type": "object",
      "required": ["waiver_id", "scope", "reason", "approved_by", "approved_at"],
      "additionalProperties": false,
      "properties": {
        "waiver_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "rightsItem": {
      "type": "object",
      "required": [
        "record_id",
        "item_type",
        "asset_id",
        "content_hash",
        "source_type",
        "source_ref",
        "contributor_declaration_id",
        "generator",
        "creation_date",
        "evidence_refs",
        "license",
        "similarity_review",
        "integrity",
        "rights_status",
        "waivers",
        "reviewer_ref",
        "reviewed_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": { "type": "string", "pattern": "^RIGHTS_[A-Za-z0-9_-]+$" },
        "item_type": { "const": "bgm" },
        "asset_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/contentHash" },
        "source_type": { "type": "string", "enum": ["bundled_pack", "user_library", "project_local"] },
        "source_ref": { "$ref": "#/$defs/reference" },
        "contributor_declaration_id": { "type": "string", "minLength": 1 },
        "generator": { "anyOf": [{ "$ref": "#/$defs/generatorFacts" }, { "type": "null" }] },
        "creation_date": { "type": "string", "format": "date" },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "license": { "$ref": "#/$defs/license" },
        "similarity_review": { "$ref": "#/$defs/similarityReview" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "rights_status": { "type": "string", "enum": ["unknown", "operator_declared_ok", "licensed", "restricted", "blocked"] },
        "waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } },
        "reviewer_ref": { "anyOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "rights_status": { "const": "licensed" } }, "required": ["rights_status"] },
          "then": {
            "properties": {
              "evidence_refs": { "minItems": 1 },
              "license": { "properties": { "permitted_scopes": { "minItems": 1 } } },
              "similarity_review": { "properties": { "status": { "enum": ["passed", "not_required"] } } },
              "integrity": { "properties": { "status": { "const": "verified" } } },
              "reviewer_ref": { "$ref": "#/$defs/reference" },
              "reviewed_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rights_status": { "const": "licensed" },
              "generator": { "type": "object" }
            },
            "required": ["rights_status", "generator"]
          },
          "then": {
            "properties": {
              "generator": {
                "properties": {
                  "account_tier_at_creation": { "type": "string", "minLength": 1 },
                  "paid_tier_confirmed": { "const": true },
                  "terms_revision": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "artifactProvenance": {
      "type": "object",
      "required": ["producer", "inputs", "hash_policy"],
      "additionalProperties": false,
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "hash"],
            "additionalProperties": false,
            "properties": {
              "path": { "$ref": "#/$defs/reference" },
              "hash": { "$ref": "#/$defs/contentHash" }
            }
          }
        },
        "hash_policy": {
          "type": "object",
          "required": ["algorithm", "canonicalization", "excluded_fields"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "sha256" },
            "canonicalization": { "const": "normalized-json-v1" },
            "excluded_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        }
      }
    }
  }
}
