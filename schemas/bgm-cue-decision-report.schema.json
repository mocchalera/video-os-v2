{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/bgm-cue-decision-report.schema.json",
  "title": "Video OS BGM Cue Decision Report",
  "description": "Hash-bound record of an explicit audition candidate projected from bgm_selection through music_cues/v2.",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "created_at",
    "decision",
    "release_status",
    "selected_track_pin",
    "input_timeline_hash",
    "selection_hash",
    "music_cues_hash",
    "projected_timeline_hash",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "decision": { "const": "explicit_audition_candidate" },
    "release_status": { "const": "audition_only" },
    "selected_track_pin": { "$ref": "#/$defs/selectedTrackPin" },
    "input_timeline_hash": { "$ref": "#/$defs/contentHash" },
    "selection_hash": { "$ref": "#/$defs/contentHash" },
    "music_cues_hash": { "$ref": "#/$defs/contentHash" },
    "projected_timeline_hash": { "$ref": "#/$defs/contentHash" },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "selectedTrackPin": {
      "type": "object",
      "required": [
        "pack_id",
        "pack_version",
        "pack_manifest_hash",
        "track_id",
        "full_mix_content_hash",
        "full_mix_size_bytes",
        "full_mix_path",
        "analysis_content_hash",
        "analysis_size_bytes",
        "analysis_path",
        "analysis_status",
        "registry_status"
      ],
      "additionalProperties": false,
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "pack_version": { "type": "string", "minLength": 1 },
        "pack_manifest_hash": { "$ref": "#/$defs/contentHash" },
        "track_id": { "type": "string", "minLength": 1 },
        "full_mix_content_hash": { "$ref": "#/$defs/contentHash" },
        "full_mix_size_bytes": { "type": "integer", "minimum": 1 },
        "full_mix_path": { "type": "string", "minLength": 1 },
        "analysis_content_hash": { "$ref": "#/$defs/contentHash" },
        "analysis_size_bytes": { "type": "integer", "minimum": 1 },
        "analysis_path": { "type": "string", "minLength": 1 },
        "analysis_status": {
          "type": "string",
          "enum": ["ready", "degraded", "failed", "unavailable"]
        },
        "registry_status": { "const": "verified" }
      }
    }
  }
}
