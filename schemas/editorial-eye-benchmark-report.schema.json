{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-os.local/schemas/editorial-eye-benchmark-report.schema.json",
  "title": "Editorial Eye Benchmark Report v1",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_version", "suite_id", "suite_version", "baseline_commit", "candidate_commit", "baseline_report_sha256", "fixture_manifest_sha256", "label_version", "generator", "provenance", "metrics", "breakdowns", "binary_gates", "regressions", "resources", "verdict"],
  "properties": {
    "artifact_version": { "const": "editorial-eye-benchmark-report/v1" }, "suite_id": { "const": "editorial-eye-v1" }, "suite_version": { "const": "1.0.0" },
    "baseline_commit": { "$ref": "#/$defs/commitSha" }, "candidate_commit": { "$ref": "#/$defs/commitSha" }, "baseline_report_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "fixture_manifest_sha256": { "$ref": "#/$defs/sha256" }, "label_version": { "type": "string", "pattern": "^labels-v[0-9]+$" }, "generator": { "$ref": "#/$defs/generator" }, "provenance": { "$ref": "#/$defs/provenance" },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["automatic_binary", "human"],
      "properties": {
        "automatic_binary": { "$ref": "#/$defs/automaticMetrics" },
        "human": { "type": "object", "additionalProperties": false, "required": ["human_accuracy", "human_f1"], "properties": { "human_accuracy": { "$ref": "#/$defs/metric" }, "human_f1": { "$ref": "#/$defs/relation" } } },
        "legacy_artifact_agreement": { "type": "object", "additionalProperties": false, "required": ["status", "score"], "properties": { "status": { "enum": ["measured", "unmeasured"] }, "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } } }
      }
    },
    "breakdowns": {
      "type": "object", "additionalProperties": false, "required": ["by_genre", "by_media_kind", "metrics_by_genre", "metrics_by_media_kind"],
      "properties": {
        "by_genre": { "type": "object", "additionalProperties": false, "required": ["interview_dialogue", "quiet_documentary", "product_detail", "action_event", "vertical_social_montage", "chronological_longform", "intentional_jump_smash_match"], "properties": { "interview_dialogue": { "$ref": "#/$defs/counts" }, "quiet_documentary": { "$ref": "#/$defs/counts" }, "product_detail": { "$ref": "#/$defs/counts" }, "action_event": { "$ref": "#/$defs/counts" }, "vertical_social_montage": { "$ref": "#/$defs/counts" }, "chronological_longform": { "$ref": "#/$defs/counts" }, "intentional_jump_smash_match": { "$ref": "#/$defs/counts" } } },
        "by_media_kind": { "type": "object", "additionalProperties": false, "required": ["video", "audio", "image", "sequence", "mixed"], "properties": { "video": { "$ref": "#/$defs/counts" }, "audio": { "$ref": "#/$defs/counts" }, "image": { "$ref": "#/$defs/counts" }, "sequence": { "$ref": "#/$defs/counts" }, "mixed": { "$ref": "#/$defs/counts" } } },
        "metrics_by_genre": { "type": "object", "additionalProperties": false, "required": ["interview_dialogue", "quiet_documentary", "product_detail", "action_event", "vertical_social_montage", "chronological_longform", "intentional_jump_smash_match"], "properties": { "interview_dialogue": { "$ref": "#/$defs/automaticMetrics" }, "quiet_documentary": { "$ref": "#/$defs/automaticMetrics" }, "product_detail": { "$ref": "#/$defs/automaticMetrics" }, "action_event": { "$ref": "#/$defs/automaticMetrics" }, "vertical_social_montage": { "$ref": "#/$defs/automaticMetrics" }, "chronological_longform": { "$ref": "#/$defs/automaticMetrics" }, "intentional_jump_smash_match": { "$ref": "#/$defs/automaticMetrics" } } },
        "metrics_by_media_kind": { "type": "object", "additionalProperties": false, "required": ["video", "audio", "image", "sequence", "mixed"], "properties": { "video": { "$ref": "#/$defs/automaticMetrics" }, "audio": { "$ref": "#/$defs/automaticMetrics" }, "image": { "$ref": "#/$defs/automaticMetrics" }, "sequence": { "$ref": "#/$defs/automaticMetrics" }, "mixed": { "$ref": "#/$defs/automaticMetrics" } } }
      }
    },
    "binary_gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } }, "regressions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/regression" } },
    "resources": { "type": "object", "additionalProperties": false, "required": ["model_runs", "generated_media_bytes", "wall_time_ms"], "properties": { "model_runs": { "type": "integer", "minimum": 0 }, "generated_media_bytes": { "type": "integer", "minimum": 0 }, "wall_time_ms": { "type": "integer", "minimum": 0 } } },
    "verdict": { "type": "object", "additionalProperties": false, "required": ["status", "blocking_failures"], "properties": { "status": { "enum": ["pass", "fail"] }, "blocking_failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generator": { "type": "object", "additionalProperties": false, "required": ["id", "version", "fixture_set_id"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "fixture_set_id": { "type": "string" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["environment", "models", "degraded"], "properties": { "environment": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }, "models": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } } }, "degraded": { "type": "array", "items": { "type": "string" } } } },
    "metric": { "type": "object", "additionalProperties": false, "required": ["status", "value", "numerator", "denominator"], "properties": { "status": { "enum": ["measured", "unmeasured"] }, "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 0 } } },
    "calibration": { "type": "object", "additionalProperties": false, "required": ["status", "ece", "sample_count", "minimum_sample_count", "bins"], "properties": { "status": { "enum": ["measured", "unmeasured"] }, "ece": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "sample_count": { "type": "integer", "minimum": 0 }, "minimum_sample_count": { "type": "integer", "minimum": 1 }, "bins": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["lower", "upper", "count", "mean_confidence", "accuracy"], "properties": { "lower": { "type": "number" }, "upper": { "type": "number" }, "count": { "type": "integer", "minimum": 0 }, "mean_confidence": { "type": ["number", "null"] }, "accuracy": { "type": ["number", "null"] } } } } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["status", "macro_f1", "sample_count", "labels", "confusion_matrix"], "properties": { "status": { "enum": ["measured", "unmeasured"] }, "macro_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "sample_count": { "type": "integer", "minimum": 0 }, "labels": { "type": "array", "items": { "type": "string" } }, "confusion_matrix": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } } },
    "automaticMetrics": { "type": "object", "additionalProperties": false, "required": ["grounded_visual_success", "observation_field_coverage", "observation_agreement_accuracy", "confidence_calibration", "pair_relation", "false_hard_fail_rate"], "properties": { "grounded_visual_success": { "$ref": "#/$defs/metric" }, "observation_field_coverage": { "$ref": "#/$defs/metric" }, "observation_agreement_accuracy": { "$ref": "#/$defs/metric" }, "confidence_calibration": { "$ref": "#/$defs/calibration" }, "pair_relation": { "$ref": "#/$defs/relation" }, "false_hard_fail_rate": { "$ref": "#/$defs/metric" } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["applicable", "unsupported", "unmeasured", "success", "failure"], "properties": { "applicable": { "type": "integer", "minimum": 0 }, "unsupported": { "type": "integer", "minimum": 0 }, "unmeasured": { "type": "integer", "minimum": 0 }, "success": { "type": "integer", "minimum": 0 }, "failure": { "type": "integer", "minimum": 0 } } },
    "gate": { "type": "object", "additionalProperties": false, "required": ["gate_id", "namespace", "status", "blocking", "passed", "details"], "properties": { "gate_id": { "enum": ["grounded_visual_success", "human_accuracy", "human_f1", "source_freshness", "rollback", "preference_isolation"] }, "namespace": { "enum": ["automatic_binary", "human"] }, "status": { "enum": ["measured", "unmeasured"] }, "blocking": { "type": "boolean" }, "passed": { "type": ["boolean", "null"] }, "details": { "type": "array", "items": { "type": "string" } } } },
    "regression": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "message"], "properties": { "id": { "type": "string" }, "severity": { "enum": ["advisory", "blocking"] }, "message": { "type": "string" }, "case_id": { "type": "string" }, "genre": { "enum": ["interview_dialogue", "quiet_documentary", "product_detail", "action_event", "vertical_social_montage", "chronological_longform", "intentional_jump_smash_match"] }, "media_kind": { "enum": ["video", "audio", "image", "sequence", "mixed"] }, "reason": { "type": "string" } } }
  }
}
