{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/caption-approval.schema.json",
  "title": "Video OS Caption Approval",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "base_timeline_version",
    "caption_policy",
    "speech_captions",
    "text_overlays",
    "approval"
  ],
  "properties": {
    "version": { "type": "string" },
    "project_id": { "type": "string" },
    "base_timeline_version": { "type": "string" },
    "caption_policy": { "$ref": "#/$defs/captionPolicy" },
    "speech_captions": {
      "type": "array",
      "items": { "$ref": "#/$defs/speechCaption" }
    },
    "text_overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/textOverlay" }
    },
    "text_authority": { "$ref": "#/$defs/authoredTextAuthority" },
    "timing_authority": { "$ref": "#/$defs/authoredTimingAuthority" },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "version": { "const": "caption-draft/v2" } } },
      "then": {
        "properties": {
          "speech_captions": { "items": { "$ref": "#/$defs/speechCaptionV2" } }
        }
      }
    }
  ],
  "$defs": {
    "captionPolicy": {
      "type": "object",
      "required": ["language", "delivery_mode", "source", "styling_class"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "delivery_mode": {
          "type": "string",
          "enum": ["burn_in", "sidecar", "both"]
        },
        "source": {
          "type": "string",
          "enum": ["transcript", "authored", "none"]
        },
        "styling_class": { "type": "string", "minLength": 1 },
        "semantic_timing": { "$ref": "#/$defs/captionSemanticTimingPolicy" }
      },
      "additionalProperties": false
    },
    "speechCaption": {
      "type": "object",
      "required": [
        "caption_id",
        "asset_id",
        "segment_id",
        "timeline_in_frame",
        "timeline_duration_frames",
        "text",
        "source",
        "styling_class",
        "metrics"
      ],
      "properties": {
        "caption_id": { "type": "string", "pattern": "^SC_" },
        "root_id": { "type": "string", "pattern": "^SC_" },
        "parent_ids": { "type": "array", "items": { "type": "string", "pattern": "^SC_" }, "uniqueItems": true },
        "lineage_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "asset_id": { "type": "string" },
        "segment_id": { "type": "string" },
        "timeline_in_frame": { "type": "integer", "minimum": 0 },
        "timeline_duration_frames": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "transcript_ref": { "type": "string" },
        "transcript_item_ids": {
          "type": "array",
          "items": {}
        },
        "source": {
          "type": "string",
          "enum": ["transcript", "authored"]
        },
        "styling_class": { "type": "string" },
        "metrics": { "$ref": "#/$defs/captionMetrics" },
        "line_id": { "type": "string", "pattern": "^AL_" },
        "cue_id": { "type": "string", "pattern": "^AC_" },
        "timing": { "type": "object" },
        "reveal_timing": { "$ref": "#/$defs/captionRevealMetadata" }
      },
      "additionalProperties": false
    },
    "speechCaptionV2": {
      "allOf": [
        { "$ref": "#/$defs/speechCaption" },
        {
          "required": ["root_id", "parent_ids", "lineage_hash", "timing"],
          "properties": {
            "timing": { "$ref": "#/$defs/timingV2" }
          }
        }
      ]
    },
    "timingV2": {
      "type": "object",
      "required": ["source", "confidence", "triggeredFallback", "timelineInFrame", "timelineDurationFrames", "offsetMapFingerprint", "authority"],
      "properties": {
        "source": { "enum": ["word_remap", "clip_item_remap", "offset_map", "offset_map_fallback", "authored_timing_plan", "authored_stt_word_timing", "authored_onset", "authored_section_cue", "authored_unmatched"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceWordRefs": { "type": "array", "items": { "type": "object" } },
        "clipMapRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authority": { "enum": ["A1", "legacy-role", "fallback", "authored"] },
        "offsetMapFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "stale": { "type": "boolean" },
        "triggeredFallback": { "type": "boolean" },
        "timelineInFrame": { "type": "integer", "minimum": 0 },
        "timelineDurationFrames": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "captionSemanticTimingPolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["off", "speech_sync", "protect_reveals"] },
        "ordinary_lead_frames": { "type": "integer", "minimum": 0, "maximum": 6 },
        "audio_first_frames": { "type": "integer", "minimum": 0, "maximum": 6 },
        "question_audio_first_frames": { "type": "integer", "minimum": 0, "maximum": 6 },
        "gap_ownership": { "enum": ["previous", "blank"] },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/captionRevealAnchor" }
        }
      },
      "additionalProperties": false
    },
    "captionRevealAnchor": {
      "type": "object",
      "required": ["anchor_id", "role", "anchor_text"],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["punchline", "surprise", "reaction", "payoff"] },
        "anchor_text": { "type": "string", "minLength": 1 },
        "segment_id": { "type": "string", "minLength": 1 },
        "transcript_item_id": { "type": "string", "minLength": 1 },
        "timeline_frame": { "type": "integer", "minimum": 0 },
        "source_start_us": { "type": "integer", "minimum": 0 },
        "audio_first_frames": { "type": "integer", "minimum": 0, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "captionRevealMetadata": {
      "type": "object",
      "required": ["anchor_id", "role", "anchor_text", "status", "source", "audio_first_frames", "original_timeline_in_frame"],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["punchline", "surprise", "reaction", "payoff"] },
        "anchor_text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["protected", "setup_only", "unresolved"] },
        "source": { "enum": ["word_timing", "transcript_item_onset", "explicit_source_time", "explicit_timeline_frame", "unresolved"] },
        "anchor_frame": { "type": "integer", "minimum": 0 },
        "audio_first_frames": { "type": "integer", "minimum": 0, "maximum": 6 },
        "original_timeline_in_frame": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "captionMetrics": {
      "type": "object",
      "required": ["cps", "dwell_ms"],
      "properties": {
        "cps": { "type": "number", "minimum": 0 },
        "dwell_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "textOverlay": {
      "type": "object",
      "required": [
        "overlay_id",
        "timeline_in_frame",
        "timeline_duration_frames",
        "text",
        "styling_class",
        "writing_mode",
        "anchor",
        "source"
      ],
      "properties": {
        "overlay_id": { "type": "string" },
        "timeline_in_frame": { "type": "integer", "minimum": 0 },
        "timeline_duration_frames": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "styling_class": { "type": "string" },
        "writing_mode": {
          "type": "string",
          "enum": ["horizontal_tb", "vertical_rl"]
        },
        "anchor": {
          "type": "string",
          "enum": [
            "top_left", "top_center", "top_right",
            "center",
            "bottom_left", "bottom_center", "bottom_right"
          ]
        },
        "safe_area": { "type": "object" },
        "source": {
          "type": "string",
          "enum": ["authored"]
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "stale"]
        },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "base_caption_draft_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "caption_review_patch_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "validation_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "base_timeline_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "typography_policy_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "platform_safe_zone_profile_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "caption_visual_treatment_patch_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "visual_treatment_input_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "visual_treatment_context": { "$ref": "#/$defs/visualTreatmentContext" }
      },
      "additionalProperties": false
    },
    "visualTreatmentContext": {
      "type": "object",
      "required": ["accessibility"],
      "properties": {
        "accessibility": {
          "type": "object",
          "required": ["reduced_motion", "high_contrast", "audio_off", "small_screen"],
          "properties": {
            "reduced_motion": { "type": "boolean" },
            "high_contrast": { "type": "boolean" },
            "audio_off": { "type": "boolean" },
            "small_screen": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "safe_zone_profile": {
          "type": "object",
          "required": ["profile_id", "path", "sha256"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authoredTextAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_path",
        "source_sha256",
        "source_hash",
        "declared_normalization",
        "line_ending_mode",
        "line_count",
        "body_sha256",
        "lines"
      ],
      "properties": {
        "authority": { "const": "authored" },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "declared_normalization": { "const": "preserve_bytes" },
        "line_ending_mode": { "const": "preserved" },
        "line_count": { "type": "integer", "minimum": 0 },
        "body_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_id", "line_number", "text", "text_sha256"],
            "properties": {
              "line_id": { "type": "string", "pattern": "^AL_" },
              "line_number": { "type": "integer", "minimum": 1 },
              "text": { "type": "string" },
              "text_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "authoredTimingAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_path",
        "source_sha256",
        "source_hash",
        "declared_normalization",
        "plan_version",
        "alignment_version",
        "confidence_threshold",
        "matched_count",
        "pending_count",
        "unmatched_count",
        "cues"
      ],
      "properties": {
        "authority": { "const": "timing_plan" },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "declared_normalization": { "const": "preserve_values" },
        "plan_version": { "type": "string", "minLength": 1 },
        "alignment_version": { "const": "authored-lyrics-align/v1" },
        "cue_count": { "type": "integer", "minimum": 0 },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "matched_count": { "type": "integer", "minimum": 0 },
        "pending_count": { "type": "integer", "minimum": 0 },
        "unmatched_count": { "type": "integer", "minimum": 0 },
        "cues": {
          "type": "array",
          "items": { "$ref": "#/$defs/authoredTimingCue" }
        }
      }
    },
    "authoredTimingCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "line_id",
        "line_number",
        "status",
        "confidence",
        "source_kind",
        "source_refs"
      ],
      "properties": {
        "cue_id": { "type": "string", "pattern": "^AC_" },
        "line_id": { "type": "string", "pattern": "^AL_" },
        "line_number": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["matched", "human_confirmation_pending", "unmatched"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_kind": { "enum": ["direct_cue", "stt_word_timing", "onset", "section_cue", "unmatched"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/authoredSourceRef" } },
        "raw_start_frame": { "type": "integer", "minimum": 0 },
        "raw_end_frame": { "type": "integer", "minimum": 1 },
        "timeline_in_frame": { "type": "integer", "minimum": 0 },
        "timeline_duration_frames": { "type": "integer", "minimum": 1 },
        "one_frame_gap_applied": { "type": "boolean" },
        "minimum_display_duration_applied": { "type": "boolean" },
        "cps_before": { "type": "number", "minimum": 0 },
        "cps_after": { "type": "number", "minimum": 0 }
      }
    },
    "authoredSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["timing_plan_cue", "stt_word", "onset", "section_cue"] },
        "id": { "type": "string" },
        "text": { "type": "string" },
        "start_us": { "type": "number", "minimum": 0 },
        "end_us": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
