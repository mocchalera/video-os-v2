{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/reframe-candidate.schema.json",
  "title": "Vision Reframe Candidate Evidence",
  "type": "object",
  "required": ["version", "source_identity", "analyzed_range", "framing_policy", "framing_output", "model", "cache", "provider", "adapter", "result", "fallback", "result_hash", "candidate_hash"],
  "properties": {
    "version": { "const": "reframe-candidate/v1" },
    "source_identity": { "$ref": "#/$defs/sourceEvidencePin" },
    "analyzed_range": { "$ref": "#/$defs/sourceRange" },
    "framing_policy": {
      "type": "object",
      "required": ["id", "version", "content_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": "framing-policy/v1" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "framing_output": { "$ref": "#/$defs/framingOutput" },
    "model": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["hit", "miss", "unavailable"] },
        "key": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provider": { "$ref": "#/$defs/providerIdentity" },
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result": { "$ref": "#/$defs/framingResult" },
    "fallback": {
      "type": "object",
      "required": ["manual_available", "used"],
      "properties": {
        "manual_available": { "const": true },
        "used": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "sourceRange": {
      "type": "object",
      "required": ["src_in_us", "src_out_us"],
      "properties": {
        "src_in_us": { "type": "integer", "minimum": 0 },
        "src_out_us": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourceEvidencePin": {
      "type": "object",
      "required": ["asset_id", "segment_id", "source_content_hash", "source_range"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "segment_id": { "type": "string", "minLength": 1 },
        "source_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_range": { "$ref": "#/$defs/sourceRange" },
        "source_fingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "framingTransform": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "zoom": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "crop": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "framingCheck": {
      "type": "object",
      "required": ["status", "evidence_count", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "not_evaluated"] },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "framingOutput": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "providerIdentity": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "framingResult": {
      "type": "object",
      "required": ["version", "policy_id", "policy_version", "status", "requested_mode", "applied_mode", "transform", "confidence", "degraded", "checks"],
      "properties": {
        "version": { "const": "framing-result/v1" },
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "const": "framing-policy/v1" },
        "status": { "type": "string", "enum": ["ready", "degraded", "manual_fallback"] },
        "requested_mode": { "type": "string", "enum": ["wide", "punch", "hold"] },
        "applied_mode": { "type": "string", "enum": ["wide", "punch", "hold", "manual"] },
        "transform": { "$ref": "#/$defs/framingTransform" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "degraded": { "type": "boolean" },
        "degrade_reason": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "object",
          "required": ["person", "head", "transform", "hand", "look_room", "headroom"],
          "properties": {
            "person": { "$ref": "#/$defs/framingCheck" },
            "head": { "$ref": "#/$defs/framingCheck" },
            "transform": { "$ref": "#/$defs/framingCheck" },
            "hand": { "$ref": "#/$defs/framingCheck" },
            "look_room": { "$ref": "#/$defs/framingCheck" },
            "headroom": { "$ref": "#/$defs/framingCheck" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
