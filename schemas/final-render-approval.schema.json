{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-render-approval.schema.json",
  "title": "Final Render Approval",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "approved_by",
    "approved_at",
    "checklist",
    "bindings",
    "approval_key"
  ],
  "properties": {
    "version": { "const": "final-render-approval/v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" },
    "checklist": {
      "type": "object",
      "required": ["captions", "caption_typography", "section_titles", "audio", "output_spec"],
      "properties": {
        "captions": { "enum": ["approved", "not_applicable"] },
        "caption_typography": { "enum": ["approved", "not_applicable"] },
        "section_titles": { "enum": ["approved", "not_applicable"] },
        "visual_preview": {
          "type": "object",
          "required": ["reviewed"],
          "properties": {
            "reviewed": { "type": "boolean" },
            "manifest_path": { "type": "string", "minLength": 1 },
            "manifest_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "audio": {
          "type": "object",
          "required": ["decision", "preview_reviewed", "bgm"],
          "properties": {
            "decision": { "enum": ["preserve", "dialogue-clean", "loudness-only"] },
            "preview_reviewed": { "type": "boolean" },
            "preview_path": { "type": "string", "minLength": 1 },
            "preview_sha256": { "$ref": "#/$defs/sha256" },
            "bgm": { "enum": ["none", "approved"] }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": { "enum": ["dialogue-clean", "loudness-only"] }
                }
              },
              "then": {
                "required": ["preview_path", "preview_sha256"],
                "properties": {
                  "preview_reviewed": { "const": true }
                }
              }
            }
          ]
        },
        "output_spec": { "const": "approved" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "captions": { "const": "approved" } }, "required": ["captions"] },
              { "properties": { "caption_typography": { "const": "approved" } }, "required": ["caption_typography"] },
              { "properties": { "section_titles": { "const": "approved" } }, "required": ["section_titles"] }
            ]
          },
          "then": {
            "required": ["visual_preview"],
            "properties": {
              "visual_preview": {
                "required": ["reviewed", "manifest_path", "manifest_sha256"],
                "properties": {
                  "reviewed": { "const": true }
                }
              }
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "required": [
        "creative_brief_sha256",
        "timeline_sha256",
        "caption_approval_sha256",
        "music_cues_sha256"
      ],
      "properties": {
        "creative_brief_sha256": { "$ref": "#/$defs/sha256" },
        "timeline_sha256": { "$ref": "#/$defs/sha256" },
        "caption_approval_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "music_cues_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "approval_key": { "$ref": "#/$defs/sha256" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
