{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/creative-brief.schema.json",
  "title": "Video OS Creative Brief",
  "type": "object",
  "required": [
    "project",
    "message",
    "audience",
    "emotion_curve",
    "must_have",
    "must_avoid",
    "autonomy",
    "resolved_assumptions"
  ],
  "allOf": [
    {
      "description": "Creator narrative modes and the credibility-first lecture/testimonial route are mutually exclusive.",
      "not": {
        "required": ["narrative_mode", "editorial"],
        "properties": {
          "narrative_mode": {
            "enum": ["personal_challenge", "day_log"]
          },
          "editorial": {
            "required": ["hook_priority"],
            "properties": {
              "hook_priority": { "const": "credibility_first" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "audio_policy": { "const": "music_master" } },
        "required": ["audio_policy"]
      },
      "then": { "required": ["music_master"] }
    },
    {
      "if": { "required": ["music_master"] },
      "then": {
        "required": ["audio_policy"],
        "properties": { "audio_policy": { "const": "music_master" } }
      }
    }
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "required": [
        "title",
        "strategy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "runtime_target_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_mode": {
          "type": "string",
          "enum": ["strict", "guide"],
          "default": "guide"
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "emotion_curve": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "narrative_mode": {
      "type": "string",
      "enum": ["personal_challenge", "day_log"],
      "description": "Optional creator-short narrative arc selector. Omit it to preserve the legacy blueprint path. It must not be combined with editorial.hook_priority=credibility_first."
    },
    "order_policy": {
      "type": "string",
      "enum": ["chronological", "editorial"],
      "description": "Default clip order when the blueprint does not specify timeline_order. Keepsake and family-growth-recap projects should use chronological."
    },
    "subject": {
      "type": "object",
      "properties": {
        "birth_date": {
          "type": "string",
          "format": "date",
          "description": "Subject birth date used to derive age captions for family-growth/keepsake edits."
        }
      },
      "additionalProperties": false
    },
    "caption_policy": {
      "type": "string",
      "enum": ["auto", "manual", "off"],
      "description": "Whether the rough cut should auto-propose date/age/milestone captions, expect manual captions, or keep captions off."
    },
    "audio_policy": {
      "type": "string",
      "enum": ["ducking", "bgm_only", "original_only", "music_master"],
      "description": "Default final audio policy. If omitted, profile/template defaults may apply."
    },
    "music_master": {
      "type": "object",
      "required": ["source_ref", "source_content_hash", "source_size_bytes", "source_duration_us"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_size_bytes": { "type": "integer", "minimum": 1 },
        "source_duration_us": { "type": "integer", "minimum": 1 },
        "source_range_us": {
          "type": "object",
          "required": ["in_us", "out_us"],
          "properties": {
            "in_us": { "type": "integer", "minimum": 0 },
            "out_us": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "timeline_range": {
          "type": "object",
          "required": ["in_frame", "out_frame"],
          "properties": {
            "in_frame": { "type": "integer", "minimum": 0 },
            "out_frame": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "gain_linear": { "const": 1 },
        "audio_decision": { "enum": ["preserve", "mastering"] },
        "channel_layout": { "type": "string", "minLength": 1 },
        "codec": { "type": "string", "minLength": 1 },
        "processing_graph": {
          "type": "object",
          "required": ["version", "operations"],
          "properties": {
            "version": { "const": "audio-processing-graph/v1" },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["stream_copy", "trim_reencode", "shared_final_mastering"] }
            }
          },
          "additionalProperties": false
        },
        "measurement_tolerance": {
          "type": "object",
          "required": ["integrated_lufs_db", "lra_lu", "true_peak_dbtp"],
          "properties": {
            "integrated_lufs_db": { "type": "number", "minimum": 0 },
            "lra_lu": { "type": "number", "minimum": 0 },
            "true_peak_dbtp": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "policy_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "a1_loudnorm": {
      "type": "boolean",
      "description": "When true, normalize the original audio stem before ducking so family voices and ambient sound remain audible. Defaults may come from the selected profile."
    },
    "still_image_intent": {
      "type": "object",
      "properties": {
        "min_hold_sec": { "type": "number", "exclusiveMinimum": 0 },
        "default_hold_sec": { "type": "number", "exclusiveMinimum": 0 },
        "max_hold_sec": { "type": "number", "exclusiveMinimum": 0 },
        "motion_mode": { "type": "string", "enum": ["static", "subtle_ken_burns"] },
        "hold": {
          "type": "object",
          "required": ["unit"],
          "properties": {
            "unit": { "type": "string", "enum": ["frames", "seconds", "beats", "section_boundary"] },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "section_id": { "type": "string", "minLength": 1 },
            "boundary": { "type": "string", "enum": ["start", "end"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "long_hold_reason": { "type": "string", "minLength": 1 },
        "camera_motion": {
          "type": "object",
          "required": ["preset"],
          "properties": {
            "preset": { "type": "string", "enum": ["push_in", "pull_out", "horizontal_tracking", "tilt_down", "diagonal_drift", "pan_zoom"] },
            "easing": { "type": "string", "enum": ["smoothstep", "linear"] },
            "intensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.6 },
            "transform": { "$ref": "#/$defs/stillTransform" },
            "parallax": { "$ref": "#/$defs/stillParallax" }
          },
          "additionalProperties": false
        },
        "ken_burns": { "$ref": "#/$defs/stillCameraMotionIntent" },
        "parallax": { "$ref": "#/$defs/stillParallax" },
        "transform": { "$ref": "#/$defs/stillTransform" },
        "composition": { "type": "string", "enum": ["fit", "vertical_blur_backdrop"] },
        "fit_mode": { "type": "string", "enum": ["contain", "cover", "full_bleed"] },
        "background": { "type": "string", "pattern": "^(?:black|white|transparent|#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?)$" }
      },
      "additionalProperties": false
    },
    "must_have": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_avoid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "may_decide",
        "must_ask"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["full", "collaborative"]
        },
        "may_decide": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_ask": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skip_confirmations": {
          "type": "boolean",
          "description": "When true, pipeline confirmation prompts are completely skipped."
        }
      },
      "additionalProperties": false
    },
    "confirmation_provenance": {
      "type": "object",
      "properties": {
        "confirmed_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["interactive_prompt", "non_interactive_default"] },
        "caption_policy": { "type": "string", "enum": ["auto", "manual", "off"] },
        "audio_policy": { "type": "string", "enum": ["ducking", "bgm_only", "original_only", "music_master"] },
        "questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "resolved_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_interpretations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_hint": {
      "type": "string",
      "description": "Free-text hint describing what the footage contains, used to improve VLM recognition accuracy (e.g. 'child learning to ride a bicycle')"
    },
    "context_knowledge": {
      "type": "object",
      "properties": {
        "location": {
          "type": "object",
          "properties": {
            "primary_location": { "type": "string" },
            "specific_places": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "appearance": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "key_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "significance": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "cultural_context": { "type": "string" },
        "terminology": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string" },
              "meaning": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "editorial": {
      "type": "object",
      "properties": {
        "distribution_channel": {
          "type": "string",
          "enum": ["web_lp", "social_feed", "product_page", "presentation", "event_recap", "unknown"]
        },
        "aspect_ratio": {
          "type": "string",
          "enum": ["16:9", "9:16", "1:1", "4:5", "unknown"]
        },
        "embed_context": {
          "type": "string",
          "enum": ["standalone", "lp_embed", "deck_insert", "kiosk", "unknown"]
        },
        "hook_priority": {
          "type": "string",
          "enum": ["credibility_first", "balanced", "aggressive"]
        },
        "credibility_bias": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "profile_hint": { "type": "string" },
        "policy_hint": { "type": "string" },
        "allow_inference": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "longform": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["reduction"] },
        "source_selection": {
          "type": "string",
          "enum": ["auto_primary_lane", "all", "explicit"]
        },
        "primary_asset_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "min_window_sec": { "type": "number", "minimum": 2, "maximum": 30 },
        "max_window_sec": { "type": "number", "minimum": 10, "maximum": 180 },
        "silence_gap_cut_sec": { "type": "number", "minimum": 0.5, "maximum": 30 },
        "chapter_max_sec": { "type": "number", "minimum": 60, "maximum": 3600 },
        "coverage_interval_sec": { "type": "number", "minimum": 30, "maximum": 900 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stillTransform": {
      "type": "object",
      "properties": {
        "crop": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
        "pan": {
          "type": "object",
          "required": ["x", "y"],
          "properties": { "x": { "type": "number", "minimum": -1, "maximum": 1 }, "y": { "type": "number", "minimum": -1, "maximum": 1 } },
          "additionalProperties": false
        },
        "zoom": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
        "anchor": {
          "type": "object",
          "required": ["x", "y"],
          "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } },
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "stillParallax": {
      "type": "object",
      "required": ["amount", "axis"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 },
        "axis": { "type": "string", "enum": ["horizontal", "vertical", "both"] }
      },
      "additionalProperties": false
    },
    "stillCameraMotionIntent": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "enum": ["push_in", "pull_out", "horizontal_tracking", "tilt_down", "diagonal_drift", "pan_zoom"] },
        "easing": { "type": "string", "enum": ["smoothstep", "linear"] },
        "intensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.6 },
        "transform": { "$ref": "#/$defs/stillTransform" },
        "parallax": { "$ref": "#/$defs/stillParallax" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
