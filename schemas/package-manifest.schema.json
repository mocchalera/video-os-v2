{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/package-manifest.schema.json",
  "title": "Video OS Package Manifest",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "source_of_truth",
    "base_timeline_version",
    "packaging_projection_hash",
    "created_at",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "version": { "type": "string" },
    "project_id": { "type": "string" },
    "source_of_truth": {
      "type": "string",
      "enum": ["engine_render", "nle_finishing"]
    },
    "base_timeline_version": { "type": "string" },
    "packaging_projection_hash": { "type": "string" },
    "created_at": { "type": "string" },
    "artifacts": { "$ref": "#/$defs/artifactSet" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "version": { "const": "1.1.0" } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": ["final_video", "qa_report", "derived_video_provenance"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": "1.2.0" } },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "required": [
              "final_video",
              "qa_report",
              "derived_video_provenance",
              "layout_snapshot"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_of_truth": { "const": "engine_render" } },
        "required": ["source_of_truth"]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "editorial_timeline_hash",
              "source_inputs_hash",
              "source_inputs_attestation_status",
              "render"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_of_truth": { "const": "nle_finishing" },
          "provenance": {
            "properties": { "nle_receipt_required": { "const": true } },
            "required": ["nle_receipt_required"]
          }
        },
        "required": ["source_of_truth", "provenance"]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": ["nle_receipt_required", "route_receipt", "route_evidence"],
            "properties": {
              "route_evidence": {
                "properties": {
                  "route_kind": { "enum": ["supplied_final", "external_manual_nle"] },
                  "ownership": { "enum": ["supplied", "external"] },
                  "canonical_claim": { "const": false }
                },
                "required": ["route_kind", "ownership", "canonical_claim"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "artifactSet": {
      "type": "object",
      "required": ["final_video", "qa_report"],
      "properties": {
        "final_video": { "$ref": "#/$defs/artifactRef" },
        "raw_video": { "$ref": "#/$defs/artifactRef" },
        "raw_dialogue": { "$ref": "#/$defs/artifactRef" },
        "final_mix": { "$ref": "#/$defs/artifactRef" },
        "mastered_mp3": { "$ref": "#/$defs/artifactRef" },
        "audio_mix_report": { "$ref": "#/$defs/artifactRef" },
        "captions": {
          "type": "array",
          "items": { "$ref": "#/$defs/captionArtifactRef" }
        },
        "qa_report": { "$ref": "#/$defs/artifactRef" },
        "derived_video_provenance": { "$ref": "#/$defs/artifactRef" },
        "layout_snapshot": { "$ref": "#/$defs/artifactRef" }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "captionArtifactRef": {
      "type": "object",
      "required": ["kind", "delivery", "path", "sha256"],
      "properties": {
        "kind": { "type": "string" },
        "delivery": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["editorial_timeline_hash"],
      "properties": {
        "editorial_timeline_hash": { "type": "string" },
        "caption_approval_hash": { "type": "string" },
        "music_cues_hash": { "type": "string" },
        "ffmpeg_version": { "type": "string" },
        "remotion_bundle_hash": { "type": "string" },
        "render_defaults_hash": { "type": "string" },
        "handoff_id": { "type": "string" },
        "source_inputs_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_inputs_attestation_status": {
          "type": "string",
          "enum": ["verified", "live_only", "not_applicable"]
        },
        "source_inputs_freshness_reason": { "type": "string" },
        "nle_receipt_required": { "const": true },
        "route_receipt": { "$ref": "#/$defs/artifactRef" },
        "route_evidence": {
          "type": "object",
          "required": ["route_kind", "ownership", "canonical_claim"],
          "properties": {
            "route_kind": { "enum": ["canonical_engine_render", "supplied_final", "external_manual_nle"] },
            "ownership": { "enum": ["canonical", "supplied", "external"] },
            "canonical_claim": { "type": "boolean" }
          },
          "minProperties": 1
        },
        "render": { "$ref": "#/$defs/renderProvenance" }
      },
      "additionalProperties": false
    },
    "renderProvenance": {
      "type": "object",
      "required": [
        "contract_version",
        "route_receipt",
        "renderer_versions",
        "layer_receipts",
        "delivery_execution",
        "inputs",
        "outputs"
      ],
      "properties": {
        "contract_version": { "const": "render-provenance/v1" },
        "route_receipt": { "$ref": "#/$defs/artifactRef" },
        "renderer_versions": {
          "type": "object",
          "required": ["ffmpeg"],
          "properties": {
            "ffmpeg": { "type": "string", "minLength": 1 },
            "hyperframes": { "type": "string", "minLength": 1 },
            "remotion": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "layer_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["renderer", "path", "sha256"],
            "properties": {
              "renderer": { "enum": ["hyperframes", "remotion"] },
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "font_receipt": { "$ref": "#/$defs/artifactRef" },
        "delivery_execution": {
          "type": "object",
          "required": [
            "definition",
            "measurement_source",
            "lossy_video_encode_passes",
            "operations"
          ],
          "properties": {
            "definition": { "const": "sequential_h264_generations/v1" },
            "measurement_source": { "enum": ["runtime_trace", "execution_plan"] },
            "lossy_video_encode_passes": { "type": "integer", "minimum": 1 },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "kind"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": {
                    "enum": [
                      "lossy_video_generation",
                      "stream_copy",
                      "decode",
                      "alpha_intermediate",
                      "lossless_intermediate"
                    ]
                  },
                  "codec": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "inputs": { "$ref": "#/$defs/renderInputs" },
        "outputs": { "$ref": "#/$defs/renderOutputs" },
        "route_evidence": { "type": "object", "minProperties": 1 },
        "caption_visual_treatment": { "$ref": "#/$defs/captionVisualTreatment" },
        "render_report": { "$ref": "#/$defs/artifactRef" }
      },
      "additionalProperties": false
    },
    "renderInputs": {
      "type": "object",
      "required": ["timeline"],
      "properties": {
        "timeline": { "$ref": "#/$defs/artifactRef" },
        "caption_approval": { "$ref": "#/$defs/artifactRef" },
        "typography_policy": { "$ref": "#/$defs/artifactRef" },
        "visual_treatment_patch": { "$ref": "#/$defs/artifactRef" },
        "caption_visual_treatment_input": { "$ref": "#/$defs/artifactRef" },
        "audio_render_plan": { "$ref": "#/$defs/artifactRef" },
        "audio_mix_report": { "$ref": "#/$defs/artifactRef" }
      },
      "additionalProperties": false
    },
    "renderOutputs": {
      "type": "object",
      "required": ["final_video"],
      "properties": {
        "final_video": { "$ref": "#/$defs/artifactRef" }
      },
      "additionalProperties": false
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caption_id", "reason"],
        "properties": { "caption_id": { "type": "string" }, "reason": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "captionVisualTreatment": {
      "type": "object",
      "required": ["status", "approval_hash", "visual_treatment_patch_hash", "typography_policy_hash", "platform_safe_zone_profile_id", "platform_safe_zone_profile_path", "platform_safe_zone_profile_hash", "accessibility", "text_timing_hash", "capability_hash", "resolved_input_hash", "applied_caption_ids", "degraded_reasons", "blocked_reasons"],
      "properties": {
        "status": { "enum": ["ready", "fallback", "human_hold", "blocked"] },
        "approval_hash": { "$ref": "#/$defs/hash" },
        "visual_treatment_patch_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "typography_policy_hash": { "$ref": "#/$defs/hash" },
        "platform_safe_zone_profile_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "platform_safe_zone_profile_path": { "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^[^/].*$" }, { "type": "null" }] },
        "platform_safe_zone_profile_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "accessibility": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["reduced_motion", "high_contrast", "audio_off", "small_screen"],
              "properties": { "reduced_motion": { "type": "boolean" }, "high_contrast": { "type": "boolean" }, "audio_off": { "type": "boolean" }, "small_screen": { "type": "boolean" } },
              "additionalProperties": false
            }
          ]
        },
        "text_timing_hash": { "$ref": "#/$defs/hash" },
        "capability_hash": { "$ref": "#/$defs/hash" },
        "resolved_input_hash": { "$ref": "#/$defs/hash" },
        "applied_caption_ids": { "type": "array", "items": { "type": "string" } },
        "degraded_reasons": { "$ref": "#/$defs/reasons" },
        "blocked_reasons": { "$ref": "#/$defs/reasons" }
      },
      "additionalProperties": false
    }
  }
}
