# Copy this file to .env.local for local development.
# scripts/analyze.ts and scripts/preflight.ts load .env.local first, then .env.

# Required for Gemini VLM analysis.
GEMINI_API_KEY=

# Recommended for the default Groq speech-to-text path.
GROQ_API_KEY=

# Optional alternative STT provider.
OPENAI_API_KEY=

# Optional. Required if you enable pyannote speaker diarization or access
# gated Hugging Face Marlin weights such as NemoStation/Marlin-2B.
HF_TOKEN=

# Optional. Enable only after the local Marlin worker dependencies are installed.
# Marlin is intended for temporal video semantics, not as a blind replacement
# for the existing contact-sheet VLM path.
VOS_MARLIN_ENABLED=0
VOS_MARLIN_MODEL=NemoStation/Marlin-2B
VOS_MARLIN_DEVICE=auto
VOS_MARLIN_MODE=hybrid
VOS_MARLIN_MOCK=0
VOS_MARLIN_PYTHON=python/.venv-marlin/bin/python3
VOS_MARLIN_WORKER=python/marlin_worker.py
