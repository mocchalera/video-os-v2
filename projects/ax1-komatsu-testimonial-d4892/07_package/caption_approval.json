      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 465,
      "timeline_duration_frames": 124,
      "text": "そこに頼らない。\n100％頼ってはいけない",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0094"
