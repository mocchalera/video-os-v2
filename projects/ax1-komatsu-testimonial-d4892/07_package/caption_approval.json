      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 260,
      "timeline_duration_frames": 67,
      "text": "多分、半日も\nもたなかったと思う。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0093"
