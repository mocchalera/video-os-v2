      "timeline_in_frame": 153,
      "timeline_duration_frames": 107,
      "text": "バーッと羅列するだけの\n1日であれば",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0092"
