      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 327,
      "timeline_duration_frames": 138,
      "text": "基本、やっぱり使う側とか\n今までやってきたこととか",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0094"
