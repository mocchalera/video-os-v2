    },
    {
      "caption_id": "SC_0005",
      "asset_id": "AST_610FB4A0",
      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 635,
      "timeline_duration_frames": 173,
      "text": "私も今日、フォルダ整理を\nあっという間にしてもらって",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0125"
      ],
      "source": "transcript",
      "styling_class": "clean-lower-third",
      "metrics": {
        "cps": 3.47,
        "dwell_ms": 7208
