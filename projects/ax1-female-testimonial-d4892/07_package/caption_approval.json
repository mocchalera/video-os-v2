      "timeline_in_frame": 1067,
      "timeline_duration_frames": 48,
      "text": "逆に、指示を出す側も",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0127"
