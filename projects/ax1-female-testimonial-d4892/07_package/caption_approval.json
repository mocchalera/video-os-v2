      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 1007,
      "timeline_duration_frames": 52,
      "text": "実作業者も\n知った方がいいし",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0127"
