      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 192,
      "timeline_duration_frames": 144,
      "text": "本当に、こんなことまで\nできるんだとびっくりしました。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0020",
