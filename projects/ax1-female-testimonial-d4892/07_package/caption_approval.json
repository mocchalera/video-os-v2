      "asset_id": "AST_610FB4A0",
      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 810,
      "timeline_duration_frames": 79,
      "text": "普段はスタッフに\n頼んでいる作業です。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0126"
      ],
      "source": "transcript",
      "styling_class": "clean-lower-third",
