      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 889,
      "timeline_duration_frames": 87,
      "text": "スタッフが知っていれば\n人がやる必要もない。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0126"
