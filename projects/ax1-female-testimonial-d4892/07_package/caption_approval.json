      "timeline_in_frame": 1115,
      "timeline_duration_frames": 95,
      "text": "ツールがある前提で\n仕事を頼んだ方がいい。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
