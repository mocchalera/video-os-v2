    },
    {
      "caption_id": "SC_0004",
      "asset_id": "AST_610FB4A0",
      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 497,
      "timeline_duration_frames": 116,
      "text": "本当に幅広く\nいろんな価値があると思っていて",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0125"
