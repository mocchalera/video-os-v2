      "asset_id": "AST_610FB4A0",
      "segment_id": "SEG_AST_610FB4A0_0001",
      "timeline_in_frame": 336,
      "timeline_duration_frames": 148,
      "text": "これを知識だけで終わらせず\nちゃんと活用していきたい。",
      "transcript_ref": "TR_AST_610FB4A0",
      "transcript_item_ids": [
        "TRI_AST_610FB4A0_0021"
      ],
      "source": "transcript",
      "styling_class": "clean-lower-third",
