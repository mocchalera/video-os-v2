{
  "name": "video-os-v2-spec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "full-pipeline": "tsx scripts/full-pipeline.ts",
    "eval": "tsx scripts/eval.ts",
    "metrics:product": "tsx scripts/product-outcome-metrics.ts",
    "regression:speech-led:real": "tsx scripts/speech-led-real-media-regression.ts",
    "validate": "tsx scripts/validate-schemas.ts projects/demo",
    "validate:all-local": "tsx scripts/validate-schemas.ts",
    "test": "vitest run",
    "test:editor-server-integration": "vitest run tests/editor-server-project-health-redaction.test.ts tests/editor-server-source-map-route-redaction.test.ts",
    "test:schema-contract": "vitest run tests/validate.test.ts tests/analysis-schemas.test.ts tests/editorial-pipeline-status.test.ts",
    "test:speech-led-contract": "vitest run tests/speech-led-product-regression.test.ts tests/speech-led-product-default.test.ts tests/caption-style-config.test.ts",
    "test:event-recap-contract": "vitest run tests/event-recap-profile-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:editor": "npm --prefix editor run typecheck",
    "verify:repo": "tsx scripts/check-repo-hygiene.ts",
    "verify:agents": "python3 scripts/generate_agents.py && git diff --exit-code -- .claude/agents .codex/agents && test -z \"$(git ls-files --others --exclude-standard -- .claude/agents .codex/agents)\"",
    "verify": "tsx scripts/verify.ts",
    "build": "tsc",
    "package": "tsx scripts/package.ts",
    "preview": "tsx scripts/preview-segment.ts",
    "promo-finish": "tsx scripts/render-promo-cut.ts",
    "setup:embedding-model": "tsx scripts/setup-embedding-model.ts",
    "export:premiere": "tsx scripts/export-premiere-xml.ts",
    "regen:premiere": "tsx scripts/regen-premiere-xml.ts",
    "marlin:evaluate": "tsx scripts/marlin-evaluate.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.452",
    "@remotion/renderer": "4.0.452",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.452",
    "typescript": "^5.7.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
